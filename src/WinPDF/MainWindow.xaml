<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinPDF.MainWindow"
    Title="WinPDF"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:controls="using:WinPDF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinPDF.Models"
    xmlns:views="using:WinPDF.Views"
    xmlns:vm="using:WinPDF.ViewModels"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <!-- MicaKind.Base: subtle, neutral variant recommended for native WinUI 3 -->
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        MinWidth="500"
        MinHeight="360"
        Background="Transparent"
        RowDefinitions="Auto,*"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        PreviewKeyDown="OnRootGridPreviewKeyDown">

        <!-- ================================================================= -->
        <!-- Unified 48 DIPs top bar (Integrated TitleBar + CommandBar)        -->
        <!-- ================================================================= -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="12,0,140,0"
            Background="Transparent"
            Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.IsPresentationMode), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Document Mode -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.IsSettingsOpen), Mode=OneWay}">

                <!-- Group 1: Sidebar Toggle and App Logo/Name -->
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <Grid
                        x:Name="SidebarToggleClipContainer"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                        <Grid.Clip>
                            <RectangleGeometry x:Name="SidebarToggleClip" Rect="0,0,48,36" />
                        </Grid.Clip>
                        <Button
                            x:Name="SidebarToggleButton"
                            x:Uid="SidebarToggle"
                            Width="36"
                            Height="32"
                            Margin="0,0,8,0"
                            Padding="0"
                            Click="OnSidebarToggleClick"
                            Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                            CornerRadius="4"
                            IsTabStop="False"
                            Style="{StaticResource SubtleButtonStyle}">
                            <Button.RenderTransform>
                                <CompositeTransform x:Name="SidebarToggleTransform" />
                            </Button.RenderTransform>
                            <AnimatedIcon
                                x:Name="SidebarToggleAnimatedIcon"
                                Width="16"
                                Height="16"
                                AnimatedIcon.State="Normal">
                                <AnimatedIcon.Source>
                                    <animatedvisuals:AnimatedGlobalNavigationButtonVisualSource />
                                </AnimatedIcon.Source>
                                <AnimatedIcon.FallbackIconSource>
                                    <FontIconSource FontSize="16" Glyph="&#xE700;" />
                                </AnimatedIcon.FallbackIconSource>
                            </AnimatedIcon>
                        </Button>
                    </Grid>

                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="0">
                        <Image
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Source="ms-appx:///Assets/appicon.png" />
                        <Grid
                            x:Name="AppTitleTextClipContainer"
                            VerticalAlignment="Center">
                            <Grid.Clip>
                                <RectangleGeometry x:Name="AppTitleTextClip" Rect="0,0,200,32" />
                            </Grid.Clip>
                            <TextBlock
                                x:Name="AppTitleTextBlock"
                                x:Uid="AppTitleBarText"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Style="{StaticResource CaptionTextBlockStyle}">
                                <TextBlock.RenderTransform>
                                    <CompositeTransform x:Name="AppTitleTextTransform" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Group 2: 20 DIPs spacing for "Open file" button and Search (8 DIPs) -->
                <StackPanel
                    x:Name="OpenFileGroupPanel"
                    Margin="20,0,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!-- Only bordered button in the top bar ("Open file") -->
                    <Button
                        x:Name="OpenFileBtn"
                        x:Uid="OpenFileButton"
                        Height="32"
                        Padding="10,0"
                        Command="{x:Bind ViewModel.OpenFileCommand}"
                        CornerRadius="4"
                        IsTabStop="False"
                        Style="{StaticResource DefaultButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                            <FontIcon FontSize="16" Glyph="&#xE8E5;" VerticalAlignment="Center" />
                            <Grid
                                x:Name="OpenFileTextClipContainer"
                                VerticalAlignment="Center">
                                <Grid.Clip>
                                    <RectangleGeometry x:Name="OpenFileTextClip" Rect="0,0,240,32" />
                                </Grid.Clip>
                                <TextBlock
                                    x:Name="OpenFileButtonTextBlock"
                                    x:Uid="OpenFileButtonText"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                    <TextBlock.RenderTransform>
                                        <CompositeTransform x:Name="OpenFileTextTransform" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="SearchBtn"
                        x:Uid="SearchButton"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Command="{x:Bind ViewModel.ToggleSearchCommand}"
                        CornerRadius="4"
                        IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                        IsTabStop="False"
                        Style="{StaticResource SubtleButtonStyle}">
                        <AnimatedIcon
                            x:Name="SearchAnimatedIcon"
                            Width="16"
                            Height="16"
                            AnimatedIcon.State="Normal">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedFindVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <FontIconSource FontSize="16" Glyph="&#xE721;" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Left: Settings Mode (Single Back Button) -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsSettingsOpen), Mode=OneWay}">
                <Button
                    x:Name="SettingsBackBtn"
                    x:Uid="SettingsBackButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.CloseSettingsCommand}"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}">
                    <AnimatedIcon
                        x:Name="SettingsBackAnimatedIcon"
                        Width="16"
                        Height="16"
                        AnimatedIcon.State="Normal">
                        <AnimatedIcon.Source>
                            <animatedvisuals:AnimatedBackVisualSource />
                        </AnimatedIcon.Source>
                        <AnimatedIcon.FallbackIconSource>
                            <FontIconSource FontSize="16" Glyph="&#xE72B;" />
                        </AnimatedIcon.FallbackIconSource>
                    </AnimatedIcon>
                </Button>

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="0">
                    <Image
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Source="ms-appx:///Assets/appicon.png" />
                    <Grid
                        x:Name="SettingsTitleTextClipContainer"
                        VerticalAlignment="Center">
                        <Grid.Clip>
                            <RectangleGeometry x:Name="SettingsTitleTextClip" Rect="0,0,200,32" />
                        </Grid.Clip>
                        <TextBlock
                            x:Name="SettingsTitleTextBlock"
                            x:Uid="AppTitleBarText"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Style="{StaticResource CaptionTextBlockStyle}">
                            <TextBlock.RenderTransform>
                                <CompositeTransform x:Name="SettingsTitleTextTransform" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Center: Window Drag Region + Document Name -->
            <Grid
                x:Name="TitleBarDragRegion"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">
                <!-- Centered open file name -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="400"
                    FontWeight="SemiBold"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.CurrentDocument.FileName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.HasDocument), Mode=OneWay}" />
            </Grid>

            <!-- Right: Annotation Toolbar Toggle, Document Menu (...), Settings, Exit Full Screen -->
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">

                <!-- Document Mode Tools Group -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.IsSettingsOpen), Mode=OneWay}">

                <!-- Floating annotation toolbar toggle -->
                <Button
                    x:Name="AnnotationToolsToggleBtn"
                    x:Uid="AnnotationToolsToggle"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.ToggleAnnotationToolbarCommand}"
                    CornerRadius="4"
                    IsTabStop="False"
                    Style="{StaticResource SubtleButtonStyle}"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.HasDocument), Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xED63;" />
                </Button>

                <!-- Document Options Menu (GNOME Papers) -->
                <Button
                    x:Name="DocumentMenuBtn"
                    x:Uid="DocumentMenuButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    CornerRadius="4"
                    IsTabStop="False"
                    Style="{StaticResource SubtleButtonStyle}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Ellipse
                            x:Name="EllipsisDot1"
                            Width="2.5"
                            Height="2.5"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="EllipsisDot1Transform" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse
                            x:Name="EllipsisDot2"
                            Width="2.5"
                            Height="2.5"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="EllipsisDot2Transform" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse
                            x:Name="EllipsisDot3"
                            Width="2.5"
                            Height="2.5"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="EllipsisDot3Transform" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem
                                x:Uid="Menu_SaveAs"
                                Command="{x:Bind ViewModel.SaveAsCommand}"
                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                                KeyboardAcceleratorTextOverride="Ctrl+S">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem
                                x:Uid="Menu_OpenCopy"
                                Command="{x:Bind ViewModel.OpenCopyCommand}"
                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+N">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem
                                x:Uid="Menu_OpenWith"
                                Command="{x:Bind ViewModel.OpenWithCommand}"
                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+O">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7AC;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem
                                x:Uid="Menu_Print"
                                Command="{x:Bind ViewModel.PrintCommand}"
                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                                KeyboardAcceleratorTextOverride="Ctrl+P">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE749;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem
                                x:Uid="Menu_Rotate"
                                Command="{x:Bind ViewModel.RotateClockwiseCommand}"
                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                                KeyboardAcceleratorTextOverride="Ctrl+R">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7AD;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <ToggleMenuFlyoutItem
                                x:Uid="Menu_NightMode"
                                Command="{x:Bind ViewModel.ToggleNightModeCommand}"
                                IsChecked="{x:Bind ViewModel.IsNightMode, Mode=OneWay}"
                                KeyboardAcceleratorTextOverride="Ctrl+I"
                                Loaded="OnToggleMenuFlyoutItemLoaded">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE708;" />
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>

                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem
                                x:Uid="Menu_FullScreen"
                                Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                                KeyboardAcceleratorTextOverride="F11">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE740;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem
                                x:Uid="Menu_CloseDocument"
                                Command="{x:Bind ViewModel.CloseDocumentCommand}"
                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                                KeyboardAcceleratorTextOverride="Ctrl+W">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE711;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- General Settings Button (Gear) -->
                <Button
                    x:Name="SettingsBtn"
                    x:Uid="SettingsButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    CornerRadius="4"
                    IsTabStop="False"
                    Style="{StaticResource SubtleButtonStyle}">
                    <AnimatedIcon
                        x:Name="SettingsAnimatedIcon"
                        Width="16"
                        Height="16"
                        AnimatedIcon.State="Normal">
                        <AnimatedIcon.Source>
                            <animatedvisuals:AnimatedSettingsVisualSource />
                        </AnimatedIcon.Source>
                        <AnimatedIcon.FallbackIconSource>
                            <FontIconSource FontSize="16" Glyph="&#xE713;" />
                        </AnimatedIcon.FallbackIconSource>
                    </AnimatedIcon>
                </Button>
                </StackPanel>

                <!-- Exit Full Screen Button (F11 / Two Arrows) -->
                <Button
                    x:Name="ExitFullScreenBtn"
                    x:Uid="ExitFullScreenButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsFullScreen), Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE73F;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================================================================= -->
        <!-- ================================================================= -->
        <!-- Main Layout: SplitView with native GPU animation on the Pane      -->
        <!-- + Draggable 8 DIPs splitter across the full vertical height       -->
        <!-- ================================================================= -->
        <Grid
            x:Name="MainSplitView"
            Grid.Row="1"
            RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="MainSplitViewTransform" />
            </Grid.RenderTransform>
            <Border
                x:Name="SidebarPaneContainer"
                Width="260"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="Transparent"
                Canvas.ZIndex="20"
                RenderTransformOrigin="0.5,0.5"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="SidebarPaneTransform" />
                </Border.RenderTransform>
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <!-- Sidebar Content (Tabs + Footer) -->
                        <ColumnDefinition Width="*" />
                        <!-- Resize splitter attached to the right edge of the Pane -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Content (Content Frame + Footer) -->
                    <Grid
                        x:Name="SidebarContentGrid"
                        Grid.Column="0"
                        Background="Transparent"
                        RowDefinitions="*,Auto">
                        <!-- Sidebar Tabs Content Frame (Directional Navigation) -->
                        <Frame
                            x:Name="SidebarContentFrame"
                            Grid.Row="0"
                            Background="Transparent"
                            IsNavigationStackEnabled="False" />

                        <!-- Sidebar Tab Buttons Footer (20px icons with large touch target) -->
                        <Border
                            Grid.Row="1"
                            Padding="0,4,0,4"
                            Background="Transparent"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <StackPanel
                                x:Name="SidebarFooterButtonsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="4">
                                <!-- Tab 1: Page Thumbnails -->
                                <Button
                                    x:Name="ThumbnailsTabBtn"
                                    x:Uid="Sidebar_Thumbnails"
                                    Width="40"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="4"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OnSidebarTabButtonClick"
                                    Tag="Thumbnails">
                                    <Grid Width="40" Height="36" Background="Transparent">
                                        <FontIcon
                                            FontSize="16"
                                            Glyph="&#xF0E2;"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Rectangle
                                            Width="18"
                                            Height="3"
                                            RadiusX="1.5"
                                            RadiusY="1.5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0"
                                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind converters:UiHelpers.ThumbnailsVisibility(ViewModel.SidebarTab), Mode=OneWay}" />
                                    </Grid>
                                </Button>

                                <!-- Tab 2: Table of Contents / Outline -->
                                <Button
                                    x:Name="OutlineTabBtn"
                                    x:Uid="Sidebar_Outline"
                                    Width="40"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="4"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OnSidebarTabButtonClick"
                                    Tag="Outline">
                                    <Grid Width="40" Height="36" Background="Transparent">
                                        <FontIcon
                                            FontSize="16"
                                            Glyph="&#xE8FD;"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Rectangle
                                            Width="18"
                                            Height="3"
                                            RadiusX="1.5"
                                            RadiusY="1.5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0"
                                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind converters:UiHelpers.OutlineVisibility(ViewModel.SidebarTab), Mode=OneWay}" />
                                    </Grid>
                                </Button>

                                <!-- Tab 3: Annotations -->
                                <Button
                                    x:Name="AnnotationsTabBtn"
                                    x:Uid="Sidebar_Annotations"
                                    Width="40"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="4"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OnSidebarTabButtonClick"
                                    Tag="Annotations">
                                    <Grid Width="40" Height="36" Background="Transparent">
                                        <FontIcon
                                            FontSize="16"
                                            Glyph="&#xE90A;"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Rectangle
                                            Width="18"
                                            Height="3"
                                            RadiusX="1.5"
                                            RadiusY="1.5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0"
                                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind converters:UiHelpers.AnnotationsVisibility(ViewModel.SidebarTab), Mode=OneWay}" />
                                    </Grid>
                                </Button>

                                <!-- Tab 4: Bookmarks -->
                                <Button
                                    x:Name="BookmarksTabBtn"
                                    x:Uid="Sidebar_Bookmarks"
                                    Width="40"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="4"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OnSidebarTabButtonClick"
                                    Tag="Bookmarks">
                                    <Grid Width="40" Height="36" Background="Transparent">
                                        <FontIcon
                                            FontSize="16"
                                            Glyph="&#xE728;"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Rectangle
                                            Width="18"
                                            Height="3"
                                            RadiusX="1.5"
                                            RadiusY="1.5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0"
                                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind converters:UiHelpers.BookmarksVisibility(ViewModel.SidebarTab), Mode=OneWay}" />
                                    </Grid>
                                </Button>

                                <!-- Tab 5: Attachments -->
                                <Button
                                    x:Name="AttachmentsTabBtn"
                                    x:Uid="Sidebar_Attachments"
                                    Width="40"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="4"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OnSidebarTabButtonClick"
                                    Tag="Attachments">
                                    <Grid Width="40" Height="36" Background="Transparent">
                                        <FontIcon
                                            FontSize="16"
                                            Glyph="&#xE723;"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <Rectangle
                                            Width="18"
                                            Height="3"
                                            RadiusX="1.5"
                                            RadiusY="1.5"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Margin="0"
                                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind converters:UiHelpers.AttachmentsVisibility(ViewModel.SidebarTab), Mode=OneWay}" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Draggable Splitter (6 DIPs) across FULL vertical height with invisible splitter -->
                    <controls:SplitterContainer
                        Grid.Column="1"
                        Width="6"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="Transparent">
                        <Thumb
                            x:Name="SidebarSplitter"
                            Width="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            DragDelta="OnSidebarSplitterDragDelta">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Grid
                                        Width="6"
                                        Background="Transparent"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </controls:SplitterContainer>
                </Grid>
            </Border>

            <!-- Main Rounded Container (Clipped at sidebar boundary so document never goes under Mica sidebar) -->
            <Grid
                x:Name="MainContentContainer"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                SizeChanged="OnMainContentContainerSizeChanged">
                <Grid.Clip>
                    <RectangleGeometry x:Name="MainContentClipGeometry" Rect="0,0,4000,4000">
                        <RectangleGeometry.Transform>
                            <CompositeTransform x:Name="MainContentClipTransform" />
                        </RectangleGeometry.Transform>
                    </RectangleGeometry>
                </Grid.Clip>
                <Border
                    x:Name="MainContentBackdropBorder"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.HasDocument), Mode=OneWay}">
                    <Border.RenderTransform>
                        <CompositeTransform x:Name="MainContentBackdropTransform" />
                    </Border.RenderTransform>
                </Border>

                <!-- Main Content Frame (DocumentView always preserved in visual tree) -->
                <Frame
                    x:Name="MainContentFrame"
                    Background="Transparent"
                    IsNavigationStackEnabled="False" />
            </Grid>
        </Grid>

        <!-- Full-page Settings Frame (Overlayed without unloading DocumentView or Sidebar) -->
        <Frame
            x:Name="SettingsContentFrame"
            Grid.Row="1"
            Background="Transparent"
            IsNavigationStackEnabled="False"
            RenderTransformOrigin="0.5,0.5"
            Visibility="Collapsed">
            <Frame.RenderTransform>
                <CompositeTransform x:Name="SettingsFrameTransform" />
            </Frame.RenderTransform>
        </Frame>
    </Grid>
</Window>
