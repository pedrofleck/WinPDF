<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinPDF.MainWindow"
    Title="WinPDF"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:controls="using:WinPDF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinPDF.Models"
    xmlns:views="using:WinPDF.Views"
    xmlns:vm="using:WinPDF.ViewModels"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <!-- MicaKind.Base: variante sutil e neutra recomendada para WinUI 3 nativo -->
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        RowDefinitions="Auto,*"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        PreviewKeyDown="OnRootGridPreviewKeyDown">

        <!-- ================================================================= -->
        <!-- Barra Superior ÚNICA de 48 DIPs (TitleBar + CommandBar Integrada) -->
        <!-- ================================================================= -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="12,0,140,0"
            Background="Transparent"
            Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.IsPresentationMode), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Esquerda: Modo Documento -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.IsSettingsOpen), Mode=OneWay}">

                <!-- Grupo 1: Toggle da Barra Lateral e Logo/Nome do App -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        x:Name="SidebarToggleButton"
                        x:Uid="SidebarToggle"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Click="OnSidebarToggleClick"
                        Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                        CornerRadius="4"
                        IsTabStop="False"
                        PointerEntered="OnSidebarTogglePointerEntered"
                        PointerExited="OnSidebarTogglePointerExited"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.HasDocument), Mode=OneWay}">
                        <AnimatedIcon
                            x:Name="SidebarToggleAnimatedIcon"
                            Width="16"
                            Height="16">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedGlobalNavigationButtonVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <FontIconSource FontSize="16" Glyph="&#xE700;" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Button>

                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Image
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Source="ms-appx:///Assets/appicon.png" />
                        <TextBlock
                            x:Uid="AppTitleBarText"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- Grupo 2: Espaçamento de 20 DIPs para o botão "Abrir arquivo" e Pesquisa (8 DIPs) -->
                <StackPanel
                    Margin="20,0,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!-- Único botão com borda da barra superior ("Abrir arquivo") -->
                    <Button
                        x:Name="OpenFileBtn"
                        x:Uid="OpenFileButton"
                        Height="32"
                        Padding="12,0"
                        Command="{x:Bind ViewModel.OpenFileCommand}"
                        CornerRadius="4"
                        IsTabStop="False"
                        Style="{StaticResource DefaultButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                            <TextBlock x:Uid="OpenFileButtonText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="SearchBtn"
                        x:Uid="SearchButton"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Command="{x:Bind ViewModel.ToggleSearchCommand}"
                        CornerRadius="4"
                        IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                        IsTabStop="False"
                        PointerEntered="OnSearchButtonPointerEntered"
                        PointerExited="OnSearchButtonPointerExited"
                        Style="{StaticResource SubtleButtonStyle}">
                        <AnimatedIcon
                            x:Name="SearchAnimatedIcon"
                            Width="16"
                            Height="16">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedFindVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Find" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Esquerda: Modo Configurações (Único Botão Voltar) -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsSettingsOpen), Mode=OneWay}">
                <Button
                    x:Name="SettingsBackBtn"
                    x:Uid="SettingsBackButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.CloseSettingsCommand}"
                    CornerRadius="4"
                    PointerEntered="OnSettingsBackPointerEntered"
                    PointerExited="OnSettingsBackPointerExited"
                    Style="{StaticResource SubtleButtonStyle}">
                    <AnimatedIcon
                        x:Name="SettingsBackAnimatedIcon"
                        Width="16"
                        Height="16">
                        <AnimatedIcon.Source>
                            <animatedvisuals:AnimatedBackVisualSource />
                        </AnimatedIcon.Source>
                        <AnimatedIcon.FallbackIconSource>
                            <SymbolIconSource Symbol="Back" />
                        </AnimatedIcon.FallbackIconSource>
                    </AnimatedIcon>
                </Button>

                <TextBlock
                    x:Uid="SettingsTitleText"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!-- Centro: Área de Arraste da Janela + Nome do Documento -->
            <Grid
                x:Name="TitleBarDragRegion"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">
                <!-- Nome do arquivo aberto centralizado -->
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="400"
                    FontWeight="SemiBold"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.CurrentDocument.FileName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.HasDocument), Mode=OneWay}" />
            </Grid>

            <!-- Direita: Toggle Barra Anotações, Menu Documento (...), Configurações, Sair da Tela Cheia -->
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">

                <!-- Grupo de Ferramentas do Modo Documento -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.IsSettingsOpen), Mode=OneWay}">

                <!-- Toggle da barra flutuante de anotações -->
                <Button
                    x:Name="AnnotationToolsToggleBtn"
                    x:Uid="AnnotationToolsToggle"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.ToggleAnnotationToolbarCommand}"
                    CornerRadius="4"
                    IsTabStop="False"
                    Style="{StaticResource SubtleButtonStyle}"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.HasDocument), Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xED63;" />
                </Button>

                <!-- Menu de Opções do Documento (GNOME Papers) -->
                <Button
                    x:Name="DocumentMenuBtn"
                    x:Uid="DocumentMenuButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    CornerRadius="4"
                    IsTabStop="False"
                    PointerEntered="OnDocumentMenuPointerEntered"
                    PointerExited="OnDocumentMenuPointerExited"
                    Style="{StaticResource SubtleButtonStyle}">
                    <Grid
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Ellipse
                            Width="3"
                            Height="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                            RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <CompositeTransform x:Name="EllipsisDot1Transform" TranslateX="-5" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse
                            Width="3"
                            Height="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                            RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <CompositeTransform x:Name="EllipsisDot2Transform" TranslateX="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse
                            Width="3"
                            Height="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                            RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <CompositeTransform x:Name="EllipsisDot3Transform" TranslateX="5" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem
                                x:Uid="Menu_SaveAs"
                                Command="{x:Bind ViewModel.SaveAsCommand}"
                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                                KeyboardAcceleratorTextOverride="Ctrl+S">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem
                                x:Uid="Menu_OpenCopy"
                                Command="{x:Bind ViewModel.OpenCopyCommand}"
                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+N">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem
                                x:Uid="Menu_OpenWith"
                                Command="{x:Bind ViewModel.OpenWithCommand}"
                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+O">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7AC;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem
                                x:Uid="Menu_Print"
                                Click="OnPrintClick"
                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                                KeyboardAcceleratorTextOverride="Ctrl+P">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE749;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem
                                x:Uid="Menu_Rotate"
                                Command="{x:Bind ViewModel.RotateClockwiseCommand}"
                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                                KeyboardAcceleratorTextOverride="Ctrl+R">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7AD;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <ToggleMenuFlyoutItem
                                x:Uid="Menu_NightMode"
                                Command="{x:Bind ViewModel.ToggleNightModeCommand}"
                                IsChecked="{x:Bind ViewModel.IsNightMode, Mode=OneWay}"
                                KeyboardAcceleratorTextOverride="Ctrl+I">
                                <ToggleMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE708;" />
                                </ToggleMenuFlyoutItem.Icon>
                            </ToggleMenuFlyoutItem>

                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem
                                x:Uid="Menu_FullScreen"
                                Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                                KeyboardAcceleratorTextOverride="F11">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE740;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem
                                x:Uid="Menu_CloseDocument"
                                Command="{x:Bind ViewModel.CloseDocumentCommand}"
                                IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                                KeyboardAcceleratorTextOverride="Ctrl+W">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE711;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Botão de Configurações Gerais (Engrenagem) -->
                <Button
                    x:Name="SettingsBtn"
                    x:Uid="SettingsButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    CornerRadius="4"
                    IsTabStop="False"
                    PointerEntered="OnSettingsButtonPointerEntered"
                    PointerExited="OnSettingsButtonPointerExited"
                    Style="{StaticResource SubtleButtonStyle}">
                    <AnimatedIcon
                        x:Name="SettingsAnimatedIcon"
                        Width="16"
                        Height="16">
                        <AnimatedIcon.Source>
                            <animatedvisuals:AnimatedSettingsVisualSource />
                        </AnimatedIcon.Source>
                        <AnimatedIcon.FallbackIconSource>
                            <SymbolIconSource Symbol="Setting" />
                        </AnimatedIcon.FallbackIconSource>
                    </AnimatedIcon>
                </Button>
                </StackPanel>

                <!-- Botão Sair da Tela Cheia (F11 / Duas Flechas) -->
                <Button
                    x:Name="ExitFullScreenBtn"
                    x:Uid="ExitFullScreenButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsFullScreen), Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xE73F;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================================================================= -->
        <!-- ================================================================= -->
        <!-- Layout Principal: SplitView com Animação Nativa de GPU no Pane    -->
        <!-- + Splitter Arrastável de 8 DIPs em toda a altura vertical         -->
        <!-- ================================================================= -->
        <SplitView
            x:Name="MainSplitView"
            Grid.Row="1"
            DisplayMode="Inline"
            IsPaneOpen="{x:Bind converters:UiHelpers.IsSidebarOpenInDocumentView(ViewModel.HasDocument, ViewModel.IsSidebarOpen, ViewModel.IsSettingsOpen), Mode=OneWay}"
            OpenPaneLength="260"
            PaneBackground="Transparent"
            PanePlacement="Left">
            <SplitView.Pane>
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <!-- Conteúdo da Barra Lateral (Abas + Rodapé) -->
                        <ColumnDefinition Width="*" />
                        <!-- Splitter de Redimensionamento acoplado na borda direita do Pane -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Conteúdo da Barra Lateral (Frame de Conteúdo + Rodapé) -->
                    <Grid Grid.Column="0" Background="Transparent" RowDefinitions="*,Auto">
                        <!-- Frame de Conteúdo das Abas da Barra Lateral (Navegação Direcional) -->
                        <Frame
                            x:Name="SidebarContentFrame"
                            Grid.Row="0"
                            Background="Transparent"
                            IsNavigationStackEnabled="False" />

                        <!-- Rodapé com SelectorBar Nativo sem Bordas (Ícones Maiores de 20px) -->
                        <Border
                            Grid.Row="1"
                            Padding="4,6,4,6"
                            Background="Transparent"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <SelectorBar
                                x:Name="SidebarFooterSelectorBar"
                                HorizontalAlignment="Center"
                                SelectionChanged="OnSidebarFooterSelectionChanged">
                                <SelectorBarItem
                                    x:Name="ThumbnailsSelectorItem"
                                    x:Uid="Sidebar_Thumbnails"
                                    Margin="2,0"
                                    Padding="6,6">
                                    <SelectorBarItem.Icon>
                                        <FontIcon FontSize="20" Glyph="&#xF0E2;" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                                <SelectorBarItem
                                    x:Name="OutlineSelectorItem"
                                    x:Uid="Sidebar_Outline"
                                    Margin="2,0"
                                    Padding="6,6">
                                    <SelectorBarItem.Icon>
                                        <FontIcon FontSize="20" Glyph="&#xE8FD;" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                                <SelectorBarItem
                                    x:Name="AnnotationsSelectorItem"
                                    x:Uid="Sidebar_Annotations"
                                    Margin="2,0"
                                    Padding="6,6">
                                    <SelectorBarItem.Icon>
                                        <FontIcon FontSize="20" Glyph="&#xE8F2;" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                                <SelectorBarItem
                                    x:Name="BookmarksSelectorItem"
                                    x:Uid="Sidebar_Bookmarks"
                                    Margin="2,0"
                                    Padding="6,6">
                                    <SelectorBarItem.Icon>
                                        <FontIcon FontSize="20" Glyph="&#xE8A4;" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                                <SelectorBarItem
                                    x:Name="AttachmentsSelectorItem"
                                    x:Uid="Sidebar_Attachments"
                                    Margin="2,0"
                                    Padding="6,6">
                                    <SelectorBarItem.Icon>
                                        <FontIcon FontSize="20" Glyph="&#xE723;" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                            </SelectorBar>
                        </Border>
                    </Grid>

                    <!-- Splitter Arrastável (6 DIPs) em TODA a Altura Vertical com Splitter Invisível -->
                    <controls:SplitterContainer
                        Grid.Column="1"
                        Width="6"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="Transparent">
                        <Thumb
                            x:Name="SidebarSplitter"
                            Width="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            DragDelta="OnSidebarSplitterDragDelta">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Grid
                                        Width="6"
                                        Background="Transparent"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </controls:SplitterContainer>
                </Grid>
            </SplitView.Pane>

            <!-- Container Arredondado Principal -->
            <Border
                x:Name="MainContentContainer"
                Background="{x:Bind converters:UiHelpers.MainContainerBackgroundWithSettings(ViewModel.HasDocument, ViewModel.IsSettingsOpen), Mode=OneWay}"
                BorderBrush="{x:Bind converters:UiHelpers.MainContainerBorderBrushWithSettings(ViewModel.HasDocument, ViewModel.IsSettingsOpen), Mode=OneWay}"
                BorderThickness="{x:Bind converters:UiHelpers.MainContainerBorderThickness(ViewModel.HasDocument, ViewModel.IsSidebarOpen), Mode=OneWay}"
                CornerRadius="{x:Bind converters:UiHelpers.MainContainerCornerRadius(ViewModel.HasDocument, ViewModel.IsSidebarOpen), Mode=OneWay}">
                <Grid>
                    <!-- Frame de Conteúdo Principal (DocumentView permanece vivo na árvore visual o tempo todo) -->
                    <Frame
                        x:Name="MainContentFrame"
                        Background="Transparent"
                        IsNavigationStackEnabled="False"
                        Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.IsSettingsOpen), Mode=OneWay}" />

                    <!-- Frame Dedicado de Configurações (evita descarregar o DocumentView e os CanvasControls do Win2D) -->
                    <Frame
                        x:Name="SettingsContentFrame"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        IsNavigationStackEnabled="False"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsSettingsOpen), Mode=OneWay}">
                        <Frame.RenderTransform>
                            <TranslateTransform x:Name="SettingsFrameTranslate" />
                        </Frame.RenderTransform>
                    </Frame>
                </Grid>
            </Border>
        </SplitView>
    </Grid>
</Window>
