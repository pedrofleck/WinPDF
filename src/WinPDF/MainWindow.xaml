<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinPDF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:controls="using:WinPDF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinPDF.Models"
    xmlns:views="using:WinPDF.Views"
    xmlns:vm="using:WinPDF.ViewModels"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <!-- MicaKind.Base: variante sutil e neutra recomendada para WinUI 3 nativo -->
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" RowDefinitions="Auto,*">

        <!-- ================================================================= -->
        <!-- Barra Superior ÚNICA de 48 DIPs (TitleBar + CommandBar Integrada) -->
        <!-- ================================================================= -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="12,0,140,0"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Esquerda: Modo Documento -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.IsSettingsOpen), Mode=OneWay}">

                <!-- Grupo 1: Toggle da Barra Lateral e Logo/Nome do App -->
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="SidebarToggleButton"
                        x:Uid="SidebarToggle"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Click="OnSidebarToggleClick"
                        Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xE700;" />
                    </Button>

                    <StackPanel
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE8A5;" />
                        <TextBlock
                            x:Uid="AppTitleBarText"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- Grupo 2: Espaçamento de 20 DIPs para o botão "Abrir arquivo" e Pesquisa (8 DIPs) -->
                <StackPanel
                    Margin="20,0,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!-- Único botão com borda da barra superior ("Abrir arquivo") -->
                    <Button
                        x:Name="OpenFileBtn"
                        x:Uid="OpenFileButton"
                        Height="32"
                        Padding="12,0"
                        Command="{x:Bind ViewModel.OpenFileCommand}"
                        CornerRadius="4"
                        Style="{StaticResource DefaultButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                            <TextBlock x:Uid="OpenFileButtonText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button
                        x:Name="SearchBtn"
                        x:Uid="SearchButton"
                        Width="36"
                        Height="32"
                        Padding="0"
                        CornerRadius="4"
                        IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="16" Glyph="&#xE721;" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Esquerda: Modo Configurações (Único Botão Voltar) -->
            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsSettingsOpen), Mode=OneWay}">
                <Button
                    x:Name="SettingsBackBtn"
                    x:Uid="SettingsBackButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.CloseSettingsCommand}"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>

                <TextBlock
                    x:Uid="SettingsTitleText"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!-- Centro: Área de Arraste da Janela + Nome do Documento e Paginação -->
            <Grid
                x:Name="TitleBarDragRegion"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.HasDocument), Mode=OneWay}">
                    <!-- Nome do arquivo aberto centralizado -->
                    <TextBlock
                        MaxWidth="280"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.CurrentDocument.FileName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <!-- Indicador compacto estilo GNOME Papers: [ TextBox ] de N -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBox
                            x:Name="PageNumberBoxControl"
                            x:Uid="PageNumberBox"
                            Width="44"
                            Height="28"
                            Padding="2"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            InputScope="Number"
                            Text="{x:Bind ViewModel.CurrentDocument.CurrentPageNumber, Mode=TwoWay}" />

                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.FormattedPageCount, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Direita: Toggle Barra Anotações, Menu Documento (...), Configurações -->
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4"
                Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.IsSettingsOpen), Mode=OneWay}">

                <!-- Toggle da barra flutuante de anotações -->
                <Button
                    x:Name="AnnotationToolsToggleBtn"
                    x:Uid="AnnotationToolsToggle"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.ToggleAnnotationToolbarCommand}"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.HasDocument), Mode=OneWay}">
                    <FontIcon FontSize="16" Glyph="&#xED63;" />
                </Button>

                <!-- Menu de Opções do Documento (GNOME Papers) -->
                <Button
                    x:Name="DocumentMenuBtn"
                    x:Uid="DocumentMenuButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Uid="Menu_Print" Click="OnPrintClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE749;" />
                                </MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="P" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem x:Uid="Menu_FullScreen" Command="{x:Bind ViewModel.ToggleFullScreenCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE740;" />
                                </MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F11" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem x:Uid="Menu_Presentation" Click="OnPresentationClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE714;" />
                                </MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F5" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>

                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem x:Uid="Menu_OpenCopy" Command="{x:Bind ViewModel.OpenCopyCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C8;" />
                                </MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="N" Modifiers="Control,Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem x:Uid="Menu_OpenWith" Command="{x:Bind ViewModel.OpenWithCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7AC;" />
                                </MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="O" Modifiers="Control,Shift" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem x:Uid="Menu_SaveAs" Command="{x:Bind ViewModel.SaveAsCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>

                            <MenuFlyoutSeparator />

                            <ToggleMenuFlyoutItem
                                x:Uid="Menu_Continuous"
                                Click="OnContinuousMenuClick"
                                IsChecked="{x:Bind converters:UiHelpers.IsContinuous(ViewModel.ViewMode), Mode=OneWay}">
                                <ToggleMenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="C" />
                                </ToggleMenuFlyoutItem.KeyboardAccelerators>
                            </ToggleMenuFlyoutItem>

                            <ToggleMenuFlyoutItem
                                x:Uid="Menu_DualPage"
                                IsChecked="{x:Bind ViewModel.IsDualPage, Mode=TwoWay}">
                                <ToggleMenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="D" />
                                </ToggleMenuFlyoutItem.KeyboardAccelerators>
                            </ToggleMenuFlyoutItem>

                            <ToggleMenuFlyoutItem
                                x:Uid="Menu_OddPagesLeft"
                                IsChecked="{x:Bind ViewModel.IsOddPagesLeft, Mode=TwoWay}">
                                <ToggleMenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="O" />
                                </ToggleMenuFlyoutItem.KeyboardAccelerators>
                            </ToggleMenuFlyoutItem>

                            <ToggleMenuFlyoutItem
                                x:Uid="Menu_Rtl"
                                IsChecked="{x:Bind ViewModel.IsRightToLeft, Mode=TwoWay}" />

                            <MenuFlyoutSeparator />

                            <MenuFlyoutItem x:Uid="Menu_Rotate" Command="{x:Bind ViewModel.RotateClockwiseCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7AD;" />
                                </MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Right" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>

                            <MenuFlyoutItem x:Uid="Menu_DocumentProperties" Command="{x:Bind ViewModel.ShowPropertiesCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE946;" />
                                </MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Enter" Modifiers="Menu" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Botão de Configurações Gerais (Engrenagem) -->
                <Button
                    x:Name="SettingsBtn"
                    x:Uid="SettingsButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    CornerRadius="4"
                    Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================================================================= -->
        <!-- Layout Principal: Barra Lateral Redimensionável + Splitter + Main -->
        <!-- Sem ChildrenTransitions para evitar flicker visual no resize      -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <!-- Coluna 0: Barra Lateral Mica Redimensionável (220 a 480 DIPs) -->
                <ColumnDefinition
                    x:Name="SidebarColumn"
                    Width="260"
                    MinWidth="220"
                    MaxWidth="480" />
                <!-- Coluna 1: Divisória / Splitter Arrastável (6 DIPs) -->
                <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                <!-- Coluna 2: Container Arredondado Principal -->
                <ColumnDefinition x:Name="MainContentColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================= -->
            <!-- COLUNA 0: Barra Lateral Mica com Frame de Conteúdo + Rodapé   -->
            <!-- ============================================================= -->
            <Grid
                x:Name="SidebarContainer"
                Grid.Column="0"
                Background="Transparent"
                RowDefinitions="*,Auto"
                Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsSidebarOpen), Mode=OneWay}">

                <!-- Frame de Conteúdo das Abas da Barra Lateral (Navegação Direcional) -->
                <Frame
                    x:Name="SidebarContentFrame"
                    Grid.Row="0"
                    Background="Transparent"
                    IsNavigationStackEnabled="False" />

                <!-- Rodapé com SelectorBar Nativo sem Bordas (Ícones Maiores de 20px) -->
                <Border
                    Grid.Row="1"
                    Padding="4,6,4,6"
                    Background="Transparent"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <SelectorBar
                        x:Name="SidebarFooterSelectorBar"
                        HorizontalAlignment="Center"
                        SelectionChanged="OnSidebarFooterSelectionChanged">
                        <SelectorBarItem
                            x:Name="ThumbnailsSelectorItem"
                            x:Uid="Sidebar_Thumbnails"
                            Margin="4,0"
                            Padding="8,6">
                            <SelectorBarItem.Icon>
                                <FontIcon FontSize="20" Glyph="&#xF0E2;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem
                            x:Name="OutlineSelectorItem"
                            x:Uid="Sidebar_Outline"
                            Margin="4,0"
                            Padding="8,6">
                            <SelectorBarItem.Icon>
                                <FontIcon FontSize="20" Glyph="&#xE8FD;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem
                            x:Name="AnnotationsSelectorItem"
                            x:Uid="Sidebar_Annotations"
                            Margin="4,0"
                            Padding="8,6">
                            <SelectorBarItem.Icon>
                                <FontIcon FontSize="20" Glyph="&#xE8F2;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem
                            x:Name="BookmarksSelectorItem"
                            x:Uid="Sidebar_Bookmarks"
                            Margin="4,0"
                            Padding="8,6">
                            <SelectorBarItem.Icon>
                                <FontIcon FontSize="20" Glyph="&#xE8A4;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem
                            x:Name="AttachmentsSelectorItem"
                            x:Uid="Sidebar_Attachments"
                            Margin="4,0"
                            Padding="8,6">
                            <SelectorBarItem.Icon>
                                <FontIcon FontSize="20" Glyph="&#xE723;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>
                </Border>
            </Grid>

            <!-- ============================================================= -->
            <!-- COLUNA 1: Splitter Arrastável Estilo Windows 11 Fotos         -->
            <!-- ============================================================= -->
            <controls:SplitterContainer
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsSidebarOpen), Mode=OneWay}">
                <Thumb
                    x:Name="SidebarSplitter"
                    Width="6"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    DragDelta="OnSidebarSplitterDragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <!-- Indicador visual central discreto (||) -->
                                <Border
                                    Width="2"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                    CornerRadius="1" />
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </controls:SplitterContainer>

            <!-- ============================================================= -->
            <!-- COLUNA 2: Container Arredondado com Frame Principal           -->
            <!-- ============================================================= -->
            <Border
                x:Name="MainContentContainer"
                Grid.Column="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="{x:Bind converters:UiHelpers.MainContainerBorderThickness(ViewModel.IsSidebarOpen), Mode=OneWay}"
                CornerRadius="{x:Bind converters:UiHelpers.MainContainerCornerRadius(ViewModel.IsSidebarOpen), Mode=OneWay}">

                <!-- Frame de Conteúdo Principal (DocumentView vs. SettingsView) -->
                <Frame
                    x:Name="MainContentFrame"
                    Background="Transparent"
                    IsNavigationStackEnabled="False" />
            </Border>
        </Grid>
    </Grid>
</Window>
