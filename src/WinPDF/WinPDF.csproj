<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core application settings: WinUI 3, unpackaged, self-contained Windows App SDK runtime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>WinPDF</RootNamespace>
    <AssemblyName>WinPDF</AssemblyName>
    <Version>0.1.0-alpha.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;x86;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Unpackaged: runs directly from bin\ without MSIX registration (easy debugging). -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Ship the Windows App SDK runtime next to the exe so no runtime installer is required. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Fallback language for MRT Core resource lookup (Strings\en-US). -->
    <DefaultLanguage>en-US</DefaultLanguage>

    <!-- Required by [LibraryImport] source-generated PDFium bindings. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Default to x64 when no platform is supplied (WinUI cannot build as AnyCPU). -->
  <PropertyGroup Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">
    <Platform>x64</Platform>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Versions are defined centrally in Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="bblanchon.PDFium.Win32" GeneratePathProperty="true" />    
  </ItemGroup>

  <ItemGroup Condition="'$(Pkgbblanchon_PDFium_Win32)' != ''">
    <None Include="$(Pkgbblanchon_PDFium_Win32)\runtimes\win-x64\native\pdfium.dll"
          Condition="'$(Platform)' == 'x64'"
          Link="pdfium.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Include="$(Pkgbblanchon_PDFium_Win32)\runtimes\win-x86\native\pdfium.dll"
          Condition="'$(Platform)' == 'x86'"
          Link="pdfium.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Include="$(Pkgbblanchon_PDFium_Win32)\runtimes\win-arm64\native\pdfium.dll"
          Condition="'$(Platform)' == 'ARM64'"
          Link="pdfium.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
