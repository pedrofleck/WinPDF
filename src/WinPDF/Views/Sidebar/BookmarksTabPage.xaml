<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPDF.Views.Sidebar.BookmarksTabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinPDF.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Background="Transparent" RowDefinitions="Auto,*">
        <!-- Add/Remove bookmark button for current page -->
        <Button
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            Margin="4,4,4,8"
            Command="{x:Bind ViewModel.ToggleBookmarkCurrentPageCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE728;" />
                <TextBlock
                    x:Uid="BookmarkCurrentPageButton"
                    Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.CurrentDocument.IsCurrentPageBookmarked), Mode=OneWay}" />
                <TextBlock
                    x:Uid="BookmarkRemoveButton"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.CurrentDocument.IsCurrentPageBookmarked), Mode=OneWay}" />
            </StackPanel>
        </Button>

        <!-- Empty state when there are no bookmarks -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="24"
            Spacing="8"
            Visibility="{x:Bind converters:UiHelpers.HasNoItems(ViewModel.CurrentDocument.Bookmarks.Count), Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="28"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE728;" />
            <TextBlock
                x:Uid="BookmarksEmptyText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Bookmarks / Favorites list -->
        <ListView
            x:Name="BookmarksList"
            Grid.Row="1"
            Padding="4"
            IsItemClickEnabled="True"
            ItemClick="OnBookmarkItemClick"
            ItemsSource="{x:Bind ViewModel.CurrentDocument.Bookmarks, Mode=OneWay}"
            Visibility="{x:Bind converters:UiHelpers.HasItems(ViewModel.CurrentDocument.Bookmarks.Count), Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:BookmarkItemViewModel">
                    <Border
                        Margin="0,4,0,0"
                        Padding="8,4,4,4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        PointerEntered="OnBookmarkCardPointerEntered"
                        PointerExited="OnBookmarkCardPointerExited">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    ToolTipService.ToolTip="{x:Bind PageBadgeText, Mode=OneWay}"
                                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(IsDisplayMode), Mode=OneWay}">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xE728;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind DisplayText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBox
                                    x:Name="BookmarkRenameTextBox"
                                    Height="28"
                                    MinHeight="28"
                                    Padding="6,3,6,3"
                                    FontSize="13"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    DataContext="{x:Bind}"
                                    Text="{x:Bind EditingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    KeyDown="OnRenameTextBoxKeyDown"
                                    LostFocus="OnRenameTextBoxLostFocus"
                                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(IsEditing), Mode=OneWay}">
                                    <TextBox.Resources>
                                        <x:Double x:Key="TextControlThemeMinHeight">28</x:Double>
                                    </TextBox.Resources>
                                </TextBox>
                            </Grid>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                                <Button
                                    x:Name="RenameBookmarkItemButton"
                                    x:Uid="RenameBookmarkItemButton"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Opacity="0"
                                    VerticalAlignment="Center"
                                    Click="OnRenameBookmarkItemClick"
                                    CornerRadius="4"
                                    DataContext="{x:Bind}"
                                    IsTabStop="False"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(IsDisplayMode), Mode=OneWay}">
                                    <Button.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.12" />
                                    </Button.OpacityTransition>
                                    <FontIcon
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE70F;" />
                                </Button>

                                <Button
                                    x:Uid="RemoveBookmarkItemButton"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="OnRemoveBookmarkItemClick"
                                    CornerRadius="4"
                                    DataContext="{x:Bind}"
                                    IsTabStop="False"
                                    Style="{StaticResource SubtleButtonStyle}">
                                    <FontIcon
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
