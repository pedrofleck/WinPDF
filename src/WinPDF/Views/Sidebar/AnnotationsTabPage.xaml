<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPDF.Views.Sidebar.AnnotationsTabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinPDF.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <!-- Estado Vazio quando não há comentários / anotações -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="24"
            Spacing="8"
            Visibility="{x:Bind converters:UiHelpers.HasNoItems(ViewModel.CurrentDocument.AnnotationsSummary.Count), Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="28"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE8F2;" />
            <TextBlock
                x:Uid="AnnotationsEmptyText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Lista de Anotações -->
        <ListView
            Padding="4"
            ItemsSource="{x:Bind ViewModel.CurrentDocument.AnnotationsSummary, Mode=OneWay}"
            Visibility="{x:Bind converters:UiHelpers.HasItems(ViewModel.CurrentDocument.AnnotationsSummary.Count), Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:AnnotationItemViewModel">
                    <Border
                        Margin="0,2,0,2"
                        Padding="8,6,8,6"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="14"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE8F2;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind Text}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
