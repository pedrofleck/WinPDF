<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPDF.Views.Sidebar.AnnotationsTabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinPDF.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <!-- Empty state when there are no comments / annotations / digital signatures -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="24"
            Spacing="8"
            Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.CurrentDocument.HasAnnotationsOrSignatures), Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="28"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE90A;" />
            <TextBlock
                x:Uid="AnnotationsEmptyText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Signatures + Annotations & Comments list -->
        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.CurrentDocument.HasAnnotationsOrSignatures), Mode=OneWay}">
            <StackPanel Padding="8,4,8,12" Spacing="10">

                <!-- Digital Signatures section (only when document is signed) -->
                <StackPanel
                    Spacing="4"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.CurrentDocument.HasSignatures), Mode=OneWay}">
                    <TextBlock
                        x:Uid="Annotations_SignaturesHeader"
                        Margin="4,4,4,2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontWeight="SemiBold"
                        Style="{StaticResource CaptionTextBlockStyle}" />

                    <ListView
                        IsItemClickEnabled="True"
                        ItemClick="OnSignatureItemClick"
                        SelectionMode="None"
                        ItemsSource="{x:Bind ViewModel.CurrentDocument.Signatures, Mode=OneWay}">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2,0,2" />
                                <Setter Property="MinHeight" Value="36" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SignatureItemViewModel">
                                <Border
                                    Padding="10,8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <FontIcon
                                            Grid.Column="0"
                                            FontSize="16"
                                            VerticalAlignment="Top"
                                            Margin="0,2,0,0"
                                            Glyph="{x:Bind StatusGlyph}">
                                            <FontIcon.Foreground>
                                                <SolidColorBrush Color="{x:Bind StatusColor}" />
                                            </FontIcon.Foreground>
                                        </FontIcon>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                FontSize="13"
                                                Text="{x:Bind SignerName}"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="2"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="12"
                                                Text="{x:Bind StatusText}"
                                                TextWrapping="Wrap">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{x:Bind StatusColor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock
                                                FontSize="11.5"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind IssuerName}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{x:Bind converters:UiHelpers.VisibleIf(HasIssuerName)}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind FormattedSigningTime}"
                                                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(HasSigningTime)}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="{x:Bind PageBadgeText}"
                                                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(HasPageLocation)}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Annotations & Comments section -->
                <StackPanel
                    Spacing="4"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.CurrentDocument.HasAnyAnnotations), Mode=OneWay}">
                    <CheckBox
                        x:Uid="Annotations_FilterCommentsCheckBox"
                        Margin="4,2,4,2"
                        MinWidth="0"
                        MinHeight="28"
                        FontSize="12.5"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsChecked="{x:Bind ViewModel.CurrentDocument.FilterCommentsOnly, Mode=TwoWay}" />

                    <TextBlock
                        x:Uid="Annotations_FilterEmptyText"
                        Margin="4,12,4,4"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind converters:UiHelpers.HasNoItems(ViewModel.CurrentDocument.AnnotationsSummary.Count), Mode=OneWay}" />

                    <ListView
                        IsItemClickEnabled="True"
                        ItemClick="OnAnnotationItemClick"
                        SelectionMode="None"
                        ItemsSource="{x:Bind ViewModel.CurrentDocument.AnnotationsSummary, Mode=OneWay}"
                        Visibility="{x:Bind converters:UiHelpers.HasItems(ViewModel.CurrentDocument.AnnotationsSummary.Count), Mode=OneWay}">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2,0,2" />
                                <Setter Property="MinHeight" Value="36" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AnnotationItemViewModel">
                                <Border
                                    Padding="10,8"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="3">
                                        <Grid Grid.Row="0" Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Glyph="{x:Bind IconGlyph, Mode=OneWay}" />
                                        </Grid>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="{x:Bind SwatchColor, Mode=OneWay}" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                FontSize="12.5"
                                                Text="{x:Bind TitleText, Mode=OneWay}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                FontSize="11.5"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="·"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                FontSize="11.5"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind PageBadgeText}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>

                                        <Button
                                            x:Uid="Annotations_DeleteButton"
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Width="24"
                                            Height="24"
                                            MinWidth="24"
                                            MinHeight="24"
                                            Padding="0"
                                            CornerRadius="4"
                                            Click="OnDeleteAnnotationClick"
                                            Tag="{x:Bind}"
                                            Visibility="{x:Bind converters:UiHelpers.VisibleIf(CanDelete)}"
                                            Style="{StaticResource SubtleButtonStyle}">
                                            <FontIcon FontSize="11" Glyph="&#xE74D;" />
                                        </Button>

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            FontSize="12.5"
                                            Text="{x:Bind Text, Mode=OneWay}"
                                            MaxLines="3"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind converters:UiHelpers.VisibleIf(HasBodyText), Mode=OneWay}" />

                                        <StackPanel
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind Author, Mode=OneWay}"
                                                Visibility="{x:Bind converters:UiHelpers.VisibleIf(HasAuthor), Mode=OneWay}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                Text="{x:Bind FormattedDate, Mode=OneWay}"
                                                Visibility="{x:Bind converters:UiHelpers.VisibleIf(HasDate), Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
