<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPDF.Views.Sidebar.ThumbnailsTabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPDF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinPDF.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <ListView
            x:Name="ThumbnailsList"
            Padding="4"
            ItemsSource="{x:Bind ViewModel.CurrentDocument.Thumbnails, Mode=OneWay}"
            ContainerContentChanging="OnThumbnailsContainerContentChanging"
            SelectionChanged="OnThumbnailSelectionChanged"
            SelectionMode="Single">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ThumbnailItemViewModel">
                    <StackPanel
                        Margin="4,6,4,6"
                        HorizontalAlignment="Center"
                        Spacing="4">
                        <Border
                            Width="140"
                            Height="180"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid>
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="32"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="&#xE8A5;" />
                                <controls:ThumbnailPresenter Item="{x:Bind}" />
                            </Grid>
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind DisplayNumber}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
