<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPDF.Views.Sidebar.ThumbnailsTabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPDF.Controls"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinPDF.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <ScrollViewer
            x:Name="ThumbnailsScrollViewer"
            MinWidth="120"
            Padding="16,8,16,8"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            SizeChanged="OnThumbnailsScrollViewerSizeChanged"
            PointerEntered="OnThumbnailsPointerEntered"
            PointerExited="OnThumbnailsPointerExited"
            PointerPressed="OnThumbnailsPointerPressed"
            PointerReleased="OnThumbnailsPointerReleased"
            PointerCanceled="OnThumbnailsPointerCanceled"
            PointerCaptureLost="OnThumbnailsPointerCaptureLost"
            PointerWheelChanged="OnThumbnailsPointerWheelChanged"
            ViewChanging="OnThumbnailsScrollViewerViewChanging"
            ViewChanged="OnThumbnailsScrollViewerViewChanged">
            <ItemsRepeater
                x:Name="ThumbnailsRepeater"
                ItemsSource="{x:Bind ViewModel.CurrentDocument.Thumbnails, Mode=OneWay}"
                ElementPrepared="OnThumbnailsElementPrepared"
                ElementClearing="OnThumbnailsElementClearing">
                <ItemsRepeater.Layout>
                    <controls:SafeUniformGridLayout
                        x:Name="ThumbnailsLayout"
                        MinItemWidth="50"
                        MinItemHeight="40"
                        MinRowSpacing="4"
                        MinColumnSpacing="8"
                        ItemsStretch="Fill"
                        MaximumRowsOrColumns="2" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThumbnailItemViewModel">
                        <StackPanel
                            Spacing="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Tapped="OnThumbnailTapped"
                            Background="Transparent"
                            IsHitTestVisible="True">
                            <Border
                                Width="{x:Bind WidthDip, Mode=OneWay}"
                                Height="{x:Bind HeightDip, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                IsHitTestVisible="True">
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="28"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE8A5;" />
                                    <controls:ThumbnailPresenter Item="{x:Bind Mode=OneWay}" />
                                    <Border
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="2"
                                        CornerRadius="4"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(IsCurrentPage), Mode=OneWay}" />
                                </Grid>
                            </Border>
                            <Grid HorizontalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Text="{x:Bind DisplayNumber, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="{x:Bind converters:UiHelpers.CollapsedIf(IsCurrentPage), Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Text="{x:Bind DisplayNumber, Mode=OneWay}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(IsCurrentPage), Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
