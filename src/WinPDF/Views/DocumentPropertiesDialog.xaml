<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinPDF.Views.DocumentPropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Width="560"
    MaxWidth="580"
    Padding="0"
    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
    BackgroundSizing="InnerBorderEdge"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="8"
    mc:Ignorable="d">

    <Grid
        Width="560"
        HorizontalAlignment="Center"
        RowDefinitions="Auto,*,Auto">

        <!-- Row 0: Dialog Title (Form layout: 32px top, 20px bottom, 24px sides) -->
        <TextBlock
            Grid.Row="0"
            Text="{x:Bind DialogTitle, Mode=OneTime}"
            FontSize="20"
            FontWeight="SemiBold"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            Margin="24,28,24,20" />

        <!-- Row 1: Scrollable Body (Windows 4px grid & Form layout guidelines) -->
        <ScrollViewer
            Grid.Row="1"
            MaxHeight="460"
            Padding="24,0,24,24"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                <!-- Section 1: File Name -->
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="Properties_FileNameHeading"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        FontSize="14"
                        FontWeight="Normal"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Document.FileName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Section 2: Date and Time -->
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="Properties_DateTimeHeading"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind Document.FileModificationDateOnlyFormatted, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind Document.FileModificationTimeOnlyFormatted, Mode=OneWay}" />
                </StackPanel>

                <!-- Section 3: Size Information -->
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="Properties_SizeHeading"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind Document.ActivePageDimensionsFormatted, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind Document.FileSizeDetailed, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{x:Bind Document.PageCount, Mode=OneWay}" />
                        <TextBlock
                            x:Uid="Properties_PagesCountLabel"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Section 4: Folder Origin and Location -->
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="Properties_FolderLocationHeading"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind Document.FolderName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <HyperlinkButton
                        Margin="0,4,0,0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Left"
                        Click="OnOpenFileLocationClick"
                        ToolTipService.ToolTip="{x:Bind Document.FilePath, Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_OpenFileLocationLabel"
                            FontSize="13"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            TextDecorations="Underline" />
                    </HyperlinkButton>
                </StackPanel>

                <!-- Section 5: Additional Metadata -->
                <StackPanel
                    Spacing="16"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasAdditionalMetadata), Mode=OneWay}">

                    <Border
                        Height="1"
                        Margin="0,4,0,8"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <TextBlock
                        x:Uid="Properties_AdditionalInfoHeading"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- PDF Version -->
                    <StackPanel
                        Spacing="4"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasMetaPdfVersion), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_PdfVersionLabel"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="{x:Bind Document.MetaPdfVersion, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Title -->
                    <StackPanel
                        Spacing="4"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasMetaTitle), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_DocTitleLabel"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Document.MetaTitle, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Author -->
                    <StackPanel
                        Spacing="4"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasMetaAuthor), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_DocAuthorLabel"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Document.MetaAuthor, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Subject -->
                    <StackPanel
                        Spacing="4"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasMetaSubject), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_DocSubjectLabel"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Document.MetaSubject, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Keywords -->
                    <StackPanel
                        Spacing="4"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasMetaKeywords), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_DocKeywordsLabel"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Document.MetaKeywords, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Application / Creator -->
                    <StackPanel
                        Spacing="4"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasMetaCreator), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_DocCreatorLabel"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Document.MetaCreator, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- PDF Producer -->
                    <StackPanel
                        Spacing="4"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasMetaProducer), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_DocProducerLabel"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Document.MetaProducer, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Row 2: Distinct footer tone (Windows Media Player & Form layout style) -->
        <Border
            Grid.Row="2"
            Background="{ThemeResource LayerFillColorAltBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,8,8"
            Padding="24,18">
            <Button
                x:Name="CloseButton"
                Content="{x:Bind CloseButtonLabel, Mode=OneTime}"
                Click="OnCloseButtonClick"
                Style="{StaticResource DefaultButtonStyle}"
                HorizontalAlignment="Center"
                MinWidth="260"
                Height="36" />
        </Border>
    </Grid>
</ContentDialog>
