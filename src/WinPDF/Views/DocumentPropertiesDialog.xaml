<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinPDF.Views.DocumentPropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
    BackgroundSizing="InnerBorderEdge"
    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="8"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">480</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">480</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">200</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">680</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <Thickness x:Key="ContentDialogTitleMargin">0</Thickness>
        <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
        <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
        <StaticResource x:Key="ContentDialogBackground" ResourceKey="AcrylicBackgroundFillColorDefaultBrush" />
        <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="SurfaceStrokeColorDefaultBrush" />
        <Thickness x:Key="ContentDialogBorderWidth">1</Thickness>
    </ContentDialog.Resources>

    <Grid
        Width="480"
        HorizontalAlignment="Center"
        RowDefinitions="Auto,*,Auto">

        <!-- Row 0: Standard Windows 11 Dialog Title -->
        <TextBlock
            Grid.Row="0"
            Margin="24,24,24,16"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind DialogTitle, Mode=OneTime}" />

        <!-- Row 1: Single-Column Scrollable Properties Body in Acrylic -->
        <ScrollViewer
            Grid.Row="1"
            MaxHeight="440"
            Padding="24,0,24,24"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <!-- File Name -->
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Uid="Properties_FileNameHeading"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Document.FileName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Document Title (if present) -->
                <StackPanel
                    Spacing="2"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasMetaTitle), Mode=OneWay}">
                    <TextBlock
                        x:Uid="Properties_DocTitleLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Document.MetaTitle, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Author (if present) -->
                <StackPanel
                    Spacing="2"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasMetaAuthor), Mode=OneWay}">
                    <TextBlock
                        x:Uid="Properties_DocAuthorLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Document.MetaAuthor, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Subject (if present) -->
                <StackPanel
                    Spacing="2"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasMetaSubject), Mode=OneWay}">
                    <TextBlock
                        x:Uid="Properties_DocSubjectLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Document.MetaSubject, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Keywords (if present) -->
                <StackPanel
                    Spacing="2"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasMetaKeywords), Mode=OneWay}">
                    <TextBlock
                        x:Uid="Properties_DocKeywordsLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Document.MetaKeywords, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Date Modified -->
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Uid="Properties_DateTimeHeading"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Document.FileModificationDateFormatted, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Page Dimensions -->
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Uid="Properties_PageSizeHeading"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Document.ActivePageDimensionsFormatted, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- File Size -->
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Uid="Properties_SizeHeading"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Document.FileSizeDetailed, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Page Count -->
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Uid="Properties_PageCountHeading"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Document.PageCount, Mode=OneWay}" />
                </StackPanel>

                <!-- PDF Version (if present) -->
                <StackPanel
                    Spacing="2"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasMetaPdfVersion), Mode=OneWay}">
                    <TextBlock
                        x:Uid="Properties_PdfVersionLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Document.MetaPdfVersion, Mode=OneWay}" />
                </StackPanel>

                <!-- Creator Application (if present) -->
                <StackPanel
                    Spacing="2"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasMetaCreator), Mode=OneWay}">
                    <TextBlock
                        x:Uid="Properties_DocCreatorLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Document.MetaCreator, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- PDF Producer (if present) -->
                <StackPanel
                    Spacing="2"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(Document.HasMetaProducer), Mode=OneWay}">
                    <TextBlock
                        x:Uid="Properties_DocProducerLabel"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Document.MetaProducer, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- File Location + Open File Location Link (Windows 11 Media Player Style) -->
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Uid="Properties_FolderLocationHeading"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Document.FilePath, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Margin="0,6,0,0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Left"
                        Click="OnOpenFileLocationClick"
                        ToolTipService.ToolTip="{x:Bind Document.FilePath, Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_OpenFileLocationLabel"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}" />
                    </HyperlinkButton>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Row 2: Distinct Bottom Command Area Tone (Windows 11 ContentDialog / Media Player Style) -->
        <Border
            Grid.Row="2"
            Padding="24,16"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,7,7">
            <Button
                x:Name="CloseButton"
                MinWidth="200"
                Height="32"
                HorizontalAlignment="Right"
                Click="OnCloseButtonClick"
                Content="{x:Bind CloseButtonLabel, Mode=OneTime}"
                Style="{StaticResource DefaultButtonStyle}" />
        </Border>
    </Grid>
</ContentDialog>
