<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPDF.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:vm="using:WinPDF.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer HorizontalAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
        <Grid
            x:Name="SettingsRootGrid"
            Margin="36,40,36,36"
            HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CardsColumn" Width="*" />
                <ColumnDefinition x:Name="SpacerColumn" Width="48" />
                <ColumnDefinition x:Name="AboutColumn" Width="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Main "Settings" header at the top -->
            <TextBlock
                x:Name="SettingsHeaderTitle"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                x:Uid="Settings_Page_Title"
                FontSize="28"
                FontWeight="SemiBold"
                Margin="0,0,0,36">
                <TextBlock.RenderTransform>
                    <CompositeTransform x:Name="SettingsHeaderTransform" />
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- Column 0: Configuration cards (Wide, proportional) -->
            <StackPanel
                x:Name="CardsPanel"
                Grid.Row="1"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Spacing="24">

                <!-- ========================================================= -->
                <!-- Section 1: APPEARANCE                                     -->
                <!-- ========================================================= -->
                <StackPanel x:Name="AppearanceSectionPanel" Spacing="12">
                    <StackPanel.RenderTransform>
                        <CompositeTransform x:Name="AppearanceSectionTransform" />
                    </StackPanel.RenderTransform>
                    <TextBlock
                        x:Uid="Settings_Nav_Appearance"
                        FontWeight="SemiBold"
                        Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE793;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    x:Uid="Settings_Theme_Header"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings_Theme_Description"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="2"
                                Width="180"
                                VerticalAlignment="Center"
                                SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="Settings_Theme_System" />
                                <ComboBoxItem x:Uid="Settings_Theme_Light" />
                                <ComboBoxItem x:Uid="Settings_Theme_Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ========================================================= -->
                <!-- Section 2: VIEWING                                        -->
                <!-- ========================================================= -->
                <StackPanel x:Name="ViewingSectionPanel" Spacing="12">
                    <StackPanel.RenderTransform>
                        <CompositeTransform x:Name="ViewingSectionTransform" />
                    </StackPanel.RenderTransform>
                    <TextBlock
                        x:Uid="Settings_Nav_Viewing"
                        FontWeight="SemiBold"
                        Style="{StaticResource SubtitleTextBlockStyle}" />

                    <!-- Card: Default viewing mode -->
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xF28B;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    x:Uid="Settings_Viewing_ModeHeader"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings_Viewing_ModeDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="2"
                                Width="180"
                                VerticalAlignment="Center"
                                SelectedIndex="{x:Bind ViewModel.ViewModeIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="Settings_Viewing_ModeContinuous" />
                                <ComboBoxItem x:Uid="Settings_Viewing_ModePaged" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Card: Default zoom preference -->
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE773;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    x:Uid="Settings_Viewing_ZoomHeader"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings_Viewing_ZoomDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="2"
                                Width="180"
                                VerticalAlignment="Center"
                                SelectedIndex="{x:Bind ViewModel.DefaultZoomIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="Settings_Viewing_ZoomFitWidth" />
                                <ComboBoxItem x:Uid="Settings_Viewing_ZoomFitPage" />
                                <ComboBoxItem x:Uid="Settings_Viewing_ZoomDefault" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Card: Reopen last document on startup -->
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE81C;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    x:Uid="Settings_Viewing_ReopenHeader"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings_Viewing_ReopenDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                IsOn="{x:Bind ViewModel.ReopenLastDocument, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!-- Card: Remember last page per document -->
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xF572;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    x:Uid="Settings_Viewing_RememberPageHeader"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings_Viewing_RememberPageDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                IsOn="{x:Bind ViewModel.RememberDocumentPage, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!-- Card: Save view settings per document -->
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE890;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    x:Uid="Settings_Viewing_SaveViewHeader"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings_Viewing_SaveViewDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                IsOn="{x:Bind ViewModel.SaveDocumentViewSettings, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ========================================================= -->
                <!-- Section 3: ANNOTATIONS                                    -->
                <!-- ========================================================= -->
                <StackPanel x:Name="AnnotationsSectionPanel" Spacing="12">
                    <StackPanel.RenderTransform>
                        <CompositeTransform x:Name="AnnotationsSectionTransform" />
                    </StackPanel.RenderTransform>
                    <TextBlock
                        x:Uid="Settings_Nav_Annotations"
                        FontWeight="SemiBold"
                        Style="{StaticResource SubtitleTextBlockStyle}" />

                    <!-- Card: Draw with touch -->
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="16"
                            IsHitTestVisible="False"
                            Opacity="0.5">
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                Glyph="&#xE70F;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    x:Uid="Settings_Annotations_TouchHeader"
                                    Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings_Annotations_TouchDescription"
                                    Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                IsOn="{x:Bind ViewModel.DefaultTouchDrawing, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ========================================================= -->
                <!-- Section 4: ADVANCED                                       -->
                <!-- ========================================================= -->
                <StackPanel x:Name="AdvancedSectionPanel" Spacing="12">
                    <StackPanel.RenderTransform>
                        <CompositeTransform x:Name="AdvancedSectionTransform" />
                    </StackPanel.RenderTransform>
                    <TextBlock
                        x:Uid="Settings_Nav_Advanced"
                        FontWeight="SemiBold"
                        Style="{StaticResource SubtitleTextBlockStyle}" />

                    <!-- Card: Application display language -->
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Glyph="&#xE774;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    x:Uid="Settings_Advanced_LanguageHeader"
                                    Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="Settings_Advanced_LanguageDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="Settings_Advanced_LanguageRestartNotice"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsLanguageRestartNoticeVisible), Mode=OneWay}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="2"
                                Width="180"
                                VerticalAlignment="Center"
                                SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                                <ComboBoxItem x:Uid="Settings_Advanced_LanguageSystem" />
                                <ComboBoxItem IsEnabled="False" IsHitTestVisible="False" MinHeight="1" Height="9" Padding="0">
                                    <MenuFlyoutSeparator Margin="-12,0,-12,0" />
                                </ComboBoxItem>
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="Português (Brasil)" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ========================================================= -->
            <!-- Section 4: ABOUT WINPDF (Column 2, MS Paint style)        -->
            <!-- ========================================================= -->
            <StackPanel
                x:Name="AboutPanel"
                Grid.Row="1"
                Grid.Column="2"
                Width="300"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Spacing="16">
                <StackPanel.RenderTransform>
                    <CompositeTransform x:Name="AboutPanelTransform" />
                </StackPanel.RenderTransform>

                <TextBlock
                    x:Uid="Settings_Nav_About"
                    FontWeight="SemiBold"
                    Style="{StaticResource SubtitleTextBlockStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Image
                        Width="36"
                        Height="36"
                        VerticalAlignment="Center"
                        Source="ms-appx:///Assets/appicon.png" />
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock
                            x:Uid="Settings_About_AppHeader"
                            FontWeight="SemiBold"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.AppVersion}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.AppArchitecture}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    x:Uid="Settings_About_Description"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    TextWrapping="Wrap" />

                <StackPanel Margin="4,8,0,0" Spacing="6">
                    <TextBlock
                        x:Uid="Settings_About_Copyright"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}" />

                    <HyperlinkButton
                        x:Name="LicenseLinkButton"
                        x:Uid="Settings_About_LicenseLink"
                        Margin="0,6,0,0"
                        Padding="0"
                        Click="OnLicenseLinkClick" />

                    <HyperlinkButton
                        x:Name="ThirdPartyNoticesLinkButton"
                        x:Uid="Settings_About_ThirdPartyLink"
                        Padding="0"
                        Click="OnThirdPartyNoticesLinkClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
