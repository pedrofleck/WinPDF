<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinPDF.Views.DocumentPropertiesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinPDF.ViewModels"
    mc:Ignorable="d">

    <!-- Card Flutuante Estilo Fotos do Windows 11 -->
    <Border
        Width="300"
        Margin="0,8,8,8"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Translation="0,0,16">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>

        <Grid RowDefinitions="Auto,*">
            <!-- ============================================================= -->
            <!-- Cabeçalho Superior do Card ("Informação" + Botão Fechar)      -->
            <!-- ============================================================= -->
            <Border
                Grid.Row="0"
                Padding="18,12,12,12"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                CornerRadius="8,8,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        x:Uid="Properties_Title"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Informação" />

                    <Button
                        x:Name="ClosePropertiesBtn"
                        x:Uid="Properties_CloseButton"
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Command="{x:Bind ViewModel.ClosePropertiesCommand, Mode=OneWay}"
                        CornerRadius="4"
                        IsTabStop="False"
                        Style="{StaticResource SubtleButtonStyle}">
                        <FontIcon FontSize="11" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============================================================= -->
            <!-- Conteúdo com Rolagem (Hierarquia e Espaçamento Windows Photos) -->
            <!-- ============================================================= -->
            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel
                    Padding="18,16,18,20"
                    Spacing="18">

                    <!-- Seção 1: Nome do Arquivo -->
                    <StackPanel Spacing="4">
                        <TextBlock
                            x:Uid="Properties_FileNameHeading"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="Nome do arquivo" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.CurrentDocument.FileName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Seção 2: Data e Hora -->
                    <StackPanel Spacing="3">
                        <TextBlock
                            x:Uid="Properties_DateTimeHeading"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="Data e hora" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.CurrentDocument.FileModificationDateOnlyFormatted, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.CurrentDocument.FileModificationTimeOnlyFormatted, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Seção 3: Informações de Tamanho -->
                    <StackPanel Spacing="3">
                        <TextBlock
                            x:Uid="Properties_SizeHeading"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="Informações de tamanho" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.CurrentDocument.ActivePageDimensionsFormatted, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.CurrentDocument.FileSizeDetailed, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.CurrentDocument.PageCount, Mode=OneWay}" />
                            <TextBlock
                                x:Uid="Properties_PagesCountLabel"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="páginas" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Seção 4: Origem e Local da Pasta (Clicar no link abre a pasta no Explorer) -->
                    <StackPanel Spacing="3">
                        <TextBlock
                            x:Uid="Properties_FolderLocationHeading"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="Origem e local da pasta" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.CurrentDocument.FolderName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <HyperlinkButton
                            Margin="0,2,0,0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Command="{x:Bind ViewModel.OpenFileLocationCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.CurrentDocument.FilePath, Mode=OneWay}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                IsTextSelectionEnabled="False"
                                Text="{x:Bind ViewModel.CurrentDocument.FilePath, Mode=OneWay}"
                                TextDecorations="Underline"
                                TextWrapping="Wrap" />
                        </HyperlinkButton>
                    </StackPanel>

                    <!-- Seção 5: Informações Adicionais (Metadados Reais do PDF) -->
                    <StackPanel
                        Spacing="14"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.CurrentDocument.HasAdditionalMetadata), Mode=OneWay}">

                        <Border
                            Height="1"
                            Margin="0,0,0,2"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <TextBlock
                            x:Uid="Properties_AdditionalInfoHeading"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="Informações adicionais" />

                        <!-- Versão do PDF -->
                        <StackPanel
                            Spacing="2"
                            Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.CurrentDocument.HasMetaPdfVersion), Mode=OneWay}">
                            <TextBlock
                                x:Uid="Properties_PdfVersionLabel"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="Versão do PDF" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.CurrentDocument.MetaPdfVersion, Mode=OneWay}" />
                        </StackPanel>

                        <!-- Título -->
                        <StackPanel
                            Spacing="2"
                            Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.CurrentDocument.HasMetaTitle), Mode=OneWay}">
                            <TextBlock
                                x:Uid="Properties_DocTitleLabel"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="Título" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.CurrentDocument.MetaTitle, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Autor -->
                        <StackPanel
                            Spacing="2"
                            Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.CurrentDocument.HasMetaAuthor), Mode=OneWay}">
                            <TextBlock
                                x:Uid="Properties_DocAuthorLabel"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="Autor" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.CurrentDocument.MetaAuthor, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Assunto -->
                        <StackPanel
                            Spacing="2"
                            Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.CurrentDocument.HasMetaSubject), Mode=OneWay}">
                            <TextBlock
                                x:Uid="Properties_DocSubjectLabel"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="Assunto" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.CurrentDocument.MetaSubject, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Palavras-chave -->
                        <StackPanel
                            Spacing="2"
                            Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.CurrentDocument.HasMetaKeywords), Mode=OneWay}">
                            <TextBlock
                                x:Uid="Properties_DocKeywordsLabel"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="Palavras-chave" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.CurrentDocument.MetaKeywords, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Aplicativo de Criação -->
                        <StackPanel
                            Spacing="2"
                            Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.CurrentDocument.HasMetaCreator), Mode=OneWay}">
                            <TextBlock
                                x:Uid="Properties_DocCreatorLabel"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="Aplicativo de criação" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.CurrentDocument.MetaCreator, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Produtor do PDF -->
                        <StackPanel
                            Spacing="2"
                            Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.CurrentDocument.HasMetaProducer), Mode=OneWay}">
                            <TextBlock
                                x:Uid="Properties_DocProducerLabel"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="Produtor do PDF" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.CurrentDocument.MetaProducer, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
