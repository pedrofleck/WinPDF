<UserControl
    x:Class="WinPDF.Views.DocumentPropertiesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinPDF.ViewModels"
    mc:Ignorable="d">

    <Grid
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,0,0,0">
        <Grid.RowDefinitions>
            <!-- Linha 0: Cabeçalho com Título e Botão Fechar -->
            <RowDefinition Height="Auto" />
            <!-- Linha 1: Botões de Ação Rápida (Copiar Caminho / Abrir Local) -->
            <RowDefinition Height="Auto" />
            <!-- Linha 2: Conteúdo com Rolagem -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- Cabeçalho Superior da Barra Lateral                               -->
        <!-- ================================================================= -->
        <Grid
            Grid.Row="0"
            Padding="20,16,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Uid="Properties_Title"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Informação" />

            <Button
                x:Name="ClosePropertiesBtn"
                x:Uid="Properties_CloseButton"
                Grid.Column="1"
                Width="32"
                Height="32"
                Padding="0"
                Command="{x:Bind ViewModel.ClosePropertiesCommand, Mode=OneWay}"
                CornerRadius="4"
                IsTabStop="False"
                Style="{StaticResource SubtleButtonStyle}">
                <FontIcon FontSize="12" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!-- ================================================================= -->
        <!-- Botões de Ação Rápida (Estilo Fotos do Windows 11)                -->
        <!-- ================================================================= -->
        <Grid
            Grid.Row="1"
            Margin="16,0,16,16"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Ação 1: Copiar Caminho -->
            <Button
                x:Name="CopyPathButton"
                x:Uid="Properties_CopyPathButton"
                Grid.Column="0"
                Height="54"
                HorizontalAlignment="Stretch"
                Padding="8,6"
                Command="{x:Bind ViewModel.CopyFilePathCommand, Mode=OneWay}"
                CornerRadius="6"
                Style="{StaticResource DefaultButtonStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE8C8;" />
                    <TextBlock
                        x:Uid="Properties_CopyPathLabel"
                        FontSize="11"
                        Text="Copiar Caminho"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>

            <!-- Ação 2: Abrir Local no Explorador -->
            <Button
                x:Name="OpenFileLocationButton"
                x:Uid="Properties_OpenFileLocationButton"
                Grid.Column="1"
                Height="54"
                HorizontalAlignment="Stretch"
                Padding="8,6"
                Command="{x:Bind ViewModel.OpenFileLocationCommand, Mode=OneWay}"
                CornerRadius="6"
                Style="{StaticResource DefaultButtonStyle}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xED25;" />
                    <TextBlock
                        x:Uid="Properties_OpenFileLocationLabel"
                        FontSize="11"
                        Text="Abrir Local"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ================================================================= -->
        <!-- Conteúdo com Rolagem das Propriedades                             -->
        <!-- ================================================================= -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                Padding="20,0,20,24"
                Spacing="18">

                <!-- Seção 1: Nome do Arquivo -->
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="Properties_FileNameHeading"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Nome do arquivo" />
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.CurrentDocument.FileName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Seção 2: Data e Hora -->
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="Properties_DateTimeHeading"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Data e hora" />
                    <TextBlock
                        FontSize="13"
                        Text="{x:Bind ViewModel.CurrentDocument.FileModificationDateFormatted, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Seção 3: Informações de Tamanho e Dimensões -->
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="Properties_SizeHeading"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Informações de tamanho" />
                    <TextBlock
                        FontSize="13"
                        Text="{x:Bind ViewModel.CurrentDocument.ActivePageDimensionsFormatted, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.CurrentDocument.FileSizeDetailed, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.CurrentDocument.PageCount, Mode=OneWay}" />
                        <TextBlock
                            x:Uid="Properties_PagesCountLabel"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="páginas" />
                    </StackPanel>
                </StackPanel>

                <!-- Seção 4: Origem e Local da Pasta -->
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Uid="Properties_FolderLocationHeading"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Origem e local da pasta" />
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.CurrentDocument.FolderName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <HyperlinkButton
                        Padding="0"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Left"
                        Command="{x:Bind ViewModel.OpenFileLocationCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.CurrentDocument.FilePath, Mode=OneWay}">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="False"
                            Text="{x:Bind ViewModel.CurrentDocument.FilePath, Mode=OneWay}"
                            TextDecorations="Underline"
                            TextWrapping="Wrap" />
                    </HyperlinkButton>
                </StackPanel>

                <!-- Seção 5: Metadados do PDF (Informações Adicionais) -->
                <StackPanel
                    Spacing="12"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIfHasMetadata(ViewModel.CurrentDocument.Metadata), Mode=OneWay}">
                    <TextBlock
                        x:Uid="Properties_AdditionalInfoHeading"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Informações adicionais" />

                    <!-- Versão do PDF -->
                    <StackPanel
                        Spacing="2"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIfNotNullOrEmpty(ViewModel.CurrentDocument.Metadata.PdfVersion), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_PdfVersionLabel"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Versão do PDF" />
                        <TextBlock
                            FontSize="13"
                            Text="{x:Bind ViewModel.CurrentDocument.Metadata.PdfVersion, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Título -->
                    <StackPanel
                        Spacing="2"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIfNotNullOrEmpty(ViewModel.CurrentDocument.Metadata.Title), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_DocTitleLabel"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Título" />
                        <TextBlock
                            FontSize="13"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.CurrentDocument.Metadata.Title, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Autor -->
                    <StackPanel
                        Spacing="2"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIfNotNullOrEmpty(ViewModel.CurrentDocument.Metadata.Author), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_DocAuthorLabel"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Autor" />
                        <TextBlock
                            FontSize="13"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.CurrentDocument.Metadata.Author, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Assunto -->
                    <StackPanel
                        Spacing="2"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIfNotNullOrEmpty(ViewModel.CurrentDocument.Metadata.Subject), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_DocSubjectLabel"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Assunto" />
                        <TextBlock
                            FontSize="13"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.CurrentDocument.Metadata.Subject, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Palavras-chave -->
                    <StackPanel
                        Spacing="2"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIfNotNullOrEmpty(ViewModel.CurrentDocument.Metadata.Keywords), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_DocKeywordsLabel"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Palavras-chave" />
                        <TextBlock
                            FontSize="13"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.CurrentDocument.Metadata.Keywords, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Aplicativo de Criação -->
                    <StackPanel
                        Spacing="2"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIfNotNullOrEmpty(ViewModel.CurrentDocument.Metadata.Creator), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_DocCreatorLabel"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Aplicativo de criação" />
                        <TextBlock
                            FontSize="13"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.CurrentDocument.Metadata.Creator, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Produtor do PDF -->
                    <StackPanel
                        Spacing="2"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIfNotNullOrEmpty(ViewModel.CurrentDocument.Metadata.Producer), Mode=OneWay}">
                        <TextBlock
                            x:Uid="Properties_DocProducerLabel"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Produtor do PDF" />
                        <TextBlock
                            FontSize="13"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.CurrentDocument.Metadata.Producer, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
