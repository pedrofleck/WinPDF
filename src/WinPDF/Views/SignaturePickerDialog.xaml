<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinPDF.Views.SignaturePickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinPDF.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
    BackgroundSizing="InnerBorderEdge"
    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
    BorderThickness="1"
    CornerRadius="8"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">520</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">520</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">240</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">1000</x:Double>
        <Thickness x:Key="ContentDialogPadding">0</Thickness>
        <Thickness x:Key="ContentDialogTitleMargin">0</Thickness>
        <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
        <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="Transparent" />
        <StaticResource x:Key="ContentDialogBackground" ResourceKey="AcrylicBackgroundFillColorDefaultBrush" />
        <StaticResource x:Key="ContentDialogBorderBrush" ResourceKey="SurfaceStrokeColorDefaultBrush" />
        <Thickness x:Key="ContentDialogBorderWidth">1</Thickness>
    </ContentDialog.Resources>

    <Grid Width="520" HorizontalAlignment="Center">
        <!-- View 1: Saved Signatures Gallery + Opaque Image Warning -->
        <Grid
            x:Name="GalleryPanel"
            RowDefinitions="Auto,*,Auto"
            Visibility="Visible">

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="24,22,24,14" Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        x:Name="GalleryTitleText"
                        Grid.Column="0"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border
                        Grid.Column="1"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <TextBlock
                            x:Name="SignatureCountText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </Border>
                </Grid>
                <TextBlock
                    x:Name="SelectHintText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!-- Body -->
            <Grid
                Grid.Row="1"
                Padding="24,0,24,16"
                RowDefinitions="Auto,Auto,*"
                RowSpacing="12">
                <!-- Inline opaque-background warning -->
                <Border
                    x:Name="OpaqueWarningPanel"
                    Grid.Row="0"
                    Padding="12"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <Border
                            x:Name="OpaquePreviewContainer"
                            Height="96"
                            Padding="8"
                            Background="#FFFFFFFF"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Image
                                x:Name="OpaquePreviewImage"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Stretch="Uniform" />
                        </Border>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <FontIcon
                                Grid.Column="0"
                                Margin="0,2,0,0"
                                VerticalAlignment="Top"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xE7BA;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock
                                    x:Name="OpaqueWarningTitleText"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="OpaqueWarningMessageText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                <Button
                                    x:Name="OpaqueAddAnywayButton"
                                    HorizontalAlignment="Stretch"
                                    Click="OnOpaqueWarningAddAnywayClick"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Name="OpaqueCancelButton"
                                    HorizontalAlignment="Stretch"
                                    Click="OnOpaqueWarningCancelClick" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Empty state -->
                <Border
                    x:Name="EmptyStatePanel"
                    Grid.Row="1"
                    MinHeight="140"
                    Padding="24"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="28"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xEE56;" />
                        <TextBlock
                            x:Name="EmptyStateText"
                            MaxWidth="340"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Saved signature cards (2x5 grid with smooth delete/reposition animations) -->
                <GridView
                    x:Name="SignaturesGridView"
                    Grid.Row="2"
                    Margin="0,0,-10,0"
                    Padding="0"
                    IsItemClickEnabled="True"
                    ItemClick="OnSignatureCardClick"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollMode="Auto"
                    SelectionMode="None"
                    SizeChanged="OnSignaturesGridViewSizeChanged">
                    <GridView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                        </TransitionCollection>
                    </GridView.ItemContainerTransitions>
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid
                                x:Name="SignaturesWrapGrid"
                                ItemHeight="98"
                                ItemWidth="241"
                                MaximumRowsOrColumns="2"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0,0,10,10" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:SignatureCardItem">
                            <Grid Height="88">
                                <Border
                                    Padding="12,10"
                                    Background="#FFFFFFFF"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Image
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind Preview}"
                                        Stretch="Uniform" />
                                </Border>
                                <Border
                                    Width="20"
                                    Height="20"
                                    Margin="6"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="#FFF2B200"
                                    CornerRadius="10"
                                    Loaded="OnOpaqueBadgeLoaded"
                                    Visibility="{x:Bind OpaqueBadgeVisibility}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="#FF1A1A1A"
                                        Text="!" />
                                </Border>
                                <Button
                                    Width="26"
                                    Height="26"
                                    Margin="4"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="#14000000"
                                    CornerRadius="4"
                                    Loaded="OnDeleteButtonLoaded"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Tag="{x:Bind}">
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="#FF444444"
                                        Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- Footer -->
            <Border
                Grid.Row="2"
                Padding="24,14,24,20"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                    <Border
                        x:Name="DrawSignatureButtonHost"
                        Grid.Column="0"
                        Background="Transparent">
                        <Button
                            x:Name="DrawSignatureButton"
                            Click="OnOpenDrawPadClick"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xEE56;" />
                                <TextBlock x:Name="DrawSignatureButtonText" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Border
                        x:Name="AddImageButtonHost"
                        Grid.Column="1"
                        Background="Transparent">
                        <Button
                            x:Name="AddImageButton"
                            Click="OnAddImageClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE91B;" />
                                <TextBlock x:Name="AddImageButtonText" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <Button
                        x:Name="CloseGalleryButton"
                        Grid.Column="3"
                        MinWidth="84"
                        Click="OnCloseClick" />
                </Grid>
            </Border>
        </Grid>

        <!-- View 2: Signature Drawing Pad -->
        <Grid
            x:Name="DrawPanel"
            RowDefinitions="Auto,*,Auto"
            Visibility="Collapsed">

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="24,22,24,12" Spacing="4">
                <TextBlock
                    x:Name="DrawTitleText"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Name="DrawHintText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!-- Drawing surface & controls -->
            <StackPanel Grid.Row="1" Padding="24,0,24,16" Spacing="12">
                <!-- Ink colors + Clear -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            x:Name="ColorBlackButton"
                            Width="28"
                            Height="28"
                            Padding="0"
                            CornerRadius="14"
                            BorderThickness="2"
                            Click="OnDrawColorClick"
                            Tag="Black">
                            <Ellipse Width="18" Height="18" Fill="#FF141414" />
                        </Button>
                        <Button
                            x:Name="ColorBlueButton"
                            Width="28"
                            Height="28"
                            Padding="0"
                            CornerRadius="14"
                            BorderThickness="2"
                            Click="OnDrawColorClick"
                            Tag="Blue">
                            <Ellipse Width="18" Height="18" Fill="#FF1A4B9C" />
                        </Button>
                        <Button
                            x:Name="ColorRedButton"
                            Width="28"
                            Height="28"
                            Padding="0"
                            CornerRadius="14"
                            BorderThickness="2"
                            Click="OnDrawColorClick"
                            Tag="Red">
                            <Ellipse Width="18" Height="18" Fill="#FFC62828" />
                        </Button>
                    </StackPanel>

                    <Button
                        x:Name="ClearPadButton"
                        Grid.Column="2"
                        Click="OnClearPadClick">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="13" Glyph="&#xE75C;" />
                            <TextBlock x:Name="ClearPadButtonText" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- White canvas with black guide line -->
                <Border
                    Height="200"
                    Background="#FFFFFFFF"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <!-- Black guide line -->
                        <Border
                            Height="1.5"
                            Margin="24,0,24,52"
                            VerticalAlignment="Bottom"
                            Background="#FF222222"
                            IsHitTestVisible="False"
                            Opacity="0.65" />

                        <!-- Win2D ink canvas -->
                        <canvas:CanvasControl
                            x:Name="SignatureDrawCanvas"
                            ClearColor="Transparent"
                            Draw="OnDrawCanvasDraw"
                            ManipulationMode="None"
                            PointerCanceled="OnDrawCanvasPointerCanceled"
                            PointerCaptureLost="OnDrawCanvasPointerCaptureLost"
                            PointerMoved="OnDrawCanvasPointerMoved"
                            PointerPressed="OnDrawCanvasPointerPressed"
                            PointerReleased="OnDrawCanvasPointerReleased" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border
                Grid.Row="2"
                Padding="24,14,24,20"
                Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                CornerRadius="0,0,8,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Button
                        x:Name="BackToGalleryButton"
                        Grid.Column="0"
                        MinWidth="84"
                        Click="OnBackToGalleryClick" />
                    <Button
                        x:Name="SaveSignatureButton"
                        Grid.Column="2"
                        Click="OnSaveDrawnSignatureClick"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE73E;" />
                            <TextBlock x:Name="SaveSignatureButtonText" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
