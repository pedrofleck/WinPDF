<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPDF.Views.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPDF.Controls"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinPDF.Models"
    xmlns:vm="using:WinPDF.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="OnPageBoxAcceleratorInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAcceleratorInvoked" />
    </Page.KeyboardAccelerators>

    <Grid
        Background="Transparent"
        AllowDrop="True"
        DragOver="OnDocumentDragOver"
        Drop="OnDocumentDrop"
        PointerMoved="OnDocumentPointerMoved">
        <!-- Empty state when no document is open -->
        <StackPanel
            x:Name="EmptyStatePanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5"
            Spacing="12"
            Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.HasDocument), Mode=OneWay}">
            <StackPanel.RenderTransform>
                <CompositeTransform x:Name="EmptyStateTransform" />
            </StackPanel.RenderTransform>
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="56"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Glyph="&#xE8A5;" />
            <TextBlock
                x:Uid="EmptyStateTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Uid="EmptyStateSubtitle"
                MaxWidth="360"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Uid="EmptyStateOpenButton"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.OpenFileCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                        <TextBlock x:Uid="EmptyStateOpenButtonText" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>

        <!-- Standard non-intrusive notification at the top of the screen (e.g. Last document not found - 5s) -->
        <InfoBar
            x:Name="TopNotificationInfoBar"
            IsOpen="False"
            IsIconVisible="False"
            IsClosable="True"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,24,0,0"
            Canvas.ZIndex="110"
            CloseButtonClick="OnTopNotificationInfoBarCloseButtonClick" />

        <!-- Document display area -->
        <Grid
            x:Name="DocumentAreaGrid"
            Background="Transparent"
            RenderTransformOrigin="0.5,0.5"
            Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.HasDocument), Mode=OneWay}"
            RowDefinitions="*,Auto">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="DocumentAreaTransform" />
            </Grid.RenderTransform>

            <!-- Row 0: Unified document viewer (Continuous and Paged) -->
            <Grid
                x:Name="ScrollViewerContentRoot"
                Grid.Row="0"
                Background="Transparent">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            x:Uid="Context_PrevPage"
                            Command="{x:Bind ViewModel.PreviousPageCommand}"
                            KeyboardAcceleratorTextOverride="PgUp">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE76B;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            x:Uid="Context_NextPage"
                            Command="{x:Bind ViewModel.NextPageCommand}"
                            KeyboardAcceleratorTextOverride="PgDn">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE76C;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator />

                        <MenuFlyoutItem
                            x:Uid="Context_FitPage"
                            Click="OnFitPageClick"
                            KeyboardAcceleratorTextOverride="Ctrl+0">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE9A6;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            x:Uid="Context_FitWidth"
                            Click="OnFitWidthClick"
                            KeyboardAcceleratorTextOverride="Ctrl+2">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xF58A;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            x:Uid="Context_RotateClockwise"
                            Command="{x:Bind ViewModel.RotateClockwiseCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+R">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7AD;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            x:Uid="Context_RotateCounterClockwise"
                            Command="{x:Bind ViewModel.RotateCounterClockwiseCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+Shift+R">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7A7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <ToggleMenuFlyoutItem
                            x:Uid="Context_NightMode"
                            Command="{x:Bind ViewModel.ToggleNightModeCommand}"
                            IsChecked="{x:Bind ViewModel.IsNightMode, Mode=OneWay}"
                            KeyboardAcceleratorTextOverride="Ctrl+I">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE708;" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>

                        <MenuFlyoutSeparator />

                        <MenuFlyoutItem
                            x:Uid="Context_Presentation"
                            Command="{x:Bind ViewModel.StartPresentationCommand}"
                            KeyboardAcceleratorTextOverride="F5">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE786;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            x:Uid="Context_FullScreen"
                            Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                            KeyboardAcceleratorTextOverride="F11">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE740;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator />

                        <MenuFlyoutItem
                            x:Uid="Context_SaveAs"
                            Command="{x:Bind ViewModel.SaveAsCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+S">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74E;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            x:Uid="Context_Print"
                            Click="OnContextPrintClick"
                            KeyboardAcceleratorTextOverride="Ctrl+P">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE749;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutItem
                            x:Uid="Context_Properties"
                            Command="{x:Bind ViewModel.ShowPropertiesCommand}"
                            KeyboardAcceleratorTextOverride="Alt+Enter">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE946;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>

                        <MenuFlyoutSeparator />

                        <MenuFlyoutItem
                            x:Uid="Context_CloseDocument"
                            Command="{x:Bind ViewModel.CloseDocumentCommand}"
                            KeyboardAcceleratorTextOverride="Ctrl+W">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE711;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <Border
                    Background="Black"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsPresentationMode), Mode=OneWay}" />

                <!-- Hidden staging canvas for PrintDocument WriteableBitmap surface realization -->
                <Canvas
                    x:Name="PrintStagingCanvas"
                    Width="0"
                    Height="0"
                    IsHitTestVisible="False"
                    Opacity="0" />

                <ScrollViewer
                    x:Name="ContinuousScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Enabled"
                    MaxZoomFactor="8.0"
                    MinZoomFactor="0.25"
                    VerticalScrollBarVisibility="Visible"
                    ViewChanging="OnScrollViewerViewChanging"
                    ViewChanged="OnScrollViewerViewChanged"
                    ZoomMode="Enabled">
                    <ItemsRepeater
                        x:Name="ContinuousPagesRepeater"
                        Margin="{x:Bind converters:UiHelpers.RepeaterMargin(ViewModel.IsPresentationMode, ViewModel.CurrentDocument.IsContinuous), Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5"
                        ItemsSource="{x:Bind ViewModel.CurrentDocument.DisplayedRows, Mode=OneWay}">
                        <ItemsRepeater.RenderTransform>
                            <CompositeTransform x:Name="PagesRepeaterPushTransform" />
                        </ItemsRepeater.RenderTransform>
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:PdfPageRow">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <!-- Left page (or single page) -->
                                    <Border
                                        Width="{x:Bind LeftPageWidth, Mode=OneWay}"
                                        Height="{x:Bind LeftPageHeight, Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="{x:Bind converters:UiHelpers.PresentationBorderThickness(IsPresentationMode), Mode=OneWay}"
                                        CornerRadius="{x:Bind converters:UiHelpers.PresentationCornerRadius(IsPresentationMode), Mode=OneWay}">
                                        <controls:PdfPageCanvas
                                            PageInfo="{x:Bind LeftPage, Mode=OneWay}"
                                            IsNightMode="{x:Bind IsNightMode, Mode=OneWay}"
                                            RotationAngle="{x:Bind Rotation, Mode=OneWay}" />
                                    </Border>

                                    <!-- Right page (when double page) -->
                                    <Border
                                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(HasRightPage), Mode=OneWay}"
                                        Width="{x:Bind RightPageWidth, Mode=OneWay}"
                                        Height="{x:Bind RightPageHeight, Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="{x:Bind converters:UiHelpers.PresentationBorderThickness(IsPresentationMode), Mode=OneWay}"
                                        CornerRadius="{x:Bind converters:UiHelpers.PresentationCornerRadius(IsPresentationMode), Mode=OneWay}">
                                        <controls:PdfPageCanvas
                                            Visibility="{x:Bind converters:UiHelpers.VisibleIf(HasRightPage), Mode=OneWay}"
                                            PageInfo="{x:Bind RightPage, Mode=OneWay}"
                                            IsNightMode="{x:Bind IsNightMode, Mode=OneWay}"
                                            RotationAngle="{x:Bind Rotation, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- 80 DIPs navigation side strips 'Photos' style -->
                <Grid
                    x:Name="PrevPageZone"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Width="80"
                    Background="Transparent"
                    Translation="0,0,24"
                    PointerEntered="OnPrevZonePointerEntered"
                    PointerExited="OnPrevZonePointerExited"
                    Tapped="OnPrevZoneTapped"
                    Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.CurrentDocument.IsContinuous), Mode=OneWay}">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="PrevPageZoneTransform" />
                    </Grid.RenderTransform>
                    <Border
                        x:Name="PrevPageArrowPill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="36"
                        Height="64"
                        CornerRadius="6"
                        Opacity="0"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </Border.OpacityTransition>
                        <FontIcon Glyph="&#xE76B;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Grid
                    x:Name="NextPageZone"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="80"
                    Background="Transparent"
                    Translation="0,0,24"
                    PointerEntered="OnNextZonePointerEntered"
                    PointerExited="OnNextZonePointerExited"
                    Tapped="OnNextZoneTapped"
                    Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.CurrentDocument.IsContinuous), Mode=OneWay}">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="NextPageZoneTransform" />
                    </Grid.RenderTransform>
                    <Border
                        x:Name="NextPageArrowPill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="36"
                        Height="64"
                        CornerRadius="6"
                        Opacity="0"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </Border.OpacityTransition>
                        <FontIcon Glyph="&#xE76C;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Full screen / presentation banner (WinUI Gallery pattern) -->
                <InfoBar
                    x:Name="FullScreenInfoBar"
                    x:Uid="FullScreenInfoBar"
                    IsOpen="False"
                    IsIconVisible="False"
                    IsClosable="True"
                    Title="Full screen"
                    Message="Press Esc to exit full screen"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,24,0,0"
                    Canvas.ZIndex="100"
                    CloseButtonClick="OnFullScreenInfoBarCloseButtonClick" />

                <!-- 80 DIPs top clickable zone to exit presentation with subtle hover button -->
                <Grid
                    x:Name="ExitPresentationTopZone"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Height="80"
                    Background="Transparent"
                    Translation="0,0,33"
                    PointerEntered="OnExitPresentationZonePointerEntered"
                    PointerExited="OnExitPresentationZonePointerExited"
                    Tapped="OnExitPresentationZoneTapped"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsPresentationMode), Mode=OneWay}">
                    <Border
                        x:Name="ExitPresentationCloseBtnPill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Width="44"
                        Height="32"
                        CornerRadius="0,0,8,8"
                        Opacity="0"
                        Background="#80181818"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1,0,1,1">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </Border.OpacityTransition>
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Centered top container for floating search (Acrylic) and annotation toolbar -->
                <StackPanel
                    x:Name="FloatingTopContainer"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,12,0,0"
                    Spacing="8"
                    Canvas.ZIndex="95">
                    <StackPanel.RenderTransform>
                        <CompositeTransform x:Name="FloatingTopTransform" />
                    </StackPanel.RenderTransform>

                    <!-- Floating search bar in Acrylic (Windows 11 Notepad style) -->
                    <Border
                        x:Name="FloatingSearchBar"
                        HorizontalAlignment="Center"
                        Padding="8,4"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BackgroundSizing="InnerBorderEdge"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        RenderTransformOrigin="0.5,0.0"
                        Translation="0,0,32"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsSearchOpen), Mode=OneWay}">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="FloatingSearchBarTransform" />
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center">
                                <TextBox
                                    x:Name="DocumentSearchBox"
                                    x:Uid="SearchBox"
                                    Width="230"
                                    Height="30"
                                    MinHeight="30"
                                    Padding="28,4,8,4"
                                    FontSize="13"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    CornerRadius="4"
                                    KeyDown="OnDocumentSearchBoxKeyDown">
                                    <TextBox.Resources>
                                        <x:Double x:Key="TextControlThemeMinHeight">30</x:Double>
                                    </TextBox.Resources>
                                </TextBox>
                                <FontIcon
                                    Glyph="&#xE721;"
                                    FontSize="12"
                                    Margin="8,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsHitTestVisible="False" />
                            </Grid>

                            <Button
                                x:Name="SearchPrevButton"
                                x:Uid="SearchPrevButton"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="4"
                                IsTabStop="False"
                                Click="OnSearchPrevClick"
                                Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon FontSize="12" Glyph="&#xE70E;" />
                            </Button>

                            <Button
                                x:Name="SearchNextButton"
                                x:Uid="SearchNextButton"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="4"
                                IsTabStop="False"
                                Click="OnSearchNextClick"
                                Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon FontSize="12" Glyph="&#xE70D;" />
                            </Button>

                            <ToggleButton
                                x:Name="SearchMatchCaseToggle"
                                x:Uid="SearchMatchCaseToggle"
                                Width="32"
                                Height="30"
                                MinWidth="32"
                                MinHeight="30"
                                Padding="0"
                                CornerRadius="4"
                                IsTabStop="False"
                                BorderThickness="0">
                                <ToggleButton.Resources>
                                    <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                    <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                    <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                    <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                </ToggleButton.Resources>
                                <TextBlock
                                    Text="Aa"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </ToggleButton>

                            <Border
                                Width="1"
                                Height="18"
                                Margin="4,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Button
                                x:Name="SearchCloseButton"
                                x:Uid="SearchCloseButton"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="4"
                                IsTabStop="False"
                                Click="OnSearchCloseClick"
                                Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon FontSize="11" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Floating annotation toolbar (Centered top) -->
                    <Border
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Padding="8,4,8,4"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsAnnotationToolbarOpen), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ToggleButton
                                x:Uid="ToolSelectButton"
                                Click="OnToolSelectClicked"
                                IsChecked="{x:Bind converters:UiHelpers.IsSelectTool(ViewModel.ActiveTool), Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="&#xEF20;" />
                            </ToggleButton>
                            <ToggleButton
                                x:Uid="ToolPenButton"
                                Click="OnToolPenClicked"
                                IsChecked="{x:Bind converters:UiHelpers.IsPenTool(ViewModel.ActiveTool), Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="&#xED63;" />
                            </ToggleButton>
                            <ToggleButton
                                x:Uid="ToolHighlighterButton"
                                Click="OnToolHighlighterClicked"
                                IsChecked="{x:Bind converters:UiHelpers.IsHighlighterTool(ViewModel.ActiveTool), Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="&#xE891;" />
                            </ToggleButton>
                            <ToggleButton
                                x:Uid="ToolEraserButton"
                                Click="OnToolEraserClicked"
                                IsChecked="{x:Bind converters:UiHelpers.IsEraserTool(ViewModel.ActiveTool), Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="&#xE75C;" />
                            </ToggleButton>
                            <ToggleButton
                                x:Uid="ToolTextNoteButton"
                                Click="OnToolTextNoteClicked"
                                IsChecked="{x:Bind converters:UiHelpers.IsTextNoteTool(ViewModel.ActiveTool), Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="&#xE70B;" />
                            </ToggleButton>

                            <AppBarSeparator Margin="4,4,4,4" />

                            <ToggleButton
                                x:Uid="TouchDrawingToggle"
                                IsTabStop="False"
                                IsChecked="{x:Bind ViewModel.IsTouchDrawingEnabled, Mode=TwoWay}">
                                <FontIcon FontSize="14" Glyph="&#xED5F;" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>



            <!-- Row 1: Native 32 DIPs bottom status bar (Paint / Photos / Notepad style) -->
            <Grid
                x:Name="StatusBarBorder"
                Grid.Row="1"
                Height="32"
                Background="Transparent"
                Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.IsPresentationMode), Mode=OneWay}">
                <Border
                    x:Name="StatusBarBackdropBorder"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Border.RenderTransform>
                        <CompositeTransform x:Name="StatusBarBackdropTransform" />
                    </Border.RenderTransform>
                </Border>
                <Grid Padding="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left-aligned elements -->
                    <StackPanel
                        x:Name="StatusBarLeftPanel"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <CompositeTransform x:Name="StatusBarLeftTransform" />
                        </StackPanel.RenderTransform>

                        <!-- 1. "Inline Pill" page selector (Page [ X ] of Y) -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind PageBoxToolTipText, Mode=OneTime}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"
                                Text="{x:Bind PagePrefixText, Mode=OneTime}" />
                            <TextBox
                                x:Name="StatusBarPageBox"
                                Height="24"
                                MinHeight="24"
                                MinWidth="36"
                                MaxWidth="56"
                                Padding="4,4,4,0"
                                FontSize="12"
                                TextAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                CornerRadius="4"
                                BorderThickness="1"
                                Background="Transparent"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                InputScope="Number"
                                GotFocus="OnStatusBarPageBoxGotFocus"
                                KeyDown="OnStatusBarPageBoxKeyDown"
                                LostFocus="OnStatusBarPageBoxLostFocus"
                                Text="{x:Bind ViewModel.CurrentDocument.CurrentPageNumber, Mode=OneWay}">
                                <TextBox.Resources>
                                    <x:Double x:Key="TextControlThemeMinHeight">24</x:Double>
                                    <x:Double x:Key="TextControlThemeMinWidth">36</x:Double>
                                    <Thickness x:Key="TextControlThemePadding">4,4,4,0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.FormattedPageCount, Mode=OneWay}" />
                        </StackPanel>

                        <!-- 2. Separator | -->
                        <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <!-- 3. Format badge -->
                        <TextBlock
                            Text="{x:Bind ViewModel.CurrentDocument.FileFormatBadge, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind FormatToolTipText, Mode=OneTime}" />

                        <!-- 4. Separator | -->
                        <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <!-- 5. Unified clickable info and size Button [ ⓘ . XB ] -->
                        <Button
                            Padding="8,0"
                            Height="24"
                            MinHeight="24"
                            MinWidth="0"
                            CornerRadius="4"
                            BorderThickness="0"
                            IsTabStop="False"
                            Style="{StaticResource SubtleButtonStyle}"
                            Command="{x:Bind ViewModel.ShowPropertiesCommand}"
                            ToolTipService.ToolTip="{x:Bind PropertiesToolTipText, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.CurrentDocument.FormattedFileSize, Mode=OneWay}"
                                    FontSize="12"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right-aligned elements -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">

                        <!-- 1. Double page toggle (Two pages on/off) -->
                        <ToggleButton
                            Width="28"
                            Height="24"
                            Padding="0"
                            MinWidth="28"
                            MinHeight="24"
                            CornerRadius="4"
                            IsChecked="{x:Bind ViewModel.CurrentDocument.IsDoublePage, Mode=TwoWay}"
                            BorderThickness="0"
                            ToolTipService.ToolTip="{x:Bind DoublePageToolTipText, Mode=OneTime}">
                            <ToggleButton.Resources>
                                <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                            </ToggleButton.Resources>
                            <FontIcon Glyph="&#xE89A;" FontSize="12" VerticalAlignment="Center" />
                        </ToggleButton>

                        <!-- 2. Separator | -->
                        <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <!-- 3. Continuous scroll toggle (Continuous on/off) -->
                        <ToggleButton
                            Width="28"
                            Height="24"
                            Padding="0"
                            MinWidth="28"
                            MinHeight="24"
                            CornerRadius="4"
                            IsChecked="{x:Bind ViewModel.CurrentDocument.IsContinuous, Mode=TwoWay}"
                            BorderThickness="0"
                            ToolTipService.ToolTip="{x:Bind ContinuousToolTipText, Mode=OneTime}">
                            <ToggleButton.Resources>
                                <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                            </ToggleButton.Resources>
                            <FontIcon Glyph="&#xEC8F;" FontSize="12" VerticalAlignment="Center" />
                        </ToggleButton>

                        <!-- 4. Separator | -->
                        <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <!-- 5. Fit and Zoom block -->
                        <!-- Fit Vertical button (Fit to page) -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="28"
                            Height="24"
                            Padding="0"
                            MinWidth="28"
                            MinHeight="24"
                            CornerRadius="4"
                            Click="OnFitPageClick"
                            ToolTipService.ToolTip="{x:Bind FitVerticalToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE9A6;" FontSize="13" />
                        </Button>

                        <!-- Fit Horizontal button (Fit to width) -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="28"
                            Height="24"
                            Padding="0"
                            MinWidth="28"
                            MinHeight="24"
                            CornerRadius="4"
                            Click="OnFitWidthClick"
                            ToolTipService.ToolTip="{x:Bind FitHorizontalToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xF58A;" FontSize="13" />
                        </Button>

                        <!-- Zoom preset dropdown (100% ▾) -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Height="24"
                            Padding="8,0"
                            MinWidth="60"
                            CornerRadius="4"
                            ToolTipService.ToolTip="{x:Bind ZoomPresetToolTipText, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.FormattedZoomPercent, Mode=OneWay}"
                                    FontSize="12"
                                    VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;" FontSize="9" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuFlyoutItem Text="50%" Click="OnZoomPresetClick" Tag="0.5" />
                                    <MenuFlyoutItem Text="75%" Click="OnZoomPresetClick" Tag="0.75" />
                                    <MenuFlyoutItem Text="100%" Click="OnZoomPresetClick" Tag="1.0" />
                                    <MenuFlyoutItem Text="125%" Click="OnZoomPresetClick" Tag="1.25" />
                                    <MenuFlyoutItem Text="150%" Click="OnZoomPresetClick" Tag="1.5" />
                                    <MenuFlyoutItem Text="200%" Click="OnZoomPresetClick" Tag="2.0" />
                                    <MenuFlyoutItem Text="300%" Click="OnZoomPresetClick" Tag="3.0" />
                                    <MenuFlyoutItem Text="400%" Click="OnZoomPresetClick" Tag="4.0" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Zoom - button -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="0"
                            MinWidth="26"
                            MinHeight="24"
                            CornerRadius="4"
                            Click="OnZoomOutClick"
                            ToolTipService.ToolTip="{x:Bind ZoomOutToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE738;" FontSize="13" />
                        </Button>

                        <!-- Horizontal zoom bar (Slider) -->
                        <Slider
                            x:Name="StatusBarZoomSlider"
                            Width="88"
                            Minimum="25"
                            Maximum="500"
                            StepFrequency="5"
                            VerticalAlignment="Center"
                            IsTabStop="False"
                            IsThumbToolTipEnabled="False"
                            ValueChanged="OnStatusBarZoomSliderValueChanged"
                            ToolTipService.ToolTip="{x:Bind ZoomSliderToolTipText, Mode=OneTime}" />

                        <!-- Zoom + button -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="0"
                            MinWidth="26"
                            MinHeight="24"
                            CornerRadius="4"
                            Click="OnZoomInClick"
                            ToolTipService.ToolTip="{x:Bind ZoomInToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                        </Button>

                        <!-- 6. Separator | -->
                        <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <!-- 7. Presentation and Full Screen block -->
                        <!-- Slideshow button (F5) -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="0"
                            MinWidth="26"
                            MinHeight="24"
                            CornerRadius="4"
                            Command="{x:Bind ViewModel.StartPresentationCommand}"
                            ToolTipService.ToolTip="{x:Bind SlideshowToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE786;" FontSize="13" />
                        </Button>

                        <!-- Full Screen button (F11) -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="0"
                            MinWidth="26"
                            MinHeight="24"
                            CornerRadius="4"
                            Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                            ToolTipService.ToolTip="{x:Bind FullScreenToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE740;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
