<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPDF.Views.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPDF.Controls"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinPDF.Models"
    xmlns:vm="using:WinPDF.ViewModels"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="OnPageBoxAcceleratorInvoked" />
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAcceleratorInvoked" />
    </Page.KeyboardAccelerators>

    <Grid
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        AllowDrop="True"
        DragOver="OnDocumentDragOver"
        Drop="OnDocumentDrop"
        PointerMoved="OnDocumentPointerMoved">
        <!-- Empty State quando nenhum documento está aberto -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.HasDocument), Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="56"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Glyph="&#xE8A5;" />
            <TextBlock
                x:Uid="EmptyStateTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Uid="EmptyStateSubtitle"
                MaxWidth="360"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Uid="EmptyStateOpenButton"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.OpenFileCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                        <TextBlock x:Uid="EmptyStateOpenButtonText" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>

        <!-- Área de Exibição do Documento -->
        <Grid
            Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.HasDocument), Mode=OneWay}"
            RowDefinitions="*,Auto">

            <!-- Row 0: Visualizador Unificado do Documento (Contínuo e Paginado) -->
            <Grid
                Grid.Row="0"
                Background="{x:Bind converters:UiHelpers.ViewerBackground(ViewModel.IsPresentationMode), Mode=OneWay}">

                <ScrollViewer
                    x:Name="ContinuousScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    MaxZoomFactor="8.0"
                    MinZoomFactor="0.25"
                    VerticalScrollBarVisibility="Visible"
                    ViewChanging="OnScrollViewerViewChanging"
                    ViewChanged="OnScrollViewerViewChanged"
                    PointerWheelChanged="OnScrollViewerPointerWheelChanged"
                    ZoomMode="Enabled">
                    <ItemsRepeater
                        x:Name="ContinuousPagesRepeater"
                        Margin="{x:Bind converters:UiHelpers.RepeaterMargin(ViewModel.IsPresentationMode), Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.CurrentDocument.DisplayedRows, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="16" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:PdfPageRow">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <!-- Página Esquerda (ou Única) -->
                                    <Border
                                        Width="{x:Bind LeftPage.DisplayWidthDip, Mode=OneTime}"
                                        Height="{x:Bind LeftPage.DisplayHeightDip, Mode=OneTime}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="{x:Bind converters:UiHelpers.PresentationBorderThickness(IsPresentationMode), Mode=OneTime}"
                                        CornerRadius="{x:Bind converters:UiHelpers.PresentationCornerRadius(IsPresentationMode), Mode=OneTime}"
                                        Translation="0,0,16">
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <controls:PdfPageCanvas PageInfo="{x:Bind LeftPage, Mode=OneTime}" />
                                    </Border>

                                    <!-- Página Direita (quando Dupla) -->
                                    <Border
                                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(HasRightPage), Mode=OneTime}"
                                        Width="{x:Bind RightPageWidth, Mode=OneTime}"
                                        Height="{x:Bind RightPageHeight, Mode=OneTime}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="{x:Bind converters:UiHelpers.PresentationBorderThickness(IsPresentationMode), Mode=OneTime}"
                                        CornerRadius="{x:Bind converters:UiHelpers.PresentationCornerRadius(IsPresentationMode), Mode=OneTime}"
                                        Translation="0,0,16">
                                        <Border.Shadow>
                                            <ThemeShadow />
                                        </Border.Shadow>
                                        <controls:PdfPageCanvas PageInfo="{x:Bind RightPage, Mode=OneTime}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- Botões de Navegação Lateral (Modo Não Contínuo / Slide) -->
                <Button
                    x:Name="PrevPageFloatingButton"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="16,0,0,0"
                    Width="40"
                    Height="60"
                    CornerRadius="20"
                    Click="OnPrevPageFloatingClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Translation="0,0,24"
                    Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.CurrentDocument.IsContinuous), Mode=OneWay}">
                    <FontIcon Glyph="&#xE76B;" FontSize="16" />
                </Button>

                <Button
                    x:Name="NextPageFloatingButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,16,0"
                    Width="40"
                    Height="60"
                    CornerRadius="20"
                    Click="OnNextPageFloatingClick"
                    Style="{StaticResource SubtleButtonStyle}"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Translation="0,0,24"
                    Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.CurrentDocument.IsContinuous), Mode=OneWay}">
                    <FontIcon Glyph="&#xE76C;" FontSize="16" />
                </Button>

                <!-- Botão Flutuante de Sair da Apresentação (F5 / Esc) -->
                <Border
                    x:Name="ExitPresentationOverlay"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,16,0,0"
                    CornerRadius="8"
                    Background="#D0181818"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    Translation="0,0,32"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsPresentationMode), Mode=OneWay}">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Button
                        Style="{StaticResource SubtleButtonStyle}"
                        Command="{x:Bind ViewModel.ExitPresentationCommand}"
                        Padding="12,6"
                        CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="White" />
                            <TextBlock
                                Text="{x:Bind ExitPresentationText, Mode=OneTime}"
                                FontSize="12"
                                Foreground="White"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Barra Flutuante de Ferramentas de Anotação (Topo Centralizado) -->
                <Border
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,12,0,0"
                    Padding="6,4,6,4"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsAnnotationToolbarOpen), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ToggleButton
                            x:Uid="ToolSelectButton"
                            Click="OnToolSelectClicked"
                            IsChecked="{x:Bind converters:UiHelpers.IsSelectTool(ViewModel.ActiveTool), Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xEF20;" />
                        </ToggleButton>
                        <ToggleButton
                            x:Uid="ToolPenButton"
                            Click="OnToolPenClicked"
                            IsChecked="{x:Bind converters:UiHelpers.IsPenTool(ViewModel.ActiveTool), Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xED63;" />
                        </ToggleButton>
                        <ToggleButton
                            x:Uid="ToolHighlighterButton"
                            Click="OnToolHighlighterClicked"
                            IsChecked="{x:Bind converters:UiHelpers.IsHighlighterTool(ViewModel.ActiveTool), Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE891;" />
                        </ToggleButton>
                        <ToggleButton
                            x:Uid="ToolEraserButton"
                            Click="OnToolEraserClicked"
                            IsChecked="{x:Bind converters:UiHelpers.IsEraserTool(ViewModel.ActiveTool), Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE75C;" />
                        </ToggleButton>
                        <ToggleButton
                            x:Uid="ToolTextNoteButton"
                            Click="OnToolTextNoteClicked"
                            IsChecked="{x:Bind converters:UiHelpers.IsTextNoteTool(ViewModel.ActiveTool), Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE70B;" />
                        </ToggleButton>

                        <AppBarSeparator Margin="4,2,4,2" />

                        <ToggleButton
                            x:Uid="TouchDrawingToggle"
                            IsChecked="{x:Bind ViewModel.IsTouchDrawingEnabled, Mode=TwoWay}">
                            <FontIcon FontSize="14" Glyph="&#xED5F;" />
                        </ToggleButton>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 1: Barra de Status Inferior Nativa de 32 DIPs (estilo Paint / Fotos / Notepad) -->
            <Border
                x:Name="StatusBarBorder"
                Grid.Row="1"
                Height="32"
                Padding="12,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.IsPresentationMode), Mode=OneWay}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Elementos Alinhados à Esquerda -->
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">

                        <!-- 1. Seletor de Página "Inline Pill" (Página [ X ] de Y) -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind PageBoxToolTipText, Mode=OneTime}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"
                                Text="{x:Bind PagePrefixText, Mode=OneTime}" />
                            <TextBox
                                x:Name="StatusBarPageBox"
                                Height="24"
                                MinHeight="24"
                                MinWidth="34"
                                MaxWidth="56"
                                Padding="4,2,4,2"
                                FontSize="12"
                                TextAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                CornerRadius="4"
                                BorderThickness="1"
                                Background="Transparent"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                InputScope="Number"
                                GotFocus="OnStatusBarPageBoxGotFocus"
                                KeyDown="OnStatusBarPageBoxKeyDown"
                                LostFocus="OnStatusBarPageBoxLostFocus"
                                Text="{x:Bind ViewModel.CurrentDocument.CurrentPageNumber, Mode=OneWay}">
                                <TextBox.Resources>
                                    <x:Double x:Key="TextControlThemeMinHeight">24</x:Double>
                                    <x:Double x:Key="TextControlThemeMinWidth">34</x:Double>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.FormattedPageCount, Mode=OneWay}" />
                        </StackPanel>

                        <!-- 2. Separador | -->
                        <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <!-- 3. Badge de Formato -->
                        <TextBlock
                            Text="{x:Bind ViewModel.CurrentDocument.FileFormatBadge, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind FormatToolTipText, Mode=OneTime}" />

                        <!-- 4. Separador | -->
                        <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <!-- 5. Botão Unificado Clicável de Informações e Tamanho [ ⓘ . Ícone Tamanho . XB ] -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Padding="6,2"
                            Height="24"
                            CornerRadius="4"
                            Command="{x:Bind ViewModel.ShowPropertiesCommand}"
                            ToolTipService.ToolTip="{x:Bind PropertiesToolTipText, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="12" />
                                <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.CurrentDocument.FormattedFileSize, Mode=OneWay}"
                                    FontSize="12"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Elementos Alinhados à Direita -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">

                        <!-- 1. Toggle Exibição Dupla (Duas Páginas on/off) -->
                        <ToggleButton
                            Width="26"
                            Height="24"
                            Padding="0"
                            MinWidth="26"
                            MinHeight="24"
                            CornerRadius="4"
                            IsChecked="{x:Bind ViewModel.CurrentDocument.IsDoublePage, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="{x:Bind DoublePageToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE89A;" FontSize="13" />
                        </ToggleButton>

                        <!-- 2. Separador | -->
                        <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <!-- 3. Toggle Rolagem Contínua (Contínuo on/off) -->
                        <ToggleButton
                            Width="26"
                            Height="24"
                            Padding="0"
                            MinWidth="26"
                            MinHeight="24"
                            CornerRadius="4"
                            IsChecked="{x:Bind ViewModel.CurrentDocument.IsContinuous, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="{x:Bind ContinuousToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE8EA;" FontSize="13" />
                        </ToggleButton>

                        <!-- 4. Separador | -->
                        <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <!-- 5. Bloco de Ajuste e Zoom -->
                        <!-- Botão Fit Vertical (Ajustar à Página) -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="0"
                            MinWidth="26"
                            MinHeight="24"
                            CornerRadius="4"
                            Click="OnFitPageClick"
                            ToolTipService.ToolTip="{x:Bind FitVerticalToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE9A6;" FontSize="13" />
                        </Button>

                        <!-- Botão Fit Horizontal (Ajustar à Largura) -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="0"
                            MinWidth="26"
                            MinHeight="24"
                            CornerRadius="4"
                            Click="OnFitWidthClick"
                            ToolTipService.ToolTip="{x:Bind FitHorizontalToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE8A0;" FontSize="13" />
                        </Button>

                        <!-- Caixa Seletora de Zoom (100% ▾) -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Height="24"
                            Padding="6,0"
                            MinWidth="58"
                            CornerRadius="4"
                            ToolTipService.ToolTip="{x:Bind ZoomPresetToolTipText, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.FormattedZoomPercent, Mode=OneWay}"
                                    FontSize="12"
                                    VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;" FontSize="9" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuFlyoutItem Text="50%" Click="OnZoomPresetClick" Tag="0.5" />
                                    <MenuFlyoutItem Text="75%" Click="OnZoomPresetClick" Tag="0.75" />
                                    <MenuFlyoutItem Text="100%" Click="OnZoomPresetClick" Tag="1.0" />
                                    <MenuFlyoutItem Text="125%" Click="OnZoomPresetClick" Tag="1.25" />
                                    <MenuFlyoutItem Text="150%" Click="OnZoomPresetClick" Tag="1.5" />
                                    <MenuFlyoutItem Text="200%" Click="OnZoomPresetClick" Tag="2.0" />
                                    <MenuFlyoutItem Text="300%" Click="OnZoomPresetClick" Tag="3.0" />
                                    <MenuFlyoutItem Text="400%" Click="OnZoomPresetClick" Tag="4.0" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Botão - Zoom -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="0"
                            MinWidth="26"
                            MinHeight="24"
                            CornerRadius="4"
                            Click="OnZoomOutClick"
                            ToolTipService.ToolTip="{x:Bind ZoomOutToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE738;" FontSize="13" />
                        </Button>

                        <!-- Barra Horizontal de Zoom (Slider) -->
                        <Slider
                            x:Name="StatusBarZoomSlider"
                            Width="88"
                            Minimum="25"
                            Maximum="500"
                            StepFrequency="5"
                            VerticalAlignment="Center"
                            IsThumbToolTipEnabled="False"
                            ValueChanged="OnStatusBarZoomSliderValueChanged"
                            ToolTipService.ToolTip="{x:Bind ZoomSliderToolTipText, Mode=OneTime}" />

                        <!-- Botão + Zoom -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="0"
                            MinWidth="26"
                            MinHeight="24"
                            CornerRadius="4"
                            Click="OnZoomInClick"
                            ToolTipService.ToolTip="{x:Bind ZoomInToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                        </Button>

                        <!-- 6. Separador | -->
                        <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <!-- 7. Bloco de Apresentação e Tela Cheia -->
                        <!-- Botão Apresentação de Slides (F5) -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="0"
                            MinWidth="26"
                            MinHeight="24"
                            CornerRadius="4"
                            Command="{x:Bind ViewModel.StartPresentationCommand}"
                            ToolTipService.ToolTip="{x:Bind SlideshowToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE786;" FontSize="13" />
                        </Button>

                        <!-- Botão Tela Cheia (F11) -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="0"
                            MinWidth="26"
                            MinHeight="24"
                            CornerRadius="4"
                            Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                            ToolTipService.ToolTip="{x:Bind FullScreenToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE740;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
