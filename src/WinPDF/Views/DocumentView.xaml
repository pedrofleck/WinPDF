<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinPDF.Views.DocumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinPDF.Controls"
    xmlns:converters="using:WinPDF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinPDF.Models"
    xmlns:vm="using:WinPDF.ViewModels"
    Background="Transparent"
    KeyboardAcceleratorPlacementMode="Hidden"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="AcrylicFlyoutPresenterStyle" TargetType="FlyoutPresenter">
            <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <MenuFlyout
            x:Name="DocumentContextMenuFlyout"
            Closed="OnDocumentContextMenuClosed">
            <MenuFlyoutItem
                x:Name="ContextCopyMenuItem"
                x:Uid="Context_Copy"
                Command="{x:Bind ViewModel.CopySelectedTextCommand}"
                IsEnabled="{x:Bind ViewModel.HasTextSelection, Mode=OneWay}"
                KeyboardAcceleratorTextOverride="Ctrl+C">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Name="ContextHighlightMenuItem"
                x:Uid="Context_Highlight"
                Click="OnContextHighlightClick"
                Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7E6;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Name="ContextHighlightWithCommentMenuItem"
                x:Uid="Context_HighlightWithComment"
                Click="OnContextHighlightWithCommentClick"
                Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE90A;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutSubItem
                x:Name="ContextMarkupSubMenu"
                x:Uid="Context_MarkupSubMenu"
                Visibility="Collapsed">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon Glyph="&#xE8D2;" />
                </MenuFlyoutSubItem.Icon>
                <MenuFlyoutItem
                    x:Uid="Context_Underline"
                    Tag="Underline"
                    Click="OnContextMarkupSubtypeClick" />
                <MenuFlyoutItem
                    x:Uid="Context_StrikeOut"
                    Tag="StrikeOut"
                    Click="OnContextMarkupSubtypeClick" />
                <MenuFlyoutItem
                    x:Uid="Context_Squiggly"
                    Tag="Squiggly"
                    Click="OnContextMarkupSubtypeClick">
                    <MenuFlyoutItem.Icon>
                        <PathIcon Data="M 1.25,1.00 L 2.33,1.00 L 4.45,9.03 L 6.96,1.65 L 8.04,1.65 L 10.55,9.03 L 12.67,1.00 L 13.75,1.00 L 11.12,10.05 L 9.98,10.05 L 7.50,2.69 L 5.02,10.05 L 3.88,10.05 Z M 1.45,13.07 L 1.80,13.00 L 2.22,12.78 L 2.70,12.44 L 3.23,12.06 L 3.82,11.75 L 4.48,11.63 L 5.13,11.75 L 5.72,12.06 L 6.25,12.44 L 6.73,12.78 L 7.15,13.00 L 7.50,13.07 L 7.85,13.00 L 8.27,12.78 L 8.75,12.44 L 9.28,12.06 L 9.87,11.75 L 10.53,11.63 L 11.18,11.75 L 11.77,12.06 L 12.30,12.44 L 12.78,12.78 L 13.20,13.00 L 13.55,13.07 L 13.55,13.93 L 12.90,13.81 L 12.31,13.50 L 11.78,13.12 L 11.30,12.78 L 10.88,12.56 L 10.53,12.49 L 10.17,12.56 L 9.75,12.78 L 9.27,13.12 L 8.74,13.50 L 8.15,13.81 L 7.50,13.93 L 6.85,13.81 L 6.26,13.50 L 5.73,13.12 L 5.25,12.78 L 4.83,12.56 L 4.48,12.49 L 4.12,12.56 L 3.70,12.78 L 3.22,13.12 L 2.69,13.50 L 2.10,13.81 L 1.45,13.93 Z" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Name="ContextColorYellowItem"
                    Tag="Yellow"
                    Click="OnContextColorHighlightClick" />
                <MenuFlyoutItem
                    x:Name="ContextColorGreenItem"
                    Tag="Green"
                    Click="OnContextColorHighlightClick" />
                <MenuFlyoutItem
                    x:Name="ContextColorBlueItem"
                    Tag="Blue"
                    Click="OnContextColorHighlightClick" />
                <MenuFlyoutItem
                    x:Name="ContextColorPinkItem"
                    Tag="Pink"
                    Click="OnContextColorHighlightClick" />
                <MenuFlyoutItem
                    x:Name="ContextColorOrangeItem"
                    Tag="Orange"
                    Click="OnContextColorHighlightClick" />
                <MenuFlyoutItem
                    x:Name="ContextColorRedItem"
                    Tag="Red"
                    Click="OnContextColorHighlightClick" />
                <MenuFlyoutItem
                    x:Name="ContextColorBlackItem"
                    Tag="Black"
                    Click="OnContextColorHighlightClick" />
            </MenuFlyoutSubItem>

            <MenuFlyoutSeparator x:Name="ContextAnnotSeparator" />

            <MenuFlyoutItem
                x:Name="ContextInspectSignatureMenuItem"
                x:Uid="Context_InspectSignature"
                Click="OnContextInspectSignatureClick"
                Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8D7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Name="ContextEditAnnotationMenuItem"
                x:Uid="Context_EditAnnotation"
                Click="OnContextEditAnnotationClick"
                Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Name="ContextCopyAnnotationMenuItem"
                x:Uid="Context_CopyAnnotation"
                Click="OnContextCopyAnnotationClick"
                Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Name="ContextCutAnnotationMenuItem"
                x:Uid="Context_CutAnnotation"
                Click="OnContextCutAnnotationClick"
                Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C6;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Name="ContextDeleteAnnotationMenuItem"
                x:Uid="Context_DeleteAnnotation"
                Click="OnContextDeleteAnnotationClick"
                Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Name="ContextAddTextBoxMenuItem"
                x:Uid="Context_AddTextBox"
                Click="OnContextAddTextBoxClick">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE90A;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Name="ContextPasteAnnotationMenuItem"
                x:Uid="Context_PasteAnnotation"
                Click="OnContextPasteAnnotationClick"
                Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE77F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Name="ContextUndoAnnotationMenuItem"
                x:Uid="Context_UndoAnnotation"
                Click="OnContextUndoAnnotationClick"
                KeyboardAcceleratorTextOverride="Ctrl+Z"
                Visibility="Collapsed">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7A7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutSeparator />

            <MenuFlyoutItem
                x:Uid="Context_PrevPage"
                Command="{x:Bind ViewModel.PreviousPageCommand}"
                KeyboardAcceleratorTextOverride="PgUp">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE76B;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Uid="Context_NextPage"
                Command="{x:Bind ViewModel.NextPageCommand}"
                KeyboardAcceleratorTextOverride="PgDn">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE76C;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutSeparator />

            <MenuFlyoutItem
                x:Uid="Context_FitPage"
                Click="OnFitPageClick"
                KeyboardAcceleratorTextOverride="Ctrl+0">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE9A6;" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <CompositeTransform TranslateY="1.5" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Uid="Context_FitWidth"
                Click="OnFitWidthClick"
                KeyboardAcceleratorTextOverride="Ctrl+2">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xF58A;" RenderTransformOrigin="0.5,0.5">
                        <FontIcon.RenderTransform>
                            <CompositeTransform ScaleX="1.02" ScaleY="1.02" TranslateY="1.5" />
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Uid="Context_RotateClockwise"
                Command="{x:Bind ViewModel.RotateClockwiseCommand}"
                KeyboardAcceleratorTextOverride="Ctrl+R">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7AD;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Uid="Context_RotateCounterClockwise"
                Command="{x:Bind ViewModel.RotateCounterClockwiseCommand}"
                KeyboardAcceleratorTextOverride="Ctrl+Shift+R">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7A7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <ToggleMenuFlyoutItem
                x:Uid="Context_NightMode"
                Command="{x:Bind ViewModel.ToggleNightModeCommand}"
                IsChecked="{x:Bind ViewModel.IsNightMode, Mode=OneWay}"
                KeyboardAcceleratorTextOverride="Ctrl+I"
                Loaded="OnNightModeMenuItemLoaded">
                <ToggleMenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE708;" />
                </ToggleMenuFlyoutItem.Icon>
            </ToggleMenuFlyoutItem>

            <MenuFlyoutSeparator />

            <MenuFlyoutItem
                x:Uid="Context_Presentation"
                Command="{x:Bind ViewModel.StartPresentationCommand}"
                KeyboardAcceleratorTextOverride="F5">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE786;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Uid="Context_FullScreen"
                Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                KeyboardAcceleratorTextOverride="F11">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE740;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutSeparator />

            <MenuFlyoutItem
                x:Uid="Context_Save"
                Command="{x:Bind ViewModel.SaveCommand}"
                KeyboardAcceleratorTextOverride="Ctrl+S">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74E;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Uid="Context_SaveAs"
                Command="{x:Bind ViewModel.SaveAsCommand}"
                KeyboardAcceleratorTextOverride="Ctrl+Shift+S">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE792;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Uid="Context_Print"
                Click="OnContextPrintClick"
                KeyboardAcceleratorTextOverride="Ctrl+P">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE749;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutItem
                x:Uid="Context_Properties"
                Command="{x:Bind ViewModel.ShowPropertiesCommand}"
                KeyboardAcceleratorTextOverride="Alt+Enter">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>

            <MenuFlyoutSeparator />

            <MenuFlyoutItem
                x:Uid="Context_CloseDocument"
                Command="{x:Bind ViewModel.CloseDocumentCommand}"
                KeyboardAcceleratorTextOverride="Ctrl+W">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE711;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <CommandBarFlyout
            x:Name="TouchEmptyHoldCommandBarFlyout"
            AlwaysExpanded="True"
            Placement="Top"
            Closed="OnTouchEmptyHoldFlyoutClosed">
            <CommandBarFlyout.PrimaryCommands>
                <AppBarButton
                    x:Name="TouchEmptyPasteButton"
                    IsCompact="False"
                    MinWidth="72"
                    Visibility="Collapsed"
                    Click="OnTouchEmptyPasteClick">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE77F;" FontSize="15" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBarFlyout.PrimaryCommands>
        </CommandBarFlyout>

        <Flyout
            x:Name="MouseSelectionFlyout"
            Placement="Top"
            ShouldConstrainToRootBounds="True"
            Closed="OnMouseSelectionFlyoutClosed">
            <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource AcrylicFlyoutPresenterStyle}">
                    <Setter Property="Padding" Value="6,4" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </Flyout.FlyoutPresenterStyle>
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        x:Name="MouseSelCopyButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnMouseSelectionCopyClick">
                        <FontIcon FontSize="15" Glyph="&#xE8C8;" />
                    </Button>
                    <Button
                        x:Name="MouseSelHighlightButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnMouseSelectionHighlightClick">
                        <FontIcon FontSize="15" Glyph="&#xE7E6;" />
                    </Button>
                    <Button
                        x:Name="MouseSelCommentButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnMouseSelectionCommentClick">
                        <FontIcon FontSize="15" Glyph="&#xE90A;" />
                    </Button>
                    <AppBarSeparator Margin="2,4" />
                    <Button
                        x:Name="MouseSelUnderlineButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        CornerRadius="4"
                        Tag="Underline"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnMouseSelectionMarkupSubtypeClick">
                        <FontIcon FontSize="15" Glyph="&#xE8DC;" />
                    </Button>
                    <Button
                        x:Name="MouseSelStrikeOutButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        CornerRadius="4"
                        Tag="StrikeOut"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnMouseSelectionMarkupSubtypeClick">
                        <FontIcon FontSize="15" Glyph="&#xEDE0;" />
                    </Button>
                    <Button
                        x:Name="MouseSelSquigglyButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        CornerRadius="4"
                        Tag="Squiggly"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnMouseSelectionMarkupSubtypeClick">
                        <PathIcon
                            Width="15"
                            Height="15"
                            Data="M 1.25,1.00 L 2.33,1.00 L 4.45,9.03 L 6.96,1.65 L 8.04,1.65 L 10.55,9.03 L 12.67,1.00 L 13.75,1.00 L 11.12,10.05 L 9.98,10.05 L 7.50,2.69 L 5.02,10.05 L 3.88,10.05 Z M 1.45,13.07 L 1.80,13.00 L 2.22,12.78 L 2.70,12.44 L 3.23,12.06 L 3.82,11.75 L 4.48,11.63 L 5.13,11.75 L 5.72,12.06 L 6.25,12.44 L 6.73,12.78 L 7.15,13.00 L 7.50,13.07 L 7.85,13.00 L 8.27,12.78 L 8.75,12.44 L 9.28,12.06 L 9.87,11.75 L 10.53,11.63 L 11.18,11.75 L 11.77,12.06 L 12.30,12.44 L 12.78,12.78 L 13.20,13.00 L 13.55,13.07 L 13.55,13.93 L 12.90,13.81 L 12.31,13.50 L 11.78,13.12 L 11.30,12.78 L 10.88,12.56 L 10.53,12.49 L 10.17,12.56 L 9.75,12.78 L 9.27,13.12 L 8.74,13.50 L 8.15,13.81 L 7.50,13.93 L 6.85,13.81 L 6.26,13.50 L 5.73,13.12 L 5.25,12.78 L 4.83,12.56 L 4.48,12.49 L 4.12,12.56 L 3.70,12.78 L 3.22,13.12 L 2.69,13.50 L 2.10,13.81 L 1.45,13.93 Z" />
                    </Button>
                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Padding="2,0,2,4">
                    <Button
                        x:Name="MouseSelColorYellowButton"
                        Width="20"
                        Height="20"
                        Padding="0"
                        CornerRadius="10"
                        Background="#FFFFE620"
                        BorderThickness="1"
                        Tag="Yellow"
                        Click="OnMouseSelectionColorClick" />
                    <Button
                        x:Name="MouseSelColorGreenButton"
                        Width="20"
                        Height="20"
                        Padding="0"
                        CornerRadius="10"
                        Background="#FF64DC78"
                        BorderThickness="1"
                        Tag="Green"
                        Click="OnMouseSelectionColorClick" />
                    <Button
                        x:Name="MouseSelColorBlueButton"
                        Width="20"
                        Height="20"
                        Padding="0"
                        CornerRadius="10"
                        Background="#FF5AB4FF"
                        BorderThickness="1"
                        Tag="Blue"
                        Click="OnMouseSelectionColorClick" />
                    <Button
                        x:Name="MouseSelColorPinkButton"
                        Width="20"
                        Height="20"
                        Padding="0"
                        CornerRadius="10"
                        Background="#FFFF80B4"
                        BorderThickness="1"
                        Tag="Pink"
                        Click="OnMouseSelectionColorClick" />
                    <Button
                        x:Name="MouseSelColorOrangeButton"
                        Width="20"
                        Height="20"
                        Padding="0"
                        CornerRadius="10"
                        Background="#FFFFA53C"
                        BorderThickness="1"
                        Tag="Orange"
                        Click="OnMouseSelectionColorClick" />
                    <Button
                        x:Name="MouseSelColorRedButton"
                        Width="20"
                        Height="20"
                        Padding="0"
                        CornerRadius="10"
                        Background="#FFF24C4C"
                        BorderThickness="1"
                        Tag="Red"
                        Click="OnMouseSelectionColorClick" />
                    <Button
                        x:Name="MouseSelColorBlackButton"
                        Width="20"
                        Height="20"
                        Padding="0"
                        CornerRadius="10"
                        Background="#FF141414"
                        BorderThickness="1"
                        Tag="Black"
                        Click="OnMouseSelectionColorClick" />
                </StackPanel>
            </StackPanel>
        </Flyout>

        <Flyout
            x:Name="AnnotationQuickBarFlyout"
            Placement="Top"
            ShouldConstrainToRootBounds="True"
            Closed="OnAnnotationQuickBarFlyoutClosed">
            <Flyout.FlyoutPresenterStyle>
                <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource AcrylicFlyoutPresenterStyle}">
                    <Setter Property="Padding" Value="6,4" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </Flyout.FlyoutPresenterStyle>
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button
                        x:Name="QuickBarAddCommentButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnQuickBarAddCommentClick">
                        <FontIcon FontSize="15" Glyph="&#xE90A;" />
                    </Button>
                    <Button
                        x:Name="QuickBarColorButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnQuickBarColorToggleClick">
                        <FontIcon FontSize="15" Glyph="&#xE790;" />
                    </Button>
                    <Button
                        x:Name="QuickBarCopyButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnQuickBarCopyClick">
                        <FontIcon FontSize="15" Glyph="&#xE8C8;" />
                    </Button>
                    <Button
                        x:Name="QuickBarCutButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnQuickBarCutClick">
                        <FontIcon FontSize="15" Glyph="&#xE8C6;" />
                    </Button>
                    <Button
                        x:Name="QuickBarDeleteButton"
                        Width="34"
                        Height="34"
                        Padding="0"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnQuickBarDeleteClick">
                        <FontIcon FontSize="15" Glyph="&#xE74D;" />
                    </Button>
                    <AppBarSeparator Margin="2,4" />
                    <Button
                        x:Name="QuickBarCloseButton"
                        Width="32"
                        Height="34"
                        Padding="0"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnQuickBarCloseClick">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>

                <StackPanel
                    x:Name="QuickBarColorRow"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Padding="2,2,2,4"
                    Visibility="Collapsed">
                    <Button
                        x:Name="QuickColorYellowButton"
                        Width="22"
                        Height="22"
                        Padding="0"
                        CornerRadius="11"
                        Background="#FFFFE620"
                        BorderThickness="1"
                        Tag="Yellow"
                        Click="OnQuickBarColorSelectClick" />
                    <Button
                        x:Name="QuickColorGreenButton"
                        Width="22"
                        Height="22"
                        Padding="0"
                        CornerRadius="11"
                        Background="#FF64DC78"
                        BorderThickness="1"
                        Tag="Green"
                        Click="OnQuickBarColorSelectClick" />
                    <Button
                        x:Name="QuickColorBlueButton"
                        Width="22"
                        Height="22"
                        Padding="0"
                        CornerRadius="11"
                        Background="#FF5AB4FF"
                        BorderThickness="1"
                        Tag="Blue"
                        Click="OnQuickBarColorSelectClick" />
                    <Button
                        x:Name="QuickColorPinkButton"
                        Width="22"
                        Height="22"
                        Padding="0"
                        CornerRadius="11"
                        Background="#FFFF80B4"
                        BorderThickness="1"
                        Tag="Pink"
                        Click="OnQuickBarColorSelectClick" />
                    <Button
                        x:Name="QuickColorOrangeButton"
                        Width="22"
                        Height="22"
                        Padding="0"
                        CornerRadius="11"
                        Background="#FFFFA53C"
                        BorderThickness="1"
                        Tag="Orange"
                        Click="OnQuickBarColorSelectClick" />
                    <Button
                        x:Name="QuickColorRedButton"
                        Width="22"
                        Height="22"
                        Padding="0"
                        CornerRadius="11"
                        Background="#FFF24C4C"
                        BorderThickness="1"
                        Tag="Red"
                        Click="OnQuickBarColorSelectClick" />
                    <Button
                        x:Name="QuickColorBlackButton"
                        Width="22"
                        Height="22"
                        Padding="0"
                        CornerRadius="11"
                        Background="#FF141414"
                        BorderThickness="1"
                        Tag="Black"
                        Click="OnQuickBarColorSelectClick" />
                </StackPanel>
            </StackPanel>
        </Flyout>

        <Flyout
            x:Name="AnnotationEditorFlyout"
            Placement="BottomEdgeAlignedLeft"
            ShouldConstrainToRootBounds="True"
            FlyoutPresenterStyle="{StaticResource AcrylicFlyoutPresenterStyle}"
            Closed="OnAnnotationEditorFlyoutClosed">
            <StackPanel Width="340" Spacing="8">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="AnnotationEditorTitleText"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="AnnotationEditorMetaText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <Button
                        x:Name="AnnotationEditorCopyButton"
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnAnnotationEditorCopyClick"
                        Visibility="Collapsed">
                        <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                    </Button>
                    <Button
                        x:Name="AnnotationEditorCutButton"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Padding="0"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnAnnotationEditorCutClick"
                        Visibility="Collapsed">
                        <FontIcon FontSize="13" Glyph="&#xE8C6;" />
                    </Button>
                    <Button
                        x:Name="AnnotationEditorCloseButton"
                        Grid.Column="3"
                        Width="28"
                        Height="28"
                        Padding="0"
                        CornerRadius="4"
                        Style="{StaticResource SubtleButtonStyle}"
                        Click="OnAnnotationEditorCloseClick">
                        <FontIcon FontSize="11" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <Border
                    x:Name="AnnotationEditorQuoteBorder"
                    Padding="8,5"
                    CornerRadius="4"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="AnnotationEditorQuoteText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        TextWrapping="Wrap"
                        TextTrimming="CharacterEllipsis" />
                </Border>

                <TextBox
                    x:Name="AnnotationEditorTextBox"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    MinHeight="68"
                    MaxHeight="150" />

                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                    <Button
                        x:Name="AnnotationEditorDeleteButton"
                        Click="OnAnnotationEditorDeleteClick"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="AnnotationEditorSaveButton"
                        Grid.Column="1"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnAnnotationEditorSaveClick" />
                    <StackPanel
                        x:Name="AnnotationEditorColorRow"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <Button
                            x:Name="AnnotColorYellowButton"
                            Width="20"
                            Height="20"
                            Padding="0"
                            CornerRadius="10"
                            Background="#FFFFE620"
                            BorderThickness="2"
                            Tag="Yellow"
                            Click="OnAnnotationColorSwatchClick" />
                        <Button
                            x:Name="AnnotColorGreenButton"
                            Width="20"
                            Height="20"
                            Padding="0"
                            CornerRadius="10"
                            Background="#FF64DC78"
                            BorderThickness="2"
                            Tag="Green"
                            Click="OnAnnotationColorSwatchClick" />
                        <Button
                            x:Name="AnnotColorBlueButton"
                            Width="20"
                            Height="20"
                            Padding="0"
                            CornerRadius="10"
                            Background="#FF5AB4FF"
                            BorderThickness="2"
                            Tag="Blue"
                            Click="OnAnnotationColorSwatchClick" />
                        <Button
                            x:Name="AnnotColorPinkButton"
                            Width="20"
                            Height="20"
                            Padding="0"
                            CornerRadius="10"
                            Background="#FFFF80B4"
                            BorderThickness="2"
                            Tag="Pink"
                            Click="OnAnnotationColorSwatchClick" />
                        <Button
                            x:Name="AnnotColorOrangeButton"
                            Width="20"
                            Height="20"
                            Padding="0"
                            CornerRadius="10"
                            Background="#FFFFA53C"
                            BorderThickness="2"
                            Tag="Orange"
                            Click="OnAnnotationColorSwatchClick" />
                        <Button
                            x:Name="AnnotColorRedButton"
                            Width="20"
                            Height="20"
                            Padding="0"
                            CornerRadius="10"
                            Background="#FFF24C4C"
                            BorderThickness="2"
                            Tag="Red"
                            Click="OnAnnotationColorSwatchClick" />
                        <Button
                            x:Name="AnnotColorBlackButton"
                            Width="20"
                            Height="20"
                            Padding="0"
                            CornerRadius="10"
                            Background="#FF141414"
                            BorderThickness="2"
                            Tag="Black"
                            Click="OnAnnotationColorSwatchClick" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Flyout>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAcceleratorInvoked" />
    </Page.KeyboardAccelerators>

    <Grid
        Background="Transparent"
        AllowDrop="True"
        DragOver="OnDocumentDragOver"
        Drop="OnDocumentDrop"
        PointerMoved="OnDocumentPointerMoved">
        <!-- Empty state when no document is open -->
        <StackPanel
            x:Name="EmptyStatePanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5"
            Spacing="12"
            Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.HasDocument), Mode=OneWay}">
            <StackPanel.RenderTransform>
                <CompositeTransform x:Name="EmptyStateTransform" />
            </StackPanel.RenderTransform>
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="56"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Glyph="&#xE8A5;" />
            <TextBlock
                x:Uid="EmptyStateTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Uid="EmptyStateSubtitle"
                MaxWidth="360"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Uid="EmptyStateOpenButton"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.OpenFileCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                        <TextBlock x:Uid="EmptyStateOpenButtonText" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>

        <!-- Standard non-intrusive notification at the top of the screen (e.g. Last document not found - 5s) -->
        <Border
            x:Name="TopNotificationContainer"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            MaxWidth="600"
            Margin="0,24,0,0"
            Canvas.ZIndex="110"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BackgroundSizing="InnerBorderEdge"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Translation="0,0,32"
            Visibility="Collapsed">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <InfoBar
                x:Name="TopNotificationInfoBar"
                Severity="Informational"
                IsOpen="False"
                IsIconVisible="False"
                IsClosable="True"
                Background="Transparent"
                BorderThickness="0"
                CloseButtonClick="OnTopNotificationInfoBarCloseButtonClick">
                <InfoBar.Resources>
                    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="InfoBarBackgroundFillColorDefaultBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="InfoBarBorderBrush" Color="Transparent" />
                    <Thickness x:Key="InfoBarBorderThickness">0</Thickness>
                </InfoBar.Resources>
            </InfoBar>
        </Border>

        <!-- Document display area -->
        <Grid
            x:Name="DocumentAreaGrid"
            Background="Transparent"
            RenderTransformOrigin="0.5,0.5"
            Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.HasDocument), Mode=OneWay}"
            RowDefinitions="*,Auto">
            <Grid.RenderTransform>
                <CompositeTransform x:Name="DocumentAreaTransform" />
            </Grid.RenderTransform>

            <!-- Row 0: Unified document viewer (Continuous and Paged) -->
            <Grid
                x:Name="ScrollViewerContentRoot"
                Grid.Row="0"
                Background="Transparent"
                ContextRequested="OnScrollViewerContentRootContextRequested">
                <FlyoutBase.AttachedFlyout>
                    <CommandBarFlyout
                        x:Name="TouchSelectionCommandBarFlyout"
                        AlwaysExpanded="False"
                        Placement="Top"
                        Closed="OnTouchSelectionFlyoutClosed">
                        <CommandBarFlyout.PrimaryCommands>
                            <AppBarButton
                                x:Name="TouchSelectionCopyButton"
                                Width="40"
                                Height="36"
                                Click="OnTouchSelectionCopyButtonClick">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE8C8;" FontSize="15" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                x:Name="TouchSelectionHighlightButton"
                                Width="40"
                                Height="36"
                                Click="OnTouchSelectionHighlightButtonClick">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE7E6;" FontSize="15" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                x:Name="TouchSelectionCommentButton"
                                Width="40"
                                Height="36"
                                Click="OnTouchSelectionCommentButtonClick">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE90A;" FontSize="15" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                x:Name="TouchSelectionPasteButton"
                                Width="40"
                                Height="36"
                                Visibility="Collapsed"
                                Click="OnTouchSelectionPasteButtonClick">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE77F;" FontSize="15" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBarFlyout.PrimaryCommands>
                        <CommandBarFlyout.SecondaryCommands>
                            <AppBarButton
                                x:Name="TouchSelectionUnderlineButton"
                                Tag="Underline"
                                Click="OnTouchSelectionSubtypeClick">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE8DC;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                x:Name="TouchSelectionStrikeOutButton"
                                Tag="StrikeOut"
                                Click="OnTouchSelectionSubtypeClick">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xEDE0;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                x:Name="TouchSelectionSquigglyButton"
                                Tag="Squiggly"
                                Click="OnTouchSelectionSubtypeClick">
                                <AppBarButton.Icon>
                                    <PathIcon Data="M 1.25,1.00 L 2.33,1.00 L 4.45,9.03 L 6.96,1.65 L 8.04,1.65 L 10.55,9.03 L 12.67,1.00 L 13.75,1.00 L 11.12,10.05 L 9.98,10.05 L 7.50,2.69 L 5.02,10.05 L 3.88,10.05 Z M 1.45,13.07 L 1.80,13.00 L 2.22,12.78 L 2.70,12.44 L 3.23,12.06 L 3.82,11.75 L 4.48,11.63 L 5.13,11.75 L 5.72,12.06 L 6.25,12.44 L 6.73,12.78 L 7.15,13.00 L 7.50,13.07 L 7.85,13.00 L 8.27,12.78 L 8.75,12.44 L 9.28,12.06 L 9.87,11.75 L 10.53,11.63 L 11.18,11.75 L 11.77,12.06 L 12.30,12.44 L 12.78,12.78 L 13.20,13.00 L 13.55,13.07 L 13.55,13.93 L 12.90,13.81 L 12.31,13.50 L 11.78,13.12 L 11.30,12.78 L 10.88,12.56 L 10.53,12.49 L 10.17,12.56 L 9.75,12.78 L 9.27,13.12 L 8.74,13.50 L 8.15,13.81 L 7.50,13.93 L 6.85,13.81 L 6.26,13.50 L 5.73,13.12 L 5.25,12.78 L 4.83,12.56 L 4.48,12.49 L 4.12,12.56 L 3.70,12.78 L 3.22,13.12 L 2.69,13.50 L 2.10,13.81 L 1.45,13.93 Z" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator />
                            <AppBarButton
                                x:Name="TouchSelectionColorYellowButton"
                                Tag="Yellow"
                                Click="OnTouchSelectionColorClick" />
                            <AppBarButton
                                x:Name="TouchSelectionColorGreenButton"
                                Tag="Green"
                                Click="OnTouchSelectionColorClick" />
                            <AppBarButton
                                x:Name="TouchSelectionColorBlueButton"
                                Tag="Blue"
                                Click="OnTouchSelectionColorClick" />
                            <AppBarButton
                                x:Name="TouchSelectionColorPinkButton"
                                Tag="Pink"
                                Click="OnTouchSelectionColorClick" />
                            <AppBarButton
                                x:Name="TouchSelectionColorOrangeButton"
                                Tag="Orange"
                                Click="OnTouchSelectionColorClick" />
                            <AppBarButton
                                x:Name="TouchSelectionColorRedButton"
                                Tag="Red"
                                Click="OnTouchSelectionColorClick" />
                            <AppBarButton
                                x:Name="TouchSelectionColorBlackButton"
                                Tag="Black"
                                Click="OnTouchSelectionColorClick" />
                        </CommandBarFlyout.SecondaryCommands>
                    </CommandBarFlyout>
                </FlyoutBase.AttachedFlyout>

                <Border
                    Background="Black"
                    IsHitTestVisible="False"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsPresentationMode), Mode=OneWay}" />

                <!-- Hidden staging canvas for PrintDocument WriteableBitmap surface realization -->
                <Canvas
                    x:Name="PrintStagingCanvas"
                    Width="0"
                    Height="0"
                    IsHitTestVisible="False"
                    Opacity="0" />

                <ScrollViewer
                    x:Name="ContinuousScrollViewer"
                    IsTabStop="True"
                    UseSystemFocusVisuals="False"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollMode="Enabled"
                    MaxZoomFactor="8.0"
                    MinZoomFactor="0.25"
                    VerticalScrollBarVisibility="Visible"
                    ViewChanging="OnScrollViewerViewChanging"
                    ViewChanged="OnScrollViewerViewChanged"
                    ZoomMode="Enabled">
                    <Grid
                        x:Name="ScrollViewerInnerGrid"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <ItemsRepeater
                            x:Name="ContinuousPagesRepeater"
                            Margin="{x:Bind converters:UiHelpers.RepeaterMargin(ViewModel.IsPresentationMode, ViewModel.CurrentDocument.IsContinuous), Mode=OneWay}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5"
                            ItemsSource="{x:Bind ViewModel.CurrentDocument.DisplayedRows, Mode=OneWay}">
                            <ItemsRepeater.RenderTransform>
                                <CompositeTransform x:Name="PagesRepeaterPushTransform" />
                            </ItemsRepeater.RenderTransform>
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:PdfPageRow">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <!-- Left page (or single page) -->
                                        <Border
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="{x:Bind converters:UiHelpers.PresentationBorderThickness(IsPresentationMode), Mode=OneWay}"
                                            CornerRadius="{x:Bind converters:UiHelpers.PresentationCornerRadius(IsPresentationMode), Mode=OneWay}">
                                            <controls:PdfPageCanvas
                                                PageInfo="{x:Bind LeftPage, Mode=OneWay}"
                                                IsNightMode="{x:Bind IsNightMode, Mode=OneWay}"
                                                RotationAngle="{x:Bind Rotation, Mode=OneWay}" />
                                        </Border>

                                        <!-- Right page (when double page) -->
                                        <Border
                                            Visibility="{x:Bind converters:UiHelpers.VisibleIf(HasRightPage), Mode=OneWay}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="{x:Bind converters:UiHelpers.PresentationBorderThickness(IsPresentationMode), Mode=OneWay}"
                                            CornerRadius="{x:Bind converters:UiHelpers.PresentationCornerRadius(IsPresentationMode), Mode=OneWay}">
                                            <controls:PdfPageCanvas
                                                Visibility="{x:Bind converters:UiHelpers.VisibleIf(HasRightPage), Mode=OneWay}"
                                                PageInfo="{x:Bind RightPage, Mode=OneWay}"
                                                IsNightMode="{x:Bind IsNightMode, Mode=OneWay}"
                                                RotationAngle="{x:Bind Rotation, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Zero-measure centered overlay hosting the incoming adjacent slide during interactive touch/touchpad horizontal swipe -->
                        <Canvas
                            x:Name="AdjacentSlideOverlayCanvas"
                            Width="0"
                            Height="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <StackPanel
                                x:Name="AdjacentSlidePreviewContainer"
                                Orientation="Horizontal"
                                Spacing="16"
                                RenderTransformOrigin="0.5,0.5"
                                IsHitTestVisible="False">
                                <StackPanel.RenderTransform>
                                    <CompositeTransform x:Name="AdjacentSlideTransform" />
                                </StackPanel.RenderTransform>
                                <Border
                                    x:Name="AdjacentLeftPageBorder"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="{x:Bind converters:UiHelpers.PresentationBorderThickness(ViewModel.IsPresentationMode), Mode=OneWay}"
                                    CornerRadius="{x:Bind converters:UiHelpers.PresentationCornerRadius(ViewModel.IsPresentationMode), Mode=OneWay}">
                                    <controls:PdfPageCanvas
                                        x:Name="AdjacentLeftPageCanvas"
                                        IsSwipePreview="True" />
                                </Border>
                                <Border
                                    x:Name="AdjacentRightPageBorder"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="{x:Bind converters:UiHelpers.PresentationBorderThickness(ViewModel.IsPresentationMode), Mode=OneWay}"
                                    CornerRadius="{x:Bind converters:UiHelpers.PresentationCornerRadius(ViewModel.IsPresentationMode), Mode=OneWay}">
                                    <controls:PdfPageCanvas
                                        x:Name="AdjacentRightPageCanvas"
                                        IsSwipePreview="True"
                                        Visibility="Collapsed" />
                                </Border>
                            </StackPanel>
                        </Canvas>
                    </Grid>
                </ScrollViewer>

                <!-- Edge-style Touch Selection Handles (left/start and right/end markers below selected text) -->
                <Canvas
                    x:Name="TouchSelectionHandlesCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Canvas.ZIndex="95"
                    Translation="0,0,28"
                    Visibility="Collapsed">
                    <!-- Left / Start Selection Handle -->
                    <Grid
                        x:Name="TouchSelectionStartHandle"
                        Width="34"
                        Padding="0,0,0,14"
                        Background="Transparent"
                        ManipulationMode="None"
                        PointerPressed="OnTouchSelectionStartHandlePointerPressed"
                        PointerMoved="OnTouchSelectionHandlePointerMoved"
                        PointerReleased="OnTouchSelectionHandlePointerReleased"
                        PointerCanceled="OnTouchSelectionHandlePointerCanceled"
                        PointerCaptureLost="OnTouchSelectionHandlePointerCaptureLost">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="TouchSelectionStartStem"
                            Grid.Row="0"
                            Width="2"
                            Height="18"
                            Margin="30,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="1"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="TouchSelectionStartKnob"
                            Grid.Row="1"
                            Width="16"
                            Height="16"
                            Margin="16,-1,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderBrush="#E0FFFFFF"
                            BorderThickness="1.5"
                            CornerRadius="8,2,8,8"
                            IsHitTestVisible="False" />
                    </Grid>

                    <!-- Right / End Selection Handle -->
                    <Grid
                        x:Name="TouchSelectionEndHandle"
                        Width="34"
                        Padding="0,0,0,14"
                        Background="Transparent"
                        ManipulationMode="None"
                        PointerPressed="OnTouchSelectionEndHandlePointerPressed"
                        PointerMoved="OnTouchSelectionHandlePointerMoved"
                        PointerReleased="OnTouchSelectionHandlePointerReleased"
                        PointerCanceled="OnTouchSelectionHandlePointerCanceled"
                        PointerCaptureLost="OnTouchSelectionHandlePointerCaptureLost">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="TouchSelectionEndStem"
                            Grid.Row="0"
                            Width="2"
                            Height="18"
                            Margin="2,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="1"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="TouchSelectionEndKnob"
                            Grid.Row="1"
                            Width="16"
                            Height="16"
                            Margin="2,-1,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderBrush="#E0FFFFFF"
                            BorderThickness="1.5"
                            CornerRadius="2,8,8,8"
                            IsHitTestVisible="False" />
                    </Grid>
                </Canvas>

                <!-- Dedicated Shape Drawing Overlay (above ScrollViewer with ManipulationMode="None" so DirectManipulation never steals touch drags) -->
                <Grid
                    x:Name="TouchShapeDrawOverlay"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Canvas.ZIndex="88"
                    ManipulationMode="None"
                    IsHoldingEnabled="False"
                    IsRightTapEnabled="False"
                    Visibility="Collapsed"
                    PointerEntered="OnShapeOverlayPointerEntered"
                    PointerExited="OnShapeOverlayPointerExited"
                    PointerPressed="OnShapeOverlayPointerPressed"
                    PointerMoved="OnShapeOverlayPointerMoved"
                    PointerReleased="OnShapeOverlayPointerReleased"
                    PointerCanceled="OnShapeOverlayPointerCanceled"
                    PointerCaptureLost="OnShapeOverlayPointerCaptureLost" />

                <!-- Dedicated Pen/Ink & Eraser Overlay (above ScrollViewer with ManipulationMode="None" for pressure-sensitive S Pen, hover cursor, palm rejection, and hand pan/zoom) -->
                <Grid
                    x:Name="TouchInkDrawOverlay"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Canvas.ZIndex="88"
                    ManipulationMode="None"
                    IsHoldingEnabled="False"
                    IsRightTapEnabled="False"
                    Visibility="Collapsed"
                    PointerEntered="OnInkOverlayPointerEntered"
                    PointerExited="OnInkOverlayPointerExited"
                    PointerPressed="OnInkOverlayPointerPressed"
                    PointerMoved="OnInkOverlayPointerMoved"
                    PointerReleased="OnInkOverlayPointerReleased"
                    PointerCanceled="OnInkOverlayPointerCanceled"
                    PointerCaptureLost="OnInkOverlayPointerCaptureLost" />

                <!-- Touch Selected Annotation Overlay (Move body + Corner Resize handles + Non-modal QuickBar above ScrollViewer so DirectManipulation never steals touch drags) -->
                <Canvas
                    x:Name="TouchAnnotationResizeHandlesCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Canvas.ZIndex="96"
                    Visibility="Collapsed">
                    <Border
                        x:Name="TouchAnnotationMoveBodyHandle"
                        Background="Transparent"
                        ManipulationMode="None"
                        Visibility="Collapsed"
                        PointerPressed="OnTouchMoveHandlePointerPressed"
                        PointerMoved="OnTouchMoveHandlePointerMoved"
                        PointerReleased="OnTouchMoveHandlePointerReleased"
                        PointerCanceled="OnTouchMoveHandlePointerCanceled"
                        PointerCaptureLost="OnTouchMoveHandlePointerCaptureLost" />
                    <Border
                        x:Name="TouchResizeTopLeftHandle"
                        Tag="0"
                        Width="40"
                        Height="40"
                        Background="Transparent"
                        ManipulationMode="None"
                        PointerPressed="OnTouchResizeHandlePointerPressed"
                        PointerMoved="OnTouchResizeHandlePointerMoved"
                        PointerReleased="OnTouchResizeHandlePointerReleased"
                        PointerCanceled="OnTouchResizeHandlePointerCanceled"
                        PointerCaptureLost="OnTouchResizeHandlePointerCaptureLost" />
                    <Border
                        x:Name="TouchResizeTopRightHandle"
                        Tag="1"
                        Width="40"
                        Height="40"
                        Background="Transparent"
                        ManipulationMode="None"
                        PointerPressed="OnTouchResizeHandlePointerPressed"
                        PointerMoved="OnTouchResizeHandlePointerMoved"
                        PointerReleased="OnTouchResizeHandlePointerReleased"
                        PointerCanceled="OnTouchResizeHandlePointerCanceled"
                        PointerCaptureLost="OnTouchResizeHandlePointerCaptureLost" />
                    <Border
                        x:Name="TouchResizeBottomLeftHandle"
                        Tag="2"
                        Width="40"
                        Height="40"
                        Background="Transparent"
                        ManipulationMode="None"
                        PointerPressed="OnTouchResizeHandlePointerPressed"
                        PointerMoved="OnTouchResizeHandlePointerMoved"
                        PointerReleased="OnTouchResizeHandlePointerReleased"
                        PointerCanceled="OnTouchResizeHandlePointerCanceled"
                        PointerCaptureLost="OnTouchResizeHandlePointerCaptureLost" />
                    <Border
                        x:Name="TouchResizeBottomRightHandle"
                        Tag="3"
                        Width="40"
                        Height="40"
                        Background="Transparent"
                        ManipulationMode="None"
                        PointerPressed="OnTouchResizeHandlePointerPressed"
                        PointerMoved="OnTouchResizeHandlePointerMoved"
                        PointerReleased="OnTouchResizeHandlePointerReleased"
                        PointerCanceled="OnTouchResizeHandlePointerCanceled"
                        PointerCaptureLost="OnTouchResizeHandlePointerCaptureLost" />
                    <Border
                        x:Name="TouchAnnotationQuickBarBorder"
                        Padding="6,4"
                        CornerRadius="8"
                        BorderThickness="1"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BackgroundSizing="InnerBorderEdge"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        ManipulationMode="None"
                        Translation="0,0,32"
                        Visibility="Collapsed">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <StackPanel Spacing="6">
