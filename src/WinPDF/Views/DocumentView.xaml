                                    <FontIcon FontSize="15" Glyph="&#xE90A;" />
                                </Button>
                                <Button
                                    x:Name="TouchQuickBarColorButton"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="4"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OnQuickBarColorToggleClick">
                                    <FontIcon FontSize="15" Glyph="&#xE790;" />
                                </Button>
                                <Button
                                    x:Name="TouchQuickBarCopyButton"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="4"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OnQuickBarCopyClick">
                                    <FontIcon FontSize="15" Glyph="&#xE8C8;" />
                                </Button>
                                <Button
                                    x:Name="TouchQuickBarCutButton"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="4"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OnQuickBarCutClick">
                                    <FontIcon FontSize="15" Glyph="&#xE8C6;" />
                                </Button>
                                <Button
                                    x:Name="TouchQuickBarDeleteButton"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="4"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OnQuickBarDeleteClick">
                                    <FontIcon FontSize="15" Glyph="&#xE74D;" />
                                </Button>
                                <AppBarSeparator Margin="2,4" />
                                <Button
                                    x:Name="TouchQuickBarCloseButton"
                                    Width="34"
                                    Height="36"
                                    Padding="0"
                                    CornerRadius="4"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OnQuickBarCloseClick">
                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>

                            <StackPanel
                                x:Name="TouchQuickBarColorRow"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Padding="2,2,2,4"
                                Visibility="Collapsed">
                                <Button
                                    x:Name="TouchQuickColorYellowButton"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    CornerRadius="12"
                                    Background="#FFFFE620"
                                    BorderThickness="1"
                                    Tag="Yellow"
                                    Click="OnQuickBarColorSelectClick" />
                                <Button
                                    x:Name="TouchQuickColorGreenButton"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    CornerRadius="12"
                                    Background="#FF64DC78"
                                    BorderThickness="1"
                                    Tag="Green"
                                    Click="OnQuickBarColorSelectClick" />
                                <Button
                                    x:Name="TouchQuickColorBlueButton"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    CornerRadius="12"
                                    Background="#FF5AB4FF"
                                    BorderThickness="1"
                                    Tag="Blue"
                                    Click="OnQuickBarColorSelectClick" />
                                <Button
                                    x:Name="TouchQuickColorPinkButton"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    CornerRadius="12"
                                    Background="#FFFF80B4"
                                    BorderThickness="1"
                                    Tag="Pink"
                                    Click="OnQuickBarColorSelectClick" />
                                <Button
                                    x:Name="TouchQuickColorOrangeButton"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    CornerRadius="12"
                                    Background="#FFFFA53C"
                                    BorderThickness="1"
                                    Tag="Orange"
                                    Click="OnQuickBarColorSelectClick" />
                                <Button
                                    x:Name="TouchQuickColorRedButton"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    CornerRadius="12"
                                    Background="#FFF24C4C"
                                    BorderThickness="1"
                                    Tag="Red"
                                    Click="OnQuickBarColorSelectClick" />
                                <Button
                                    x:Name="TouchQuickColorBlackButton"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    CornerRadius="12"
                                    Background="#FF141414"
                                    BorderThickness="1"
                                    Tag="Black"
                                    Click="OnQuickBarColorSelectClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Canvas>

                <!-- Inline direct-on-page text editor + coupled Acrylic formatting mini-bar -->
                <Grid
                    x:Name="InlineTextEditorOverlay"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Canvas.ZIndex="98"
                    Visibility="Collapsed">
                    <Border
                        x:Name="InlineTextEditorBackdrop"
                        Background="Transparent"
                        PointerPressed="OnInlineTextEditorBackdropPointerPressed" />
                    <Canvas x:Name="InlineTextEditorCanvas">
                        <Grid x:Name="InlineTextEditorBoxContainer">
                            <Border
                                x:Name="InlineTextEditorMaskBorder"
                                Margin="-2,-1,-2,-1"
                                Background="Transparent"
                                CornerRadius="3"
                                IsHitTestVisible="False" />
                            <Rectangle
                                Margin="-2,-1,-2,-1"
                                Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                StrokeThickness="1.25"
                                StrokeDashArray="4,3"
                                RadiusX="3"
                                RadiusY="3"
                                IsHitTestVisible="False" />
                            <RichEditBox
                                x:Name="InlineTextEditorTextBox"
                                TextWrapping="Wrap"
                                FontFamily="Arial"
                                FontStretch="Normal"
                                IsTextScaleFactorEnabled="False"
                                IsSpellCheckEnabled="False"
                                IsColorFontEnabled="False"
                                ClipboardCopyFormat="PlainText"
                                MinWidth="24"
                                MinHeight="18"
                                Padding="0"
                                RequestedTheme="Light"
                                Background="#FFFFFFFF"
                                BorderThickness="0"
                                PreviewKeyDown="OnInlineTextEditorPreviewKeyDown"
                                TextChanged="OnInlineTextEditorTextChanged"
                                SizeChanged="OnInlineTextEditorBoxSizeChanged"
                                Paste="OnInlineTextEditorPaste">
                                <RichEditBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFFFF" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFFFF" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlForeground" Color="#FF141414" />
                                    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FF141414" />
                                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF141414" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#80666666" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#80666666" />
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#80666666" />
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    <Thickness x:Key="TextControlThemePadding">0</Thickness>
                                    <x:Double x:Key="TextControlThemeMinHeight">18</x:Double>
                                    <x:Double x:Key="TextControlThemeMinWidth">24</x:Double>
                                </RichEditBox.Resources>
                            </RichEditBox>
                        </Grid>

                        <Border
                            x:Name="InlineTextFormatBar"
                            Padding="6,4"
                            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                            BackgroundSizing="InnerBorderEdge"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Translation="0,0,32"
                            SizeChanged="OnInlineTextFormatBarSizeChanged">
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <DropDownButton
                                    x:Name="InlineTextSizeButton"
                                    Height="30"
                                    MinWidth="52"
                                    Padding="8,0,6,0"
                                    IsTabStop="False">
                                    <DropDownButton.Content>
                                        <TextBlock
                                            x:Name="InlineTextSizeLabel"
                                            FontSize="12"
                                            VerticalAlignment="Center" />
                                    </DropDownButton.Content>
                                    <DropDownButton.Flyout>
                                        <MenuFlyout
                                            x:Name="InlineTextSizeMenuFlyout"
                                            Placement="Bottom"
                                            Opening="OnInlineTextSizeFlyoutOpening" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>

                                <Border
                                    Width="1"
                                    Height="18"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <ToggleButton
                                    x:Name="InlineTextBoldToggle"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    CornerRadius="4"
                                    IsTabStop="False"
                                    Click="OnInlineTextBoldClick">
                                    <FontIcon FontSize="14" Glyph="&#xE8DD;" />
                                </ToggleButton>

                                <ToggleButton
                                    x:Name="InlineTextItalicToggle"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    CornerRadius="4"
                                    IsTabStop="False"
                                    Click="OnInlineTextItalicClick">
                                    <FontIcon FontSize="14" Glyph="&#xE8DB;" />
                                </ToggleButton>

                                <ToggleButton
                                    x:Name="InlineTextUnderlineToggle"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    CornerRadius="4"
                                    IsTabStop="False"
                                    Click="OnInlineTextUnderlineClick">
                                    <FontIcon FontSize="14" Glyph="&#xE8DC;" />
                                </ToggleButton>

                                <Border
                                    Width="1"
                                    Height="18"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Button
                                    x:Name="InlineTextColorButton"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    CornerRadius="4"
                                    IsTabStop="False"
                                    Style="{StaticResource SubtleButtonStyle}">
                                    <Ellipse
                                        x:Name="InlineTextColorDot"
                                        Width="14"
                                        Height="14"
                                        Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                        StrokeThickness="1"
                                        Fill="#FF141414" />
                                    <Button.Flyout>
                                        <Flyout
                                            x:Name="InlineTextColorFlyout"
                                            Placement="Bottom"
                                            FlyoutPresenterStyle="{StaticResource AcrylicFlyoutPresenterStyle}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Padding="2">
                                                <Button
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    CornerRadius="11"
                                                    Background="#FF141414"
                                                    BorderThickness="1"
                                                    Tag="20,20,20"
                                                    Click="OnInlineTextColorSwatchClick" />
                                                <Button
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    CornerRadius="11"
                                                    Background="#FF595959"
                                                    BorderThickness="1"
                                                    Tag="89,89,89"
                                                    Click="OnInlineTextColorSwatchClick" />
                                                <Button
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    CornerRadius="11"
                                                    Background="#FFD93025"
                                                    BorderThickness="1"
                                                    Tag="217,48,37"
                                                    Click="OnInlineTextColorSwatchClick" />
                                                <Button
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    CornerRadius="11"
                                                    Background="#FF1A73E8"
                                                    BorderThickness="1"
                                                    Tag="26,115,232"
                                                    Click="OnInlineTextColorSwatchClick" />
                                                <Button
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    CornerRadius="11"
                                                    Background="#FF188038"
                                                    BorderThickness="1"
                                                    Tag="24,128,56"
                                                    Click="OnInlineTextColorSwatchClick" />
                                                <Button
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    CornerRadius="11"
                                                    Background="#FFE37400"
                                                    BorderThickness="1"
                                                    Tag="227,116,0"
                                                    Click="OnInlineTextColorSwatchClick" />
                                                <Button
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    CornerRadius="11"
                                                    Background="#FF8430CE"
                                                    BorderThickness="1"
                                                    Tag="132,48,206"
                                                    Click="OnInlineTextColorSwatchClick" />
                                                <Button
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    CornerRadius="11"
                                                    Background="#FFFFFFFF"
                                                    BorderThickness="1"
                                                    Tag="255,255,255"
                                                    Click="OnInlineTextColorSwatchClick" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <Border
                                    Width="1"
                                    Height="18"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Button
                                    x:Name="InlineTextDeleteButton"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    CornerRadius="4"
                                    IsTabStop="False"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Click="OnInlineTextDeleteClick">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>

                                <Button
                                    x:Name="InlineTextConfirmButton"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    CornerRadius="4"
                                    IsTabStop="False"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnInlineTextConfirmClick">
                                    <FontIcon FontSize="13" Glyph="&#xE73E;" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>

                <!-- Stage 3: Touch-Exclusive Assisted Vertical Scroll Scrubber ("Touch Scroll Pill / Scrubber") -->
                <Grid
                    x:Name="TouchScrollScrubberContainer"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,0,4,0"
                    Canvas.ZIndex="92"
                    IsHoldingEnabled="False"
                    IsRightTapEnabled="False"
                    RightTapped="OnTouchScrollScrubberRightTapped"
                    ContextRequested="OnTouchScrollScrubberContextRequested"
                    Opacity="0"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="TouchScrollScrubberTranslate" />
                    </Grid.RenderTransform>

                    <!-- Floating Page Indicator Bubble (visible only while dragging the scrubber thumb) -->
                    <Border
                        x:Name="TouchScrollPageBubble"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Padding="12,6"
                        CornerRadius="14"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="TouchScrollPageBubbleText"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            VerticalAlignment="Center" />
                    </Border>

                    <!-- Ergonomic 48x64 DIP Touch Hit Target -->
                    <Grid
                        x:Name="TouchScrollThumbHitTarget"
                        Grid.Column="1"
                        Width="48"
                        Height="64"
                        Background="Transparent"
                        ManipulationMode="None"
                        IsHoldingEnabled="False"
                        IsRightTapEnabled="False"
                        RightTapped="OnTouchScrollScrubberRightTapped"
                        ContextRequested="OnTouchScrollScrubberContextRequested"
                        PointerPressed="OnTouchScrollThumbPointerPressed"
                        PointerMoved="OnTouchScrollThumbPointerMoved"
                        PointerReleased="OnTouchScrollThumbPointerReleased"
                        PointerCanceled="OnTouchScrollThumbPointerCanceled"
                        PointerCaptureLost="OnTouchScrollThumbPointerCaptureLost">
                        <Border
                            x:Name="TouchScrollPill"
                            Width="26"
                            Height="48"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="13"
                            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5"
                            IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <CompositeTransform x:Name="TouchScrollPillScaleTransform" />
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <FontIcon
                                    Grid.Row="0"
                                    Glyph="&#xE70E;"
                                    FontSize="10"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <FontIcon
                                    Grid.Row="1"
                                    Glyph="&#xE70D;"
                                    FontSize="10"
                                    Margin="0,0,0,4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 80 DIPs navigation side strips 'Photos' style -->
                <Grid
                    x:Name="PrevPageZone"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Width="80"
                    Background="Transparent"
                    Translation="0,0,24"
                    PointerEntered="OnPrevZonePointerEntered"
                    PointerExited="OnPrevZonePointerExited"
                    Tapped="OnPrevZoneTapped"
                    Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.CurrentDocument.IsContinuous), Mode=OneWay}">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="PrevPageZoneTransform" />
                    </Grid.RenderTransform>
                    <Border
                        x:Name="PrevPageArrowPill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="36"
                        Height="64"
                        CornerRadius="6"
                        Opacity="0"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </Border.OpacityTransition>
                        <FontIcon Glyph="&#xE76B;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <Grid
                    x:Name="NextPageZone"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Width="80"
                    Background="Transparent"
                    Translation="0,0,24"
                    PointerEntered="OnNextZonePointerEntered"
                    PointerExited="OnNextZonePointerExited"
                    Tapped="OnNextZoneTapped"
                    Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.CurrentDocument.IsContinuous), Mode=OneWay}">
                    <Grid.RenderTransform>
                        <CompositeTransform x:Name="NextPageZoneTransform" />
                    </Grid.RenderTransform>
                    <Border
                        x:Name="NextPageArrowPill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="36"
                        Height="64"
                        CornerRadius="6"
                        Opacity="0"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </Border.OpacityTransition>
                        <FontIcon Glyph="&#xE76C;" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Full screen / presentation banner (WinUI Gallery pattern) -->
                <Border
                    x:Name="FullScreenInfoBarContainer"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,24,0,0"
                    Canvas.ZIndex="100"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BackgroundSizing="InnerBorderEdge"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Translation="0,0,32"
                    Visibility="Collapsed">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <InfoBar
                        x:Name="FullScreenInfoBar"
                        x:Uid="FullScreenInfoBar"
                        Severity="Informational"
                        IsOpen="False"
                        IsIconVisible="False"
                        IsClosable="True"
                        Title="Full screen"
                        Message="Press Esc to exit full screen"
                        Background="Transparent"
                        BorderThickness="0"
                        CloseButtonClick="OnFullScreenInfoBarCloseButtonClick">
                        <InfoBar.Resources>
                            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="InfoBarBackgroundFillColorDefaultBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="InfoBarBorderBrush" Color="Transparent" />
                            <Thickness x:Key="InfoBarBorderThickness">0</Thickness>
                        </InfoBar.Resources>
                    </InfoBar>
                </Border>

                <!-- 80 DIPs top clickable zone to exit presentation with subtle hover button -->
                <Grid
                    x:Name="ExitPresentationTopZone"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Height="80"
                    Background="Transparent"
                    Translation="0,0,33"
                    PointerEntered="OnExitPresentationZonePointerEntered"
                    PointerExited="OnExitPresentationZonePointerExited"
                    Tapped="OnExitPresentationZoneTapped"
                    Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsPresentationMode), Mode=OneWay}">
                    <Border
                        x:Name="ExitPresentationCloseBtnPill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Width="44"
                        Height="32"
                        CornerRadius="0,0,8,8"
                        Opacity="0"
                        Background="#80181818"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1,0,1,1">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </Border.OpacityTransition>
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Centered top container for floating search (Acrylic) and annotation toolbar -->
                <StackPanel
                    x:Name="FloatingTopContainer"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,12,0,0"
                    Spacing="8"
                    Canvas.ZIndex="95">
                    <StackPanel.RenderTransform>
                        <CompositeTransform x:Name="FloatingTopTransform" />
                    </StackPanel.RenderTransform>

                    <!-- Native Informational InfoBar for unimplemented annotation feature (closes only via X button) -->
                    <Border
                        x:Name="AnnotationNotImplementedContainer"
                        HorizontalAlignment="Center"
                        MaxWidth="600"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BackgroundSizing="InnerBorderEdge"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Translation="0,0,32"
                        Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.IsAnnotationNoticeOpen), Mode=OneWay}">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <InfoBar
                            x:Name="AnnotationNotImplementedInfoBar"
                            x:Uid="AnnotationNotImplementedInfoBar"
                            Severity="Informational"
                            IsOpen="{x:Bind ViewModel.IsAnnotationNoticeOpen, Mode=TwoWay}"
                            IsIconVisible="True"
                            IsClosable="True"
                            Title="Annotations"
                            Message="This feature has not been implemented yet."
                            Background="Transparent"
                            BorderThickness="0"
                            CloseButtonClick="OnAnnotationNoticeCloseButtonClick">
                            <InfoBar.Resources>
                                <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="InfoBarBackgroundFillColorDefaultBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="InfoBarBorderBrush" Color="Transparent" />
                                <Thickness x:Key="InfoBarBorderThickness">0</Thickness>
                            </InfoBar.Resources>
                        </InfoBar>
                    </Border>

                    <!-- Floating search bar in Acrylic (Windows 11 Notepad style) -->
                    <Border
                        x:Name="FloatingSearchBar"
                        HorizontalAlignment="Center"
                        Padding="8,4"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BackgroundSizing="InnerBorderEdge"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        RenderTransformOrigin="0.5,0.0"
                        Translation="0,0,32"
                        Visibility="Collapsed">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="FloatingSearchBarTransform" />
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center">
                                <TextBox
                                    x:Name="DocumentSearchBox"
                                    x:Uid="SearchBox"
                                    Width="230"
                                    Height="30"
                                    MinHeight="30"
                                    Padding="28,4,8,4"
                                    FontSize="13"
                                    VerticalAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    CornerRadius="4"
                                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextChanged="OnDocumentSearchBoxTextChanged"
                                    KeyDown="OnDocumentSearchBoxKeyDown">
                                    <TextBox.Resources>
                                        <x:Double x:Key="TextControlThemeMinHeight">30</x:Double>
                                    </TextBox.Resources>
                                </TextBox>
                                <FontIcon
                                    Glyph="&#xE721;"
                                    FontSize="12"
                                    Margin="8,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsHitTestVisible="False" />
                            </Grid>

                            <TextBlock
                                x:Name="SearchStatusTextBlock"
                                Margin="6,0,4,0"
                                MinWidth="44"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.SearchStatusText, Mode=OneWay}"
                                Visibility="{x:Bind converters:UiHelpers.VisibleIfNotNullOrEmpty(ViewModel.SearchStatusText), Mode=OneWay}" />

                            <Button
                                x:Name="SearchPrevButton"
                                x:Uid="SearchPrevButton"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="4"
                                IsTabStop="False"
                                Click="OnSearchPrevClick"
                                Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon FontSize="12" Glyph="&#xE70E;" />
                            </Button>

                            <Button
                                x:Name="SearchNextButton"
                                x:Uid="SearchNextButton"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="4"
                                IsTabStop="False"
                                Click="OnSearchNextClick"
                                Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon FontSize="12" Glyph="&#xE70D;" />
                            </Button>

                            <ToggleButton
                                x:Name="SearchMatchCaseToggle"
                                x:Uid="SearchMatchCaseToggle"
                                Width="32"
                                Height="30"
                                MinWidth="32"
                                MinHeight="30"
                                Padding="0"
                                CornerRadius="4"
                                IsTabStop="False"
                                BorderThickness="0"
                                IsChecked="{x:Bind ViewModel.IsSearchMatchCase, Mode=TwoWay}"
                                Click="OnSearchMatchCaseToggleClick">
                                <ToggleButton.Resources>
                                    <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                    <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                    <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                    <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                </ToggleButton.Resources>
                                <TextBlock
                                    Text="Aa"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </ToggleButton>

                            <Border
                                Width="1"
                                Height="18"
                                Margin="4,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Button
                                x:Name="SearchCloseButton"
                                x:Uid="SearchCloseButton"
                                Width="30"
                                Height="30"
                                Padding="0"
                                CornerRadius="4"
                                IsTabStop="False"
                                Click="OnSearchCloseClick"
                                Style="{StaticResource SubtleButtonStyle}">
                                <FontIcon FontSize="11" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Floating annotation toolbar (Centered top) -->
                    <Border
                        x:Name="FloatingAnnotationToolbar"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Padding="8,4,8,4"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BackgroundSizing="InnerBorderEdge"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        RenderTransformOrigin="0.5,0.0"
                        Translation="0,0,32"
                        Visibility="Collapsed">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Border.RenderTransform>
                            <CompositeTransform x:Name="FloatingAnnotationToolbarTransform" />
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                x:Name="ToolbarColorPickerButton"
                                Width="34"
                                Height="32"
                                Padding="0"
                                CornerRadius="4"
                                IsTabStop="False"
                                Style="{StaticResource SubtleButtonStyle}">
                                <Ellipse
                                    x:Name="ToolbarColorIndicatorDot"
                                    Width="16"
                                    Height="16"
                                    Fill="#FFFFE620"
                                    Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                    StrokeThickness="1.25" />
                                <Button.Flyout>
                                    <Flyout
                                        x:Name="ToolbarColorFlyout"
                                        Placement="Bottom"
                                        FlyoutPresenterStyle="{StaticResource AcrylicFlyoutPresenterStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="2">
                                            <Button
                                                x:Name="ToolbarColorYellowButton"
                                                Width="22"
                                                Height="22"
                                                Padding="0"
                                                CornerRadius="11"
                                                Background="#FFFFE620"
                                                BorderThickness="1"
                                                Tag="Yellow"
                                                Click="OnToolbarDefaultColorSelectClick" />
                                            <Button
                                                x:Name="ToolbarColorGreenButton"
                                                Width="22"
                                                Height="22"
                                                Padding="0"
                                                CornerRadius="11"
                                                Background="#FF64DC78"
                                                BorderThickness="1"
                                                Tag="Green"
                                                Click="OnToolbarDefaultColorSelectClick" />
                                            <Button
                                                x:Name="ToolbarColorBlueButton"
                                                Width="22"
                                                Height="22"
                                                Padding="0"
                                                CornerRadius="11"
                                                Background="#FF5AB4FF"
                                                BorderThickness="1"
                                                Tag="Blue"
                                                Click="OnToolbarDefaultColorSelectClick" />
                                            <Button
                                                x:Name="ToolbarColorPinkButton"
                                                Width="22"
                                                Height="22"
                                                Padding="0"
                                                CornerRadius="11"
                                                Background="#FFFF80B4"
                                                BorderThickness="1"
                                                Tag="Pink"
                                                Click="OnToolbarDefaultColorSelectClick" />
                                            <Button
                                                x:Name="ToolbarColorOrangeButton"
                                                Width="22"
                                                Height="22"
                                                Padding="0"
                                                CornerRadius="11"
                                                Background="#FFFFA53C"
                                                BorderThickness="1"
                                                Tag="Orange"
                                                Click="OnToolbarDefaultColorSelectClick" />
                                            <Button
                                                x:Name="ToolbarColorRedButton"
                                                Width="22"
                                                Height="22"
                                                Padding="0"
                                                CornerRadius="11"
                                                Background="#FFF24C4C"
                                                BorderThickness="1"
                                                Tag="Red"
                                                Click="OnToolbarDefaultColorSelectClick" />
                                            <Button
                                                x:Name="ToolbarColorBlackButton"
                                                Width="22"
                                                Height="22"
                                                Padding="0"
                                                CornerRadius="11"
                                                Background="#FF141414"
                                                BorderThickness="1"
                                                Tag="Black"
                                                Click="OnToolbarDefaultColorSelectClick" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button
                                x:Name="ToolbarStrokeThicknessButton"
                                x:Uid="ToolbarThicknessButton"
                                Width="34"
                                Height="32"
                                Padding="0"
                                CornerRadius="4"
                                IsTabStop="False"
                                Style="{StaticResource SubtleButtonStyle}">
                                <StackPanel Spacing="2.5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="14" Height="1" CornerRadius="0.5" Background="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Border Width="14" Height="2" CornerRadius="1" Background="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Border Width="14" Height="3.5" CornerRadius="1.5" Background="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout
                                        x:Name="ToolbarStrokeThicknessFlyout"
                                        Placement="Bottom"
                                        FlyoutPresenterStyle="{StaticResource AcrylicFlyoutPresenterStyle}">
                                        <StackPanel Width="216" Padding="4" Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock
                                                    x:Uid="ToolbarThicknessHeader"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    x:Name="ToolbarThicknessValueText"
                                                    Grid.Column="1"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                            <Border
                                                Height="36"
                                                Padding="14,0"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <Border
                                                    x:Name="ToolbarThicknessPreviewLine"
                                                    Height="3"
                                                    CornerRadius="1.5"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <Slider
                                                x:Name="ToolbarStrokeThicknessSlider"
                                                Minimum="1"
                                                Maximum="12"
                                                StepFrequency="0.5"
                                                SmallChange="0.5"
                                                LargeChange="2"
                                                IsThumbToolTipEnabled="False"
                                                Value="{x:Bind ViewModel.StrokeThicknessPt, Mode=TwoWay}"
                                                ValueChanged="OnToolbarStrokeThicknessChanged" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <AppBarSeparator Margin="4,4,4,4" />

                            <ToggleButton
                                x:Uid="ToolPenButton"
                                Click="OnToolPenClicked"
                                IsChecked="{x:Bind converters:UiHelpers.IsPenTool(ViewModel.ActiveTool), Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="&#xED63;" />
                            </ToggleButton>
                            <ToggleButton
                                x:Uid="ToolHighlighterButton"
                                SizeChanged="OnToolHighlighterButtonSizeChanged"
                                Click="OnToolHighlighterClicked"
                                IsChecked="{x:Bind converters:UiHelpers.IsHighlighterTool(ViewModel.ActiveTool), Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="&#xE891;" />
                            </ToggleButton>

                            <!-- Geometric Shapes Split Toggle (Last used shape + dropdown chevron for Line, Arrow, Rectangle, Ellipse) -->
                            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                <ToggleButton
                                    x:Name="ToolbarShapeButton"
                                    x:Uid="ToolbarShapeButton"
                                    Width="32"
                                    MinWidth="32"
                                    MinHeight="0"
                                    Padding="0"
                                    BorderThickness="1,1,0,1"
                                    CornerRadius="4,0,0,4"
                                    VerticalAlignment="Center"
                                    IsTabStop="False"
                                    Click="OnToolShapeClicked"
                                    IsChecked="{x:Bind converters:UiHelpers.IsShapeTool(ViewModel.ActiveTool), Mode=OneWay}">
                                    <Viewbox Width="14" Height="14">
                                        <Grid Width="16" Height="16">
                                            <PathIcon
                                                x:Name="ToolbarShapeLineIcon"
                                                Data="M 2.35,14.35 L 1.65,13.65 L 13.65,1.65 L 14.35,2.35 Z" />
                                            <PathIcon
                                                x:Name="ToolbarShapeArrowIcon"
                                                Visibility="Collapsed"
                                                Data="M 14.25,1.75 L 8.5,1.75 L 8.5,2.95 L 12.15,2.95 L 1.65,13.45 L 2.55,14.35 L 13.05,3.85 L 13.05,7.5 L 14.25,7.5 Z" />
                                            <PathIcon
                                                x:Name="ToolbarShapeRectangleIcon"
                                                Visibility="Collapsed"
                                                Data="M 2,3.5 C 2,2.67 2.67,2 3.5,2 L 12.5,2 C 13.33,2 14,2.67 14,3.5 L 14,12.5 C 14,13.33 13.33,14 12.5,14 L 3.5,14 C 2.67,14 2,13.33 2,12.5 Z M 3.2,3.5 L 3.2,12.5 C 3.2,12.67 3.33,12.8 3.5,12.8 L 12.5,12.8 C 12.67,12.8 12.8,12.67 12.8,12.5 L 12.8,3.5 C 12.8,3.33 12.67,3.2 12.5,3.2 L 3.5,3.2 C 3.33,3.2 3.2,3.33 3.2,3.5 Z" />
                                            <PathIcon
                                                x:Name="ToolbarShapeEllipseIcon"
                                                Visibility="Collapsed"
                                                Data="M 8,2.5 A 6.2,4.5 0 1 0 8,13.5 A 6.2,4.5 0 1 0 8,2.5 Z M 8,3.7 A 5.0,3.3 0 1 1 8,12.3 A 5.0,3.3 0 1 1 8,3.7 Z" />
                                        </Grid>
                                    </Viewbox>
                                </ToggleButton>
                                <Button
                                    x:Name="ToolbarShapePickerButton"
                                    x:Uid="ToolbarShapePickerButton"
                                    Width="18"
                                    MinWidth="18"
                                    MinHeight="0"
                                    Padding="0"
                                    BorderThickness="1"
                                    CornerRadius="0,4,4,0"
                                    VerticalAlignment="Center"
                                    IsTabStop="False">
                                    <FontIcon FontSize="9" Glyph="&#xE70D;" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem
                                                x:Name="ShapeLineMenuItem"
                                                x:Uid="ShapeLineMenuItem"
                                                Tag="Line"
                                                Click="OnShapeKindMenuItemClick">
                                                <MenuFlyoutItem.Icon>
                                                    <PathIcon Data="M 2.35,14.35 L 1.65,13.65 L 13.65,1.65 L 14.35,2.35 Z" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                x:Name="ShapeArrowMenuItem"
                                                x:Uid="ShapeArrowMenuItem"
                                                Tag="Arrow"
                                                Click="OnShapeKindMenuItemClick">
                                                <MenuFlyoutItem.Icon>
                                                    <PathIcon Data="M 14.25,1.75 L 8.5,1.75 L 8.5,2.95 L 12.15,2.95 L 1.65,13.45 L 2.55,14.35 L 13.05,3.85 L 13.05,7.5 L 14.25,7.5 Z" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                x:Name="ShapeRectangleMenuItem"
                                                x:Uid="ShapeRectangleMenuItem"
                                                Tag="Rectangle"
                                                Click="OnShapeKindMenuItemClick">
                                                <MenuFlyoutItem.Icon>
                                                    <PathIcon Data="M 2,3.5 C 2,2.67 2.67,2 3.5,2 L 12.5,2 C 13.33,2 14,2.67 14,3.5 L 14,12.5 C 14,13.33 13.33,14 12.5,14 L 3.5,14 C 2.67,14 2,13.33 2,12.5 Z M 3.2,3.5 L 3.2,12.5 C 3.2,12.67 3.33,12.8 3.5,12.8 L 12.5,12.8 C 12.67,12.8 12.8,12.67 12.8,12.5 L 12.8,3.5 C 12.8,3.33 12.67,3.2 12.5,3.2 L 3.5,3.2 C 3.33,3.2 3.2,3.33 3.2,3.5 Z" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                x:Name="ShapeEllipseMenuItem"
                                                x:Uid="ShapeEllipseMenuItem"
                                                Tag="Ellipse"
                                                Click="OnShapeKindMenuItemClick">
                                                <MenuFlyoutItem.Icon>
                                                    <PathIcon Data="M 8,2.5 A 6.2,4.5 0 1 0 8,13.5 A 6.2,4.5 0 1 0 8,2.5 Z M 8,3.7 A 5.0,3.3 0 1 1 8,12.3 A 5.0,3.3 0 1 1 8,3.7 Z" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <!-- Eraser Split Toggle (Stroke vs Point eraser + dropdown chevron) -->
                            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                                <ToggleButton
                                    x:Name="ToolbarEraserButton"
                                    x:Uid="ToolbarEraserButton"
                                    Width="32"
                                    MinWidth="32"
                                    MinHeight="0"
                                    Padding="0"
                                    BorderThickness="1,1,0,1"
                                    CornerRadius="4,0,0,4"
                                    VerticalAlignment="Center"
                                    IsTabStop="False"
                                    Click="OnToolEraserClicked"
                                    IsChecked="{x:Bind converters:UiHelpers.IsEraserTool(ViewModel.ActiveTool), Mode=OneWay}">
                                    <Grid Width="16" Height="16">
                                        <FontIcon
                                            x:Name="ToolbarEraserStrokeIcon"
                                            FontSize="14"
                                            Glyph="&#xE75C;" />
                                        <Viewbox
                                            x:Name="ToolbarEraserPointIcon"
                                            Width="14"
                                            Height="14"
                                            Visibility="Collapsed">
                                            <PathIcon
                                                Width="16"
                                                Height="16"
                                                Data="M 10.6,1.6 L 14.4,5.4 C 14.9,5.9 14.9,6.7 14.4,7.2 L 7.6,14.0 L 3.4,14.0 L 1.6,12.2 C 1.1,11.7 1.1,10.9 1.6,10.4 L 8.8,1.6 C 9.3,1.1 10.1,1.1 10.6,1.6 Z M 4.0,12.8 L 7.1,12.8 L 9.5,10.4 L 5.6,6.5 L 2.5,11.3 Z M 10.2,13.0 L 14.5,13.0 L 14.5,14.2 L 10.2,14.2 Z" />
                                        </Viewbox>
                                    </Grid>
                                </ToggleButton>
                                <Button
                                    x:Name="ToolbarEraserPickerButton"
                                    x:Uid="ToolbarEraserPickerButton"
                                    Width="18"
                                    MinWidth="18"
                                    MinHeight="0"
                                    Padding="0"
                                    BorderThickness="1"
                                    CornerRadius="0,4,4,0"
                                    VerticalAlignment="Center"
                                    IsTabStop="False">
                                    <FontIcon FontSize="9" Glyph="&#xE70D;" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem
                                                x:Name="EraserModeStrokeMenuItem"
                                                x:Uid="EraserModeStrokeMenuItem"
                                                Tag="Stroke"
                                                Click="OnEraserModeMenuItemClick">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE75C;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                x:Name="EraserModePointMenuItem"
                                                x:Uid="EraserModePointMenuItem"
                                                Tag="Point"
                                                Click="OnEraserModeMenuItemClick">
                                                <MenuFlyoutItem.Icon>
                                                    <PathIcon Data="M 10.6,1.6 L 14.4,5.4 C 14.9,5.9 14.9,6.7 14.4,7.2 L 7.6,14.0 L 3.4,14.0 L 1.6,12.2 C 1.1,11.7 1.1,10.9 1.6,10.4 L 8.8,1.6 C 9.3,1.1 10.1,1.1 10.6,1.6 Z M 4.0,12.8 L 7.1,12.8 L 9.5,10.4 L 5.6,6.5 L 2.5,11.3 Z M 10.2,13.0 L 14.5,13.0 L 14.5,14.2 L 10.2,14.2 Z" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>

                            <AppBarSeparator
                                Margin="4,4,4,4"
                                Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.HasPenDigitizer), Mode=OneWay}" />

                            <ToggleButton
                                x:Uid="TouchDrawingToggle"
                                IsTabStop="False"
                                IsChecked="{x:Bind ViewModel.IsTouchDrawingEnabled, Mode=TwoWay}"
                                Visibility="{x:Bind converters:UiHelpers.VisibleIf(ViewModel.HasPenDigitizer), Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="&#xED5F;" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Minimalist native middle-click autoscroll anchor indicator (Windows browser style) -->
                <Canvas
                    x:Name="AutoScrollOverlayCanvas"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"
                    Canvas.ZIndex="98">
                    <Border
                        x:Name="AutoScrollAnchorBadge"
                        Width="28"
                        Height="28"
                        CornerRadius="14"
                        Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Translation="0,0,16">
                        <Border.Shadow>
                            <ThemeShadow />
                        </Border.Shadow>
                        <Grid Width="26" Height="26">
                            <!-- Up chevron -->
                            <Polygon
                                Points="13,3 9.5,7 16.5,7"
                                Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <!-- Down chevron -->
                            <Polygon
                                Points="13,23 9.5,19 16.5,19"
                                Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <!-- Left chevron -->
                            <Polygon
                                Points="3,13 7,9.5 7,16.5"
                                Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <!-- Right chevron -->
                            <Polygon
                                Points="23,13 19,9.5 19,16.5"
                                Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <!-- Center dot -->
                            <Ellipse
                                Width="4"
                                Height="4"
                                Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Canvas>
            </Grid>



            <!-- Row 1: Native 32 DIPs bottom status bar (Paint / Photos / Notepad style) -->
            <Grid
                x:Name="StatusBarBorder"
                Grid.Row="1"
                Height="32"
                Background="Transparent"
                Visibility="{x:Bind converters:UiHelpers.CollapsedIf(ViewModel.IsPresentationMode), Mode=OneWay}">
                <Border
                    x:Name="StatusBarBackdropBorder"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Border.RenderTransform>
                        <CompositeTransform x:Name="StatusBarBackdropTransform" />
                    </Border.RenderTransform>
                </Border>
                <Grid Padding="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left-aligned elements -->
                    <StackPanel
                        x:Name="StatusBarLeftPanel"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <StackPanel.RenderTransform>
                            <CompositeTransform x:Name="StatusBarLeftTransform" />
                        </StackPanel.RenderTransform>

                        <!-- 1. "Inline Pill" page selector (Page [ X ] of Y) -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind PageBoxToolTipText, Mode=OneTime}">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"
                                Text="{x:Bind PagePrefixText, Mode=OneTime}" />
                            <TextBox
                                x:Name="StatusBarPageBox"
                                Height="24"
                                MinHeight="24"
                                MinWidth="36"
                                MaxWidth="56"
                                Padding="4,4,4,0"
                                FontSize="12"
                                TextAlignment="Center"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                CornerRadius="4"
                                BorderThickness="1"
                                Background="Transparent"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                InputScope="Number"
                                GotFocus="OnStatusBarPageBoxGotFocus"
                                KeyDown="OnStatusBarPageBoxKeyDown"
                                LostFocus="OnStatusBarPageBoxLostFocus"
                                Text="{x:Bind ViewModel.CurrentDocument.CurrentPageNumber, Mode=OneWay}">
                                <TextBox.Resources>
                                    <x:Double x:Key="TextControlThemeMinHeight">24</x:Double>
                                    <x:Double x:Key="TextControlThemeMinWidth">36</x:Double>
                                    <Thickness x:Key="TextControlThemePadding">4,4,4,0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.FormattedPageCount, Mode=OneWay}" />
                        </StackPanel>

                        <Grid
                            x:Name="StatusBarMetadataClipContainer"
                            VerticalAlignment="Center">
                            <Grid.Clip>
                                <RectangleGeometry x:Name="StatusBarMetadataClip" Rect="0,0,700,32" />
                            </Grid.Clip>
                            <StackPanel
                                x:Name="StatusBarMetadataInnerPanel"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <StackPanel.RenderTransform>
                                    <CompositeTransform x:Name="StatusBarMetadataTransform" />
                                </StackPanel.RenderTransform>

                                <!-- 2. Separator | -->
                                <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                                <!-- 3. Format badge -->
                                <TextBlock
                                    Text="{x:Bind ViewModel.CurrentDocument.FileFormatBadge, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="{x:Bind FormatToolTipText, Mode=OneTime}" />

                                <!-- 4. Separator | -->
                                <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                                <!-- 5. Unified clickable info, size, and signature status Button -->
                                <Button
                                    x:Name="StatusBarPropertiesButton"
                                    Padding="8,0"
                                    Height="24"
                                    MinHeight="24"
                                    MinWidth="0"
                                    CornerRadius="4"
                                    BorderThickness="0"
                                    IsTabStop="False"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Command="{x:Bind ViewModel.ShowPropertiesCommand}"
                                    ToolTipService.ToolTip="{x:Bind PropertiesToolTipText, Mode=OneTime}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE946;" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.CurrentDocument.FormattedFileSize, Mode=OneWay}"
                                            FontSize="12"
                                            VerticalAlignment="Center" />
                                        <StackPanel
                                            x:Name="StatusBarSignaturePanel"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                            <Border
                                                Width="1"
                                                Height="12"
                                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                x:Name="StatusBarSignedLabelText"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                VerticalAlignment="Center" />
                                            <FontIcon
                                                x:Name="StatusBarSignatureIcon"
                                                FontSize="12"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Right-aligned elements -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">

                        <!-- 1. Double page toggle (Two pages on/off) -->
                        <ToggleButton
                            Width="28"
                            Height="24"
                            Padding="0"
                            MinWidth="28"
                            MinHeight="24"
                            CornerRadius="4"
                            IsChecked="{x:Bind ViewModel.CurrentDocument.IsDoublePage, Mode=TwoWay}"
                            BorderThickness="0"
                            ToolTipService.ToolTip="{x:Bind DoublePageToolTipText, Mode=OneTime}">
                            <ToggleButton.Resources>
                                <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                            </ToggleButton.Resources>
                            <FontIcon
                                Glyph="&#xE89A;"
                                FontSize="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <CompositeTransform TranslateY="0.5" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </ToggleButton>

                        <!-- 2. Separator | -->
                        <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <!-- 3. Continuous scroll toggle (Continuous on/off) -->
                        <ToggleButton
                            Width="28"
                            Height="24"
                            Padding="0"
                            MinWidth="28"
                            MinHeight="24"
                            CornerRadius="4"
                            IsChecked="{x:Bind ViewModel.CurrentDocument.IsContinuous, Mode=TwoWay}"
                            BorderThickness="0"
                            ToolTipService.ToolTip="{x:Bind ContinuousToolTipText, Mode=OneTime}">
                            <ToggleButton.Resources>
                                <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                <StaticResource x:Key="ToggleButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                            </ToggleButton.Resources>
                            <FontIcon
                                Glyph="&#xEC8F;"
                                FontSize="11"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <CompositeTransform ScaleX="0.92" ScaleY="0.92" TranslateY="0.5" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </ToggleButton>

                        <!-- 4. Separator | -->
                        <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                        <!-- 5. Fit and Zoom block -->
                        <!-- Fit Vertical button (Fit to page) -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="28"
                            Height="24"
                            Padding="0"
                            MinWidth="28"
                            MinHeight="24"
                            CornerRadius="4"
                            Click="OnFitPageClick"
                            ToolTipService.ToolTip="{x:Bind FitVerticalToolTipText, Mode=OneTime}">
                            <FontIcon
                                Glyph="&#xE9A6;"
                                FontSize="13"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Button>

                        <!-- Fit Horizontal button (Fit to width) -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="28"
                            Height="24"
                            Padding="0"
                            MinWidth="28"
                            MinHeight="24"
                            CornerRadius="4"
                            Click="OnFitWidthClick"
                            ToolTipService.ToolTip="{x:Bind FitHorizontalToolTipText, Mode=OneTime}">
                            <FontIcon
                                Glyph="&#xF58A;"
                                FontSize="13"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                                <FontIcon.RenderTransform>
                                    <CompositeTransform ScaleX="1.04" ScaleY="1.04" TranslateY="0.5" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Button>

                        <!-- Zoom preset dropdown (100% ▾) -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Height="24"
                            Padding="8,0"
                            MinWidth="60"
                            CornerRadius="4"
                            ToolTipService.ToolTip="{x:Bind ZoomPresetToolTipText, Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind ViewModel.FormattedZoomPercent, Mode=OneWay}"
                                    FontSize="12"
                                    VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;" FontSize="9" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuFlyoutItem Text="50%" Click="OnZoomPresetClick" Tag="0.5" />
                                    <MenuFlyoutItem Text="75%" Click="OnZoomPresetClick" Tag="0.75" />
                                    <MenuFlyoutItem Text="100%" Click="OnZoomPresetClick" Tag="1.0" />
                                    <MenuFlyoutItem Text="125%" Click="OnZoomPresetClick" Tag="1.25" />
                                    <MenuFlyoutItem Text="150%" Click="OnZoomPresetClick" Tag="1.5" />
                                    <MenuFlyoutItem Text="200%" Click="OnZoomPresetClick" Tag="2.0" />
                                    <MenuFlyoutItem Text="300%" Click="OnZoomPresetClick" Tag="3.0" />
                                    <MenuFlyoutItem Text="400%" Click="OnZoomPresetClick" Tag="4.0" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- Zoom - button -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="0"
                            MinWidth="26"
                            MinHeight="24"
                            CornerRadius="4"
                            Click="OnZoomOutClick"
                            ToolTipService.ToolTip="{x:Bind ZoomOutToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE738;" FontSize="13" />
                        </Button>

                        <!-- Horizontal zoom bar (Slider) -->
                        <Slider
                            x:Name="StatusBarZoomSlider"
                            Width="88"
                            Minimum="25"
                            Maximum="500"
                            StepFrequency="5"
                            VerticalAlignment="Center"
                            IsTabStop="False"
                            IsThumbToolTipEnabled="False"
                            ValueChanged="OnStatusBarZoomSliderValueChanged"
                            ToolTipService.ToolTip="{x:Bind ZoomSliderToolTipText, Mode=OneTime}" />

                        <!-- Zoom + button -->
                        <Button
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="26"
                            Height="24"
                            Padding="0"
                            MinWidth="26"
                            MinHeight="24"
                            CornerRadius="4"
                            Click="OnZoomInClick"
                            ToolTipService.ToolTip="{x:Bind ZoomInToolTipText, Mode=OneTime}">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                        </Button>

                        <Grid
                            x:Name="StatusBarPresentationClipContainer"
                            VerticalAlignment="Center">
                            <Grid.Clip>
                                <RectangleGeometry x:Name="StatusBarPresentationClip" Rect="0,0,200,32" />
                            </Grid.Clip>
                            <StackPanel
                                x:Name="StatusBarPresentationInnerPanel"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                                <StackPanel.RenderTransform>
                                    <CompositeTransform x:Name="StatusBarPresentationTransform" />
                                </StackPanel.RenderTransform>

                                <!-- 6. Separator | -->
                                <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,0" VerticalAlignment="Center" />

                                <!-- 7. Presentation and Full Screen block -->
                                <!-- Slideshow button (F5) -->
                                <Button
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Width="26"
                                    Height="24"
                                    Padding="0"
                                    MinWidth="26"
                                    MinHeight="24"
                                    CornerRadius="4"
                                    Command="{x:Bind ViewModel.StartPresentationCommand}"
                                    ToolTipService.ToolTip="{x:Bind SlideshowToolTipText, Mode=OneTime}">
                                    <FontIcon Glyph="&#xE786;" FontSize="13" />
                                </Button>

                                <!-- Full Screen button (F11) -->
                                <Button
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Width="26"
                                    Height="24"
                                    Padding="0"
                                    MinWidth="26"
                                    MinHeight="24"
                                    CornerRadius="4"
                                    Command="{x:Bind ViewModel.ToggleFullScreenCommand}"
                                    ToolTipService.ToolTip="{x:Bind FullScreenToolTipText, Mode=OneTime}">
                                    <FontIcon Glyph="&#xE740;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
