<Project>
  <!--
    Repository-wide build settings applied to every project under this folder.
    Keep project-specific settings inside each .csproj.
  -->
  <PropertyGroup>
    <!-- Single source of truth for the application version across Visual Studio, Settings UI, Package-Release.ps1, and Inno Setup -->
    <Version>0.5.4-alpha.5-s3v1</Version>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <!-- XML documentation is mandatory for all public/protected members (see AGENTS.md). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Company>WinPDF Contributors</Company>
    <Product>WinPDF</Product>
    <Copyright>Copyright © WinPDF Contributors</Copyright>
  </PropertyGroup>
</Project>
